+﻿using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using Else.Service.Updater.Logic.Caddy;
+
+namespace Else.Service.Updater.Controls
+{
+    /// <summary>
+    /// Pole listy adresów trasy Caddy'ego (typ <see cref="TypyUstawien.CertHosts"/>, §5.5): adresy
+    /// rozdzielone średnikiem, obok lista podpowiedzi Updatera (nazwa komputera, adresy lokalne,
+    /// host z SERVICEURL), a pod spodem NIEKLIKALNY podgląd "który adres dostanie który tryb
+    /// certyfikatu". Podgląd jest tu najważniejszy: wybór certyfikatu dotyczy wszystkich adresów
+    /// naraz, ale adres, którego wybrany certyfikat nie obejmuje, schodzi na certyfikat
+    /// wewnętrzny - bez podglądu człowiek dowiaduje się o tym dopiero z ostrzeżenia przeglądarki
+    /// u klienta. Sam wybór certyfikatu zostaje w polu typu SSL; tutaj wchodzi tylko jego skutek.
+    /// </summary>
+    public class MyEditorCertHosts : Grid, IMyEditorControl
+    {
+        /// <summary>Pierwsza pozycja listy podpowiedzi - nazywa, do czego ona służy, i jest stanem "nic nie wybrano".</summary>
+        private const String EtykietaPodpowiedzi = "+ dopisz adres";
+
+        private const String BrakAdresow =
+            "Dopisz adres, pod ktorym Caddy ma odpowiadac - podglad pokaze, jaki certyfikat dostanie kazdy z nich.";
+
+        private readonly TextBox lista;
+
+        private readonly ComboBox listaPodpowiedzi;
+
+        private readonly TextBlock podglad;
+
+        /// <summary>
+        /// Pokrycie certyfikatu czytane z magazynu Windows - to samo źródło, z którego korzysta
+        /// wydruk Caddyfile'a, więc podgląd nie może powiedzieć czegoś innego niż konfiguracja.
+        /// Magazyn odpytuje się wyłącznie przy wyborze odcisku: dla pustej wartości i sentineli
+        /// tryb rozstrzyga się bez niego. Odpowiedzi zapamiętane, bo podgląd przelicza się przy
+        /// każdym znaku wpisanym do listy adresów, a otwieranie magazynu na wątku UI po każdym
+        /// znaku gubi znaki.
+        /// </summary>
+        private readonly IPokrycieCertyfikatu pokrycie = new PokrycieZapamietane();
+
+        /// <summary>
+        /// Czy trwa przebudowa listy podpowiedzi. Podmiana pozycji zgłasza SelectionChanged,
+        /// a ta obsługa dopisuje adres do listy - bez blokady samo przyniesienie podpowiedzi
+        /// bindowaniem dopisywałoby pierwszą z nich do konfiguracji.
+        /// </summary>
+        private Boolean trwaPrzebudowaPodpowiedzi;
+
+        private IEnumerable<String> podpowiadaneAdresy;
+
+        private String wybranyCertyfikat;
+
+        public MyEditorCertHosts()
+        {
+            this.lista = new TextBox { VerticalContentAlignment = VerticalAlignment.Center };
+            this.listaPodpowiedzi = new ComboBox
+            {
+                Margin = new Thickness(4, 0, 0, 0),
+                VerticalContentAlignment = VerticalAlignment.Center
+            };
+            this.podglad = new TextBlock
+            {
+                // Czcionka o stalej szerokosci: podglad jest tabela "adres -> tryb", a kolumna
+                // rozjezdzajaca sie przy kazdym adresie przestaje byc czytelna.
+                FontFamily = new FontFamily("Consolas"),
+                Foreground = new SolidColorBrush(Colors.DimGray),
+                TextWrapping = TextWrapping.Wrap,
+                Margin = new Thickness(0, 4, 0, 0),
+                // "Podglad, ktorego nie da sie kliknac" (§5.5) - pokazuje skutek, nie konfiguruje go.
+                IsHitTestVisible = false,
+                Focusable = false
+            };
+
+            var wiersz = new DockPanel();
+            DockPanel.SetDock(this.listaPodpowiedzi, Dock.Right);
+            wiersz.Children.Add(this.listaPodpowiedzi);
+            wiersz.Children.Add(this.lista);
+
+            this.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
+            this.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
+            SetRow(wiersz, 0);
+            SetRow(this.podglad, 1);
+            this.Children.Add(wiersz);
+            this.Children.Add(this.podglad);
+
+            this.lista.TextChanged += Lista_TextChanged;
+            this.listaPodpowiedzi.SelectionChanged += Podpowiedzi_SelectionChanged;
+
+            PrzebudujPodpowiedzi();
+            OdswiezPodglad();
+        }
+
+        public event EventHandler<object> ValueChanged;
+
+        public Object Value
+        {
+            get { return this.lista.Text; }
+            set { this.lista.Text = UniConvert.ToString(value) ?? ""; }
+        }
+
+        public Boolean IsReadOnly
+        {
+            get { return this.lista.IsReadOnly; }
+            set
+            {
+                this.lista.IsReadOnly = value;
+                this.lista.Background = new SolidColorBrush(value ? Colors.LightGray : Colors.White);
+                this.listaPodpowiedzi.IsEnabled = !value;
+            }
+        }
+
+        public Thickness EditorPadding
+        {
+            get { return this.lista.Padding; }
+            set { this.lista.Padding = value; }
+        }
+
+        public Double EditorFontSize
+        {
+            get { return this.lista.FontSize; }
+            set
+            {
+                this.lista.FontSize = value;
+                this.listaPodpowiedzi.FontSize = value;
+                this.podglad.FontSize = Math.Max(10, value - 2);
+            }
+        }
+
+        /// <summary>
+        /// Adresy podpowiadane przez Updatera (<see cref="PodpowiedziAdresow"/>). Przychodzą
+        /// bindowaniem, więc mogą przyjść PO zbudowaniu pola - stąd przebudowa listy przy każdej
+        /// zmianie, tak samo jak przy przełączniku hosta.
+        /// </summary>
+        public IEnumerable<String> PodpowiadaneAdresy
+        {
+            get { return this.podpowiadaneAdresy; }
+            set
+            {
+                this.podpowiadaneAdresy = value;
+                PrzebudujPodpowiedzi();
+            }
+        }
+
+        /// <summary>
+        /// Certyfikat wybrany w polu typu SSL tej samej konfiguracji - to on rozstrzyga, co
+        /// pokazuje podgląd. Wartość wspólna dla ekranu, więc przełączenie certyfikatu
+        /// przerysowuje podgląd od razu, bez zapisywania konfiguracji.
+        /// </summary>
+        public String WybranyCertyfikat
+        {
+            get { return this.wybranyCertyfikat; }
+            set
+            {
+                this.wybranyCertyfikat = value;
+                OdswiezPodglad();
+            }
+        }
+
+        private void Lista_TextChanged(object sender, TextChangedEventArgs e)
+        {
+            OdswiezPodglad();
+
+            if (this.ValueChanged != null)
+                this.ValueChanged.Invoke(this, this.Value);
+        }
+
+        /// <summary>
+        /// Wybrana podpowiedź dopisuje się do listy - lista zostaje polem tekstowym, bo adresu
+        /// takiego jak "portal.firma.pl" Updater i tak nie zna (§5.5). Zaznaczenie wraca na
+        /// etykietę, żeby tę samą podpowiedź dało się wybrać jeszcze raz po ręcznej poprawce.
+        /// </summary>
+        private void Podpowiedzi_SelectionChanged(object sender, SelectionChangedEventArgs e)
+        {
+            if (this.trwaPrzebudowaPodpowiedzi)
+                return;
+
+            var adres = this.listaPodpowiedzi.SelectedItem as String;
+            WybierzEtykiete();
+
+            if (adres == null || adres == EtykietaPodpowiedzi)
+                return;
+
+            Dopisz(adres);
+        }
+
+        /// <summary>Adres juz wpisany nie dopisuje sie drugi raz - dwa te same adresy to dwa bloki site'a o tym samym hoscie, czego Caddy nie przyjmie.</summary>
+        private void Dopisz(String Adres)
+        {
+            var adresy = TypyUstawien.AdresyZListy(this.lista.Text);
+
+            if (adresy.Any(adres => adres.Equals(Adres, StringComparison.OrdinalIgnoreCase)))
+                return;
+
+            adresy.Add(Adres);
+            this.lista.Text = String.Join(";", adresy.ToArray());
+        }
+
+        private void PrzebudujPodpowiedzi()
+        {
+            var pozycje = new List<String> { EtykietaPodpowiedzi };
+            pozycje.AddRange((this.podpowiadaneAdresy ?? Enumerable.Empty<String>())
+                .Select(adres => (adres ?? "").Trim())
+                .Where(adres => adres.Length > 0));
+
+            this.trwaPrzebudowaPodpowiedzi = true;
+            try
+            {
+                this.listaPodpowiedzi.ItemsSource = pozycje;
+                this.listaPodpowiedzi.SelectedIndex = 0;
+            }
+            finally
+            {
+                this.trwaPrzebudowaPodpowiedzi = false;
+            }
+
+            // Sama etykieta bez adresow to lista, z ktorej nie ma czego wybrac.
+            this.listaPodpowiedzi.Visibility = pozycje.Count > 1 ? Visibility.Visible : Visibility.Collapsed;
+        }
+
+        private void WybierzEtykiete()
+        {
+            this.trwaPrzebudowaPodpowiedzi = true;
+            try
+            {
+                this.listaPodpowiedzi.SelectedIndex = 0;
+            }
+            finally
+            {
+                this.trwaPrzebudowaPodpowiedzi = false;
+            }
+        }
+
+        private void OdswiezPodglad()
+        {
+            var tekst = PodgladTrybowCertyfikatu.Tekst(this.lista.Text, this.WybranyCertyfikat, this.pokrycie);
+
+            this.podglad.Text = tekst.Length > 0 ? tekst : BrakAdresow;
+        }
+    }
+}
