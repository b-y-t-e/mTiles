+﻿using System;
+using System.Collections.Generic;
+using System.ComponentModel;
+using System.Linq;
+using System.Windows;
+using System.Windows.Controls;
+using Else.Service.Updater.Logic.Caddy;
+
+namespace Else.Service.Updater.Controls
+{
+    /// <summary>
+    /// Edytor pojedynczego ustawienia: pokazuje kontrolkę pasującą do TYPU ustawienia i pilnuje,
+    /// żeby jej wartość i wartość ustawienia były tym samym. Typ rozpoznaje wyłącznie rejestr
+    /// pól (<see cref="PoleEdytora"/>) - dopisanie nowego typu to jeden wpis, a nie osobna
+    /// gałąź w każdej z metod obsługi.
+    /// </summary>
+    public class MyEditor : Grid, INotifyPropertyChanged
+    {
+        public const string ValuePropertyName = "Value";
+
+        public String Value
+        {
+            get { return (String) GetValue(ValueProperty); }
+            set { SetValue(ValueProperty, value); }
+        }
+
+        public static readonly DependencyProperty ValueProperty = DependencyProperty.Register(
+            ValuePropertyName,
+            typeof(String),
+            typeof(MyEditor),
+            new PropertyMetadata(ValuePropertyChangedCallback));
+
+        private static void ValuePropertyChangedCallback(DependencyObject d, DependencyPropertyChangedEventArgs e)
+        {
+            ((MyEditor) d).OnValueChanged();
+        }
+
+        ////////////////////////
+
+        public const string ValueTypePropertyName = "ValueType";
+
+        public String ValueType
+        {
+            get { return (String) GetValue(ValueTypeProperty); }
+            set { SetValue(ValueTypeProperty, value); }
+        }
+
+        public static readonly DependencyProperty ValueTypeProperty = DependencyProperty.Register(
+            ValueTypePropertyName,
+            typeof(String),
+            typeof(MyEditor),
+            new PropertyMetadata(ValueTypePropertyChangedCallback));
+
+        private static void ValueTypePropertyChangedCallback(DependencyObject d, DependencyPropertyChangedEventArgs e)
+        {
+            ((MyEditor) d).OnValueTypeChanged();
+        }
+
+        ////////////////////////
+
+        public const string CzyCaddyDostepnyPropertyName = "CzyCaddyDostepny";
+
+        /// <summary>
+        /// Czy pozycja "Caddy" ma być w ogóle dostępna na liście przełącznika hosta (§5.6):
+        /// niedostępna, nie tylko odradzana. Domyślnie false - dostępność liczy ViewModel,
+        /// który zna usługę (ftp? werdykt kwalifikatora Fazy 0?), a Caddy nigdy nie włącza
+        /// się sam. Przesterowanie flagi przebudowuje listę, ale zapisanego CADDY nie rusza:
+        /// gdy Caddy przestał być dostępny, wartość dostaje własną pozycję oznaczoną jako
+        /// niedostępna (patrz <see cref="MyEditorHost"/>) - wycofanie z §5.6 ma być świadomym
+        /// wyborem człowieka, nie skutkiem błędu odczytu w kwalifikacji.
+        /// </summary>
+        public Boolean CzyCaddyDostepny
+        {
+            get { return (Boolean) GetValue(CzyCaddyDostepnyProperty); }
+            set { SetValue(CzyCaddyDostepnyProperty, value); }
+        }
+
+        public static readonly DependencyProperty CzyCaddyDostepnyProperty = DependencyProperty.Register(
+            CzyCaddyDostepnyPropertyName,
+            typeof(Boolean),
+            typeof(MyEditor),
+            new PropertyMetadata(false, StanEkranuPropertyChangedCallback));
+
+        ////////////////////////
+
+        public const string WybranyHostPropertyName = "WybranyHost";
+
+        /// <summary>
+        /// Wybrany host TEJ konfiguracji (wartość ustawienia SERVICEHOST/WEBSITEHOST) - wspólny
+        /// dla wszystkich pól ekranu, bo pole certyfikatu musi wiedzieć, co wybrano w innym polu.
+        /// Sentinele "#caddy-*" pojawiają się bowiem tylko wtedy, gdy hostem JEST Caddy (§5.5),
+        /// a nie wtedy, gdy Caddy jest dostępny: wartość certyfikatu konsumuje też dotychczasowa
+        /// PodmianaCertyfikatow (netsh na żywym porcie) albo sama usługa przy starcie (Kestrel
+        /// rodzin A i B), a dla nich sentinel nie jest odciskiem.
+        /// Bindowanie dwukierunkowe: pole hosta wpisuje tu swój wybór, pola certyfikatu go
+        /// czytają - dzięki temu lista przebudowuje się od razu po przełączeniu hosta, bez
+        /// zapisywania i ponownego otwierania konfiguracji.
+        /// </summary>
+        public String WybranyHost
+        {
+            get { return (String) GetValue(WybranyHostProperty); }
+            set { SetValue(WybranyHostProperty, value); }
+        }
+
+        public static readonly DependencyProperty WybranyHostProperty = DependencyProperty.Register(
+            WybranyHostPropertyName,
+            typeof(String),
+            typeof(MyEditor),
+            new FrameworkPropertyMetadata(
+                "",
+                FrameworkPropertyMetadataOptions.BindsTwoWayByDefault,
+                StanEkranuPropertyChangedCallback));
+
+        ////////////////////////
+
+        public const string WybranyCertyfikatPropertyName = "WybranyCertyfikat";
+
+        /// <summary>
+        /// Wybrany certyfikat TEJ konfiguracji (wartość ustawienia typu SSL albo
+        /// CERTYFIKAT_HTTPS - <see cref="TypyUstawien.CzyTypCertyfikatu"/>) - wspólny dla
+        /// wszystkich pól ekranu, bo podgląd trybów przy liście adresów musi wiedzieć, co
+        /// wybrano w innym polu (§5.5). Bindowanie dwukierunkowe: pole certyfikatu wpisuje tu
+        /// swój wybór, pole adresów go czyta, więc podgląd przerysowuje się od razu po
+        /// przełączeniu certyfikatu, bez zapisywania i ponownego otwierania konfiguracji.
+        /// </summary>
+        public String WybranyCertyfikat
+        {
+            get { return (String) GetValue(WybranyCertyfikatProperty); }
+            set { SetValue(WybranyCertyfikatProperty, value); }
+        }
+
+        public static readonly DependencyProperty WybranyCertyfikatProperty = DependencyProperty.Register(
+            WybranyCertyfikatPropertyName,
+            typeof(String),
+            typeof(MyEditor),
+            new FrameworkPropertyMetadata(
+                "",
+                FrameworkPropertyMetadataOptions.BindsTwoWayByDefault,
+                StanEkranuPropertyChangedCallback));
+
+        ////////////////////////
+
+        public const string PodpowiadaneAdresyPropertyName = "PodpowiadaneAdresy";
+
+        /// <summary>
+        /// Adresy podpowiadane do listy <see cref="TypyUstawien.CertHosts"/> (§5.5) - liczy je
+        /// ViewModel, bo powstają z całej konfiguracji (host z SERVICEURL) i z maszyny, a nie
+        /// z jednego pola.
+        /// </summary>
+        public IEnumerable<String> PodpowiadaneAdresy
+        {
+            get { return (IEnumerable<String>) GetValue(PodpowiadaneAdresyProperty); }
+            set { SetValue(PodpowiadaneAdresyProperty, value); }
+        }
+
+        public static readonly DependencyProperty PodpowiadaneAdresyProperty = DependencyProperty.Register(
+            PodpowiadaneAdresyPropertyName,
+            typeof(IEnumerable<String>),
+            typeof(MyEditor),
+            new PropertyMetadata(null, StanEkranuPropertyChangedCallback));
+
+        /// <summary>
+        /// Stan CAŁEGO ekranu (dostępność Caddy'ego, wybrany host, wybrany certyfikat,
+        /// podpowiadane adresy) przychodzi bindowaniem, więc każda jego część może przyjść PO
+        /// ustawieniu typu - i każda zmienia to, co pokazuje pole.
+        /// </summary>
+        private static void StanEkranuPropertyChangedCallback(
+            DependencyObject d, DependencyPropertyChangedEventArgs e)
+        {
+            ((MyEditor) d).OdswiezPole();
+        }
+
+        ////////////////////////
+
+        private const Double RozmiarCzcionki = 14;
+
+        private static readonly Thickness Wciecie = new Thickness(4);
+
+        private readonly MyEditorText editorText;
+        private readonly MyEditorPassword editorPassword;
+        private readonly MyEditorDate editorDate;
+        private readonly MyEditorFile editorFile;
+        private readonly MyEditorDirectory editorDirectory;
+        private readonly MyEditorVault editorVault;
+        private readonly MyEditorCheckBox editorCheckBox;
+        private readonly MyEditorCertificate editorCertificate;
+        private readonly MyEditorHost editorHost;
+        private readonly MyEditorCertHosts editorCertHosts;
+
+        /// <summary>
+        /// Rejestr pól - JEDYNE miejsce, w którym typ ustawienia spotyka się ze swoją kontrolką.
+        /// Kolejność ma znaczenie: bierze pierwszy pasujący wpis, a ostatni bierze wszystko.
+        /// </summary>
+        private readonly IList<PoleEdytora> pola;
+
+        /// <summary>Pole pokazane w tej chwili - null, dopóki nie znany jest typ ustawienia.</summary>
+        private PoleEdytora poleAktualne;
+
+        ////////////////////////
+
+        public MyEditor()
+        {
+            this.editorText = Nowe(new MyEditorText());
+            this.editorPassword = Nowe(new MyEditorPassword());
+            this.editorDate = Nowe(new MyEditorDate());
+            this.editorFile = Nowe(new MyEditorFile());
+            this.editorDirectory = Nowe(new MyEditorDirectory());
+            this.editorVault = Nowe(new MyEditorVault());
+            this.editorCheckBox = Nowe(new MyEditorCheckBox());
+            this.editorCertificate = Nowe(new MyEditorCertificate());
+            this.editorHost = Nowe(new MyEditorHost());
+            this.editorCertHosts = Nowe(new MyEditorCertHosts());
+
+            this.pola = Rejestr();
+
+            // Host obowiązujący zmienia też sama przebudowa listy (pierwsza pozycja przy pustej
+            // wartości), a nie tylko wybór człowieka - a pole certyfikatu czyta z niego, czy
+            // pokazać sentinele Caddy'ego (§5.5). Wybór człowieka idzie osobno, przez
+            // ValueChanged: zaznaczenie zrobione przez przebudowę NICZEGO nie zapisuje.
+            this.editorHost.WybranyHostZmieniony += EditorHost_WybranyHostZmieniony;
+
+            this.Children.Clear();
+            this.Children.Add(this.editorText);
+        }
+
+        private static TKontrolka Nowe<TKontrolka>(TKontrolka Kontrolka) where TKontrolka : IMyEditorControl
+        {
+            Kontrolka.EditorFontSize = RozmiarCzcionki;
+            Kontrolka.EditorPadding = Wciecie;
+
+            return Kontrolka;
+        }
+
+        private IList<PoleEdytora> Rejestr()
+        {
+            return new List<PoleEdytora>
+            {
+                PoleEdytora.Dla(typ => typ == "VAULTURL", this.editorVault),
+                PoleEdytora.Dla(typ => typ == "DIRECTORY", this.editorDirectory),
+                PoleEdytora.Dla(typ => typ == "FILE", this.editorFile),
+                PoleEdytora.Dla(typ => typ == "DATETIME", this.editorDate),
+                PoleEdytora.Dla(typ => typ == "CHECKBOX", this.editorCheckBox),
+                PoleEdytora.Dla(CzyPoleWyboruCertyfikatu, this.editorCertificate, ZasilCertyfikat),
+                PoleEdytora.Dla(TypyUstawien.CzyTypHosta, this.editorHost, ZasilHost),
+                PoleEdytora.Dla(
+                    typ => TypyUstawien.CzyTyp(typ, TypyUstawien.CertHosts), this.editorCertHosts, ZasilAdresy),
+                PoleEdytora.Dla(typ => typ == "PASSWORD", this.editorPassword),
+                // Ostatni wpis bierze wszystko, czego nie wziął żaden wcześniejszy - typ
+                // nieznany Updaterowi (starszy albo nowszy Settings.json) zostaje tekstem.
+                PoleEdytora.Dla(typ => true, this.editorText)
+            };
+        }
+
+        ////////////////////////
+
+        /// <summary>Czy hostem tej konfiguracji jest Caddy - tylko wtedy ma on czym wystawić certyfikat (§5.5).</summary>
+        private Boolean CzyHostemCaddy
+        {
+            get { return this.CzyCaddyDostepny && TypyUstawien.CzyHostCaddy(this.WybranyHost); }
+        }
+
+        /// <summary>
+        /// Czy certyfikat pokazuje się jako LISTA WYBORU. Typ <see cref="TypyUstawien.CertyfikatNetsh"/>
+        /// jest nią od dawna, ale <see cref="TypyUstawien.CertyfikatHttps"/> 79 aplikacji rodzin
+        /// A i B jest dziś polem tekstowym i sama aktualizacja Updatera nie ma prawa tego
+        /// zmienić: lista zna wyłącznie odciski z magazynu TEJ maszyny, więc wartość spoza niego
+        /// przestałaby dać się wpisać z ręki - a wydanie dociera na wszystkie stanowiska naraz,
+        /// bez porządku wdrożenia, który chroni nowe typy ustawień (§5.7). Lista wchodzi więc
+        /// dopiero tam, gdzie coś wnosi: przy hoście Caddy, bo tylko wtedy w grę wchodzą
+        /// sentinele (§5.5), i tak jak reszta zmian czeka na świadomy wybór człowieka.
+        /// </summary>
+        private Boolean CzyPoleWyboruCertyfikatu(String Typ)
+        {
+            if (TypyUstawien.CzyTyp(Typ, TypyUstawien.CertyfikatNetsh))
+                return true;
+
+            return TypyUstawien.CzyTyp(Typ, TypyUstawien.CertyfikatHttps) && this.CzyHostemCaddy;
+        }
+
+        private void ZasilCertyfikat()
+        {
+            this.editorCertificate.CzyHostemCaddy = this.CzyHostemCaddy;
+        }
+
+        private void ZasilHost()
+        {
+            this.editorHost.Typ = ValueType;
+            this.editorHost.CzyCaddyDostepny = this.CzyCaddyDostepny;
+        }
+
+        private void ZasilAdresy()
+        {
+            this.editorCertHosts.PodpowiadaneAdresy = this.PodpowiadaneAdresy;
+            this.editorCertHosts.WybranyCertyfikat = this.WybranyCertyfikat;
+        }
+
+        ////////////////////////
+
+        void OnValueChanged()
+        {
+            OnPropertyChanged("Value");
+            SetValueToControl();
+        }
+
+        void OnValueTypeChanged()
+        {
+            Unbind();
+            this.Children.Clear();
+
+            this.poleAktualne = PoleDlaTypu(ValueType);
+            this.poleAktualne.Kontrolka.IsReadOnly = CzyNieedytowalne(ValueType);
+            this.poleAktualne.Odswiez();
+            this.Children.Add(this.poleAktualne.Element);
+
+            SetValueToControl();
+            OnPropertyChanged("ValueType");
+            Bind();
+        }
+
+        void SetValueToControl()
+        {
+            PoleDlaTypu(ValueType).Kontrolka.Value = Value ?? "";
+        }
+
+        /// <summary>
+        /// Zmiana stanu ekranu potrafi przestawić nie samą zawartość pola, ale jego RODZAJ
+        /// (CERTYFIKAT_HTTPS: lista wyboru przy hoście Caddy, pole tekstowe poza nim) - wtedy
+        /// pole buduje się od nowa. Wartość przechodzi przez przebudowę nietknięta: pole
+        /// tekstowe pokazuje ją tak samo jak lista, więc odcisk zapisany przy hoście Caddy nie
+        /// znika po powrocie na usługę.
+        /// </summary>
+        private void OdswiezPole()
+        {
+            if (this.poleAktualne == null)
+                return;
+
+            if (PoleDlaTypu(ValueType) != this.poleAktualne)
+            {
+                OnValueTypeChanged();
+                return;
+            }
+
+            this.poleAktualne.Odswiez();
+        }
+
+        private PoleEdytora PoleDlaTypu(String Typ)
+        {
+            var typ = TypyUstawien.BezReadonly(Typ);
+
+            return this.pola.First(pole => pole.CzyObsluguje(typ));
+        }
+
+        /// <summary>Sufiks "_READONLY" nie robi z ustawienia innego typu - tylko zabiera prawo do edycji.</summary>
+        private static Boolean CzyNieedytowalne(String Typ)
+        {
+            return (Typ ?? "").Contains("_READONLY");
+        }
+
+        ////////////////////////
+
+        private void Pole_ValueChanged(object sender, object e)
+        {
+            this.Value = UniConvert.ToString(e);
+
+            // Wybór certyfikatu jest wspólny dla ekranu - podgląd trybów przy liście adresów
+            // z niego czyta, co pokazać (§5.5). Tak samo niesie go lista wyboru, jak i odcisk
+            // wpisany z ręki (host inny niż Caddy): bez tego podgląd pokazywałby stan sprzed
+            // edycji.
+            if (TypyUstawien.CzyTypCertyfikatu(ValueType))
+                this.WybranyCertyfikat = this.Value;
+        }
+
+        private void EditorHost_WybranyHostZmieniony(object sender, EventArgs e)
+        {
+            this.WybranyHost = this.editorHost.WybranyHost;
+        }
+
+        ////////////////////////
+
+        void Bind()
+        {
+            Unbind();
+
+            foreach (var pole in this.pola)
+                pole.Kontrolka.ValueChanged += Pole_ValueChanged;
+        }
+
+        void Unbind()
+        {
+            foreach (var pole in this.pola)
+                pole.Kontrolka.ValueChanged -= Pole_ValueChanged;
+        }
+
+        ////////////////////////
+
+        private void OnPropertyChanged(String P)
+        {
+            if (PropertyChanged != null)
+                PropertyChanged.Invoke(this, new PropertyChangedEventArgs(P));
+        }
+
+        public event PropertyChangedEventHandler PropertyChanged;
+    }
+}
