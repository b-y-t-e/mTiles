<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:ac="using:mTiles.ViewModels.AgentConversation"
             xmlns:m="using:mTiles.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:v="using:mTiles.Views"
             xmlns:p="using:mTiles.Controls"
             x:Class="mTiles.Views.GoalTileView"
             x:DataType="vm:GoalTileViewModel">

    <!--
        The Goal tile is a transcript, not a chat app, so it is drawn as one: the terminal's own
        monospace face at the terminal's own size, the app's colour tokens (which ThemeBridge derives
        from the active terminal theme), and a fixed gutter column whose glyph says who spoke — a dot
        the tool, a corner a note from the tile itself.

        **Your own messages are the exception, and that is a reversal.** This said "no bubbles: they
        aligned every message differently and made a two-line answer look like a different kind of thing
        from a twenty-line one", and the second half of that is still true — which is why only *your*
        side moved. What the tool says still runs the full width from the left, at one width whatever its
        length; what you typed sits on the right, at most three quarters across (Views/BubbleLayout.cs).
        The asymmetry is the point: in a column of turns the first thing a reader needs is which of the
        two is speaking, and a side says it before a character is read — which is what let the angle
        bracket in your gutter go, since two things saying the same thing is one of them being ignored.

        The one saturated colour in here is the phase dot in the status strip. Everything else is
        text, muted chrome and one hairline per edge.
    -->
    <UserControl.Resources>
        <!-- ======== One finding ========
             Shared by the transcript and by the popup a badge opens, which are two views of the same
             review: the severity is a thing to see rather than a word to read, so the coloured edge
             answers "how much does this matter" before the title is reached, and it has to answer it
             the same way in both places. Two copies of this markup drifted apart the first time one of
             them was touched. -->

        <!-- ======== One question, after it has been answered ========
             The record half of a clarification round. The same question, the same reason, the same
             hanging indent — and the answer under it rather than in a box, because the round is over.

             No number. A number is a position in a round and it earns its place while answers are being
             filed against questions; once the round is a record, the pair of glyphs this tile already
             uses for "asked" and "you said" carries it, and they are the same two the conversation
             around it is read by. The offered answers are not repeated either: they were an offer, one
             of them was taken or it was not, and the record is what happened rather than what was on
             the menu. Both are still in the message's text, which is what the clipboard gets. -->
        <DataTemplate x:Key="AskedQuestionTemplate" DataType="m:GoalQuestion">
            <Grid Classes="asked" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="ask-marker" Text="?" />
                <StackPanel Grid.Column="1">
                    <TextBlock Classes="ask-question" Text="{Binding Question}" />
                    <TextBlock Classes="ask-why"
                               IsVisible="{Binding Why, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding Why}" />

                    <DockPanel Margin="0,5,0,0"
                               IsVisible="{Binding Answer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock DockPanel.Dock="Left" Classes="ans-marker" Text="&#x276F;" />
                        <SelectableTextBlock Classes="msg" Text="{Binding Answer}" />
                    </DockPanel>

                    <!-- Said rather than left blank. A question with nothing under it reads as one the
                         record lost, and what actually happened - it was asked and skipped - is a thing
                         the next round is entitled to ask about again. -->
                    <TextBlock Classes="ask-why"
                               Margin="0,5,0,0"
                               IsVisible="{Binding Answer, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                               Text="not answered" />
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="item-copy"
                        v:CopyButton.Text="{Binding Converter={x:Static v:CopyableText.Instance}}"
                        ToolTip.Tip="Copy this question and its answer">
                    <mi:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The conversation's own look - rows, the ask, the composer - shared with the Agent tile.
             First, because Avalonia has no specificity and the later style wins: a finding's own rules
             below refine these, and reversed they were overruled (a finding's copy button never showed). -->
        <StyleInclude Source="avares://mTiles/Styles/Conversation.axaml" />
        <!-- A finding's own look, shared with the dialog a badge opens - see the file. -->
        <StyleInclude Source="avares://mTiles/Styles/GoalFindings.axaml" />


        <!-- Dimmer than the phase beside it, and it never grows the strip: a tool call is transient and
             must not be able to push what the tile is doing off the end of the line. -->
        <Style Selector="TextBlock.strip-activity">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="MaxWidth" Value="220" />
        </Style>



        <!-- ======== Finding badges ========
             What the last review counted, in the one place in this tile that already carries colour.
             Three glyphs wide and no wider: the numbers belong beside the phase, and the findings
             themselves are in the transcript, where they can be read. -->
        <Style Selector="TextBlock.badge">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TermFontSm}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- Blockers and errors share the red: both mean "must fix", and the letter is what tells them
             apart. There is one danger token, and inventing a second red for a six-pixel label would
             leave two shades nobody could rank at a glance. The blocker is bold instead. -->
        <Style Selector="TextBlock.badge.badge-blocker">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.badge.badge-error">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="TextBlock.badge.badge-warning">
            <Setter Property="Foreground" Value="{DynamicResource GoalPhasePlan}" />
        </Style>
        <Style Selector="TextBlock.badge.badge-suggestion">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>

        <!-- The badge is the whole button: no chrome of its own, because the strip is a line of text
             and a bordered control in it would be the only box on the bar. What says it can be pressed
             is the ground lifting under the pointer, which is what every other pressable thing in this
             application does. -->
        <Style Selector="Button.badge-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.badge-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        </Style>
        <Style Selector="Button.badge-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
        </Style>

        <!-- The head names what was opened and carries the way out of it. A hairline rather than a
             gap, so the title cannot be read as the first line of the list under it; the card's own
             padding is nil so that rule runs the full width, and each part inside sets its own. -->
        <!-- The head already says which severity these are, so the word on every row is the same
             word four times over, taking the first line of each finding to say what the reader has
             just read. It stays in the transcript, where the rows of a review are mixed. -->

        <!-- ======== Completion criteria ========
             Drawn as a config file rather than as a settings form, because that is what it is and
             because this tile is a terminal: a key on the left, a value on the right, one per line, in
             the terminal face at the terminal size. A grid of paired labels and spinners would be the
             only part of this tile that looked like a dialog. -->
        <Style Selector="Border.criteria">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderBottom}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.crit-label">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TermFontSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector="TextBlock.crit-title">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TermFontSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox.crit-field">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TermFontSm}" />
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox.crit-check">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TermFontSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- ======== SOLID, as five letters ========
             Five checkboxes with five long names would be a third of this panel for a setting most
             users will never touch. The acronym is already the interface: the letters in order spell
             what the row is, each one carries its full name in a tooltip, and lit means "held to it".

             Lit is the default and unlit is the deliberate act, which is why the off state is drawn as
             the quiet one — a letter switched off should read as absent from the word, not as a control
             waiting to be filled in. -->
        <Style Selector="ToggleButton.crit-solid">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource TermFontSm}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <!-- The template targets are what actually paint: Fluent's ToggleButton keeps its own
             background and border in the ContentPresenter, so setting them on the control alone leaves
             the checked state looking exactly like the unchecked one.

             Four rules rather than three, and the reason is that hovering must not answer the question
             the chip exists to answer. Written as one `:pointerover`, the pointer lit the letter up —
             elevated fill, bright text — so an *off* chip under the cursor looked exactly like an on
             one, at the only moment anybody is looking closely at it: while deciding whether to click.
             Hover is therefore a border, and only a border; the fill and the letter stay with the
             state. Both hovered cases are spelled out because a rule that sets only the border leaves
             Fluent's own hover fill showing through underneath, which is the same lie by another
             route. -->
        <Style Selector="ToggleButton.crit-solid:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.crit-solid:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="ToggleButton.crit-solid:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextHover}" />
        </Style>




        <!-- ======== A row of things to do next ========
             The finished-run actions and the two detect buttons. They are turns in the conversation as
             much as the composer is — what the tile is offering, at the point it offers it — so they
             take the conversation's own margins and no ground of their own. As docked bars they carried
             a background and a hairline each, which is what a bar pinned to an edge needs and what a
             block in a scrolling list does not: three grounds stacked at the foot of the transcript,
             none of them the transcript's. -->
        <Style Selector="StackPanel.chat-actions">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Spacing" Value="6" />
            <!-- The composer's left edge, and a wider right one — the only asymmetry in this column
                 and the only row that earns it. Avalonia draws the scroller's bar over the content and
                 widens it to about fourteen pixels under the pointer; everything else here is a long
                 box or a paragraph, whose edge being covered for a moment reads as a scrollbar passing
                 over it, while a small button's covered edge reads as a button that has been cut. The
                 lane is here and not on the whole column, which would push the composer, the ask
                 blocks and every message off their own right edge to fix one row.

                 **The lane is gone, and so is the asymmetry.** These sit outside the scroller now — the
                 whole group is docked to the foot of the tile — so there is no scrollbar passing over
                 them to clear, and an eighteen-pixel right margin was leaving the buttons further from
                 the edge than the composer directly above them. They share the composer's own margin,
                 because they are now the same block. -->
            <Setter Property="Margin" Value="8,8,8,6" />
        </Style>

        <!-- ======== The one control under the composer ========
             Two buttons drawn as one: the primary segment squares off its right edge, the caret its
             left, so the pair reads as a single control with a divider rather than as two buttons that
             happen to touch. The radius is the one every small control here uses; only the two inner
             corners are given up. -->
        <Style Selector="StackPanel.run-split">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="Button.run-primary">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
        </Style>
        <Style Selector="Button.run-more">
            <Setter Property="CornerRadius" Value="0,4,4,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="1,0,0,0" />
        </Style>



        <!-- ======== A review finding ========
             The transcript is a terminal and a review was a column of monospace: severity, place,
             title, detail, all in one grey. It scans up to a point, and the point is colour - the
             blocker and the suggestion looked identical three lines apart, so the line worth reading
             first was the one the eye had to search for. Each finding is now a card with a coloured
             edge, which says how much it matters before a word of it is read. The colours are the
             badges own: one danger token for blockers and errors, the plan colour for warnings, and
             faint for suggestions, so the strip at the top and the list below agree. -->
        <!-- A rail and some air, not a box. The band of BgSurface behind each finding was a second
             ground inside a card that already has one, and with three or four findings in a row the
             list read as a stack of panels rather than as a list — the same argument that took the
             chips out of the workspaces panel. What tells the severities apart is the coloured edge,
             which is doing that job either way; what separates two findings is the space between them.

             No corner radius, and that is not only taste: a Border with a radius clips its child, and
             this one holds text that is measured elsewhere. Every clip here is a line the reader loses
             the end of without being told. -->
        <!-- The gap belongs between two findings, so the first does not carry it: in the popup it put
             a band of empty ground under the head's rule. After the base style, or the base's own
             Margin is the one that lands - matching styles are applied in declaration order. -->

        <!-- The severity is the label, so it carries the colour and the weight; the place beside it is
             faint, because it says where to look rather than what is wrong. -->
        <!-- Muted, not faint. Faint is what this application uses for something it is prepared to have
             the reader skip; a file and a line are how the reader gets from a finding to the code, and
             on the dialog's elevated ground the faint token had them fading out of the row. -->
        <!-- The title reads at the transcript's own size and in its own colour: it is the sentence the
             finding is. The detail is the argument for it, one step quieter — and with no band behind
             the row any more, that one step is the whole of what separates them, so the title takes the
             weight the box used to carry. -->



    </UserControl.Styles>

    <Panel>
    <DockPanel Background="{DynamicResource BgBase}">

        <!-- ======== Status strip: which tool, which phase, and the three things you can do ======== -->
        <Border DockPanel.Dock="Top"
                Padding="6,3"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="{DynamicResource BorderBottom}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                    <Button Classes="tile-btn"
                            Command="{Binding ToggleCriteriaCommand}"
                            ToolTip.Tip="When is this goal done?">
                        <mi:MaterialIcon Kind="CogOutline" Width="13" Height="13" />
                    </Button>
                    <Button Classes="tile-btn"
                            Command="{Binding PauseCommand}"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="Pause">
                        <mi:MaterialIcon Kind="Pause" Width="13" Height="13" />
                    </Button>
                    <!-- No Resume here. It was this strip's play glyph for a long time, and once the
                         same command became a labelled button at the end of the conversation the glyph
                         was a second, unlabelled route to it, thirteen pixels wide at the opposite end
                         of the tile from the sentence that names it. Pause stays: it is the one of the
                         pair that has to be reachable while the transcript is scrolled anywhere at all,
                         because what it interrupts is happening now. -->
                    <!-- The Agent tile's new-conversation glyph and colour, so the two conversations
                         say "start another" the same way. -->
                    <Button Classes="tile-btn tile-btn-accent"
                            Command="{Binding NewGoalCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="New goal">
                        <mi:MaterialIcon Kind="MessagePlusOutline" Width="13" Height="13" />
                    </Button>
                </StackPanel>

                <!-- One line, and RowFitter decides what gives way (GoalStripLayout): effort and mode to
                     their icons, then the status to its dot, then the agent trimmed and at last to its
                     icon. A DockPanel rather than a horizontal StackPanel, because a StackPanel measures
                     its children with infinite width and nothing in it can ever trim. -->
                <DockPanel x:Name="StripRow">
                    <!-- The execution agent, and only that one, is in the strip. Five controls do not
                         fit a narrow tile, and of the five this is the one whose value has to be
                         readable at a glance: which agent is writing into this repository. The
                         reviewer is a once-per-goal setting and lives in the panel below. -->
                    <p:Picker x:Name="ExecutionAgentPicker"
                              DockPanel.Dock="Left" Margin="0,0,2,0"
                              Classes="strip-picker"
                              Options="{Binding AvailableAgents}"
                              SelectedId="{Binding ExecutionAgentInstanceId, Mode=OneWay}"
                              Text="{Binding ExecutionAgent.Label, FallbackValue={x:Null}}"
                              Placeholder="Agent"
                              DropDownWidth="300"
                              MaxWidth="200"
                              ToolTip.Tip="Which agent carries the goal out. Configured agents this machine can run — the CLI installed, and the provider it names still configured.">
                        <p:Picker.Icon>
                            <mi:MaterialIcon Kind="RobotOutline" Width="13" Height="13" />
                        </p:Picker.Icon>
                    </p:Picker>
                    <!-- Beside the tool because it is a fact about the tool, and because this is where
                         somebody looks after a run that was refused. The default is auto: without a
                         mode the tool inherits the user's own Claude Code settings, and the factory
                         default there is to ask — which a headless run cannot do, so every edit was
                         refused and the tile reported that nothing had changed. -->
                    <p:Picker x:Name="PermissionModePicker"
                              DockPanel.Dock="Left" Margin="0,0,2,0"
                              Classes="strip-picker"
                              Options="{Binding AvailablePermissionModes}"
                              SelectedId="{Binding PermissionModeLabel, Mode=OneWay}"
                              Text="{Binding PermissionModeLabel}"
                              DropDownWidth="330"
                              ToolTip.Tip="What the AI tool may do without asking. auto gets on with the work and still stops at what it considers dangerous; accept edits waves through file changes only; bypass asks about nothing at all; default passes no flag and leaves it to the tool's own settings.">
                        <p:Picker.Icon>
                            <mi:MaterialIcon Kind="LockOutline" Width="13" Height="13" />
                        </p:Picker.Icon>
                    </p:Picker>
                    <!-- Beside the mode because they are the same kind of fact: how this tile runs its
                         tool. High by default rather than the tool's own, which is tuned for a person
                         watching — a goal run is left alone, and an attempt spent on a shallow answer
                         costs as much of the budget as a careful one. -->
                    <p:Picker x:Name="EffortPicker"
                              DockPanel.Dock="Left" Margin="0,0,2,0"
                              Classes="strip-picker"
                              Options="{Binding AvailableEfforts}"
                              SelectedId="{Binding EffortLabel, Mode=OneWay}"
                              Text="{Binding EffortLabel}"
                              DropDownWidth="300"
                              ToolTip.Tip="How hard the AI tool is asked to think. Higher costs time and tokens and is usually worth it here, because the budget is in attempts and a shallow attempt spends one just the same. default passes no flag — pick it if your Claude Code is old enough not to know the option.">
                        <p:Picker.Icon>
                            <mi:MaterialIcon Kind="Brain" Width="13" Height="13" />
                        </p:Picker.Icon>
                    </p:Picker>
                    <!-- The status, as the Agent tile's strip draws it and in its colours (GoalStatus):
                         a rule, then a word coloured by what it says, and compact a dot of that colour.
                         It replaced a dot coloured by phase beside a label that was empty whenever the
                         tile was idle, which answered "can I type here" in a language of its own. -->
                    <v:StripStatus x:Name="StatusView"
                                   DockPanel.Dock="Left"
                                   Text="{Binding StatusText}"
                                   Tone="{Binding StatusTone}"
                                   ToolTip.Tip="{Binding StatusTip}" />
                    <!-- One template, four styles. Every severity used to need a view-model
                         property, a TextBlock, a visibility converter and a style, and each of the four
                         could be forgotten on its own. -->
                    <ItemsControl x:Name="Badges" DockPanel.Dock="Right" ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GoalBadge">
                                <!-- The count is a question - which two errors? - and the answer was
                                     three screens up in a transcript the user had scrolled away from.
                                     Pressing the badge brings that severity's findings to where the
                                     count is.

                                     Hit-testing off rather than disabled when there is nothing to open
                                     (a goal file written before findings were kept): a greyed-out
                                     badge would look like a count this tile no longer trusts, when the
                                     count is exactly what it still knows. -->
                                <Button Classes="badge-button"
                                        IsHitTestVisible="{Binding HasFindings}"
                                        ToolTip.Tip="{Binding Tooltip}"
                                        Command="{Binding $parent[UserControl].((vm:GoalTileViewModel)DataContext).OpenFindingsCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Classes="badge"
                                               Classes.badge-blocker="{Binding IsBlocker}"
                                               Classes.badge-error="{Binding IsError}"
                                               Classes.badge-warning="{Binding IsWarning}"
                                               Classes.badge-suggestion="{Binding IsSuggestion}"
                                               Text="{Binding Text}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The activity fills what is left and is the first thing to go: it is about this
                         second, and a DockPanel trims its last child. RowFitter never counts it. -->
                    <TextBlock Classes="strip strip-activity"
                               Text="{Binding ActivityText}"
                               IsVisible="{Binding ActivityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ActivityText}"
                               Margin="6,0,0,0" />
                </DockPanel>
            </DockPanel>
        </Border>


        <!-- ======== When is this goal done? ========
             Everything here used to be a constant: five attempts, and the presence of the characters
             "VERDICT: PASS" anywhere in the review. -->
        <Border DockPanel.Dock="Top" Classes="criteria" IsVisible="{Binding ShowCriteria}">
            <StackPanel>
                <!-- A once-per-goal setting, so it is in the panel rather than the strip. A second
                     agent is what makes a review something other than the author marking their own
                     work; "same as execution" is the default and a real answer, which is why it is a
                     row in the list rather than an empty box. The review's permission comes from the
                     agent by phase, so a reviewer is read-only unless the criteria oblige it to build
                     and test — see AiUsage. -->
                <TextBlock Classes="crit-title" Text="reviewed by" />
                <p:Picker x:Name="ReviewAgentPicker"
                          Classes="strip-picker" Margin="0,0,0,6" MinWidth="160"
                          HorizontalAlignment="Left"
                          Options="{Binding ReviewAgentChoices}"
                          SelectedId="{Binding ReviewAgentInstanceId, Mode=OneWay}"
                          Text="{Binding ReviewAgentLabel}"
                          DropDownWidth="300"
                          ToolTip.Tip="Which agent reviews the work. A different one is a second opinion; the same one is the author marking their own work." />

                <TextBlock Classes="crit-title" Text="done when" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="crit-label" Text="attempts" Margin="0,6,10,0" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <!-- LostFocus puts the fields back to what the tile actually holds. Avalonia
                             reports a failed string-to-int conversion as a binding error, not as data
                             validation, so the :error pseudo-class never fires and a style built on it
                             would be decoration that cannot light up. What can be done is make the junk
                             disappear when the field does, which is the behaviour anyone expects. -->
                        <TextBox Classes="crit-field"
                                 Text="{Binding Criteria.MaxIterations}"
                                 MinWidth="56"
                                 LostFocus="NumberBox_LostFocus"
                                 ToolTip.Tip="Implement/review laps before the run gives up (1-50)" />
                        <!-- Shown only when the run will not use what is in the box; see ShowClampNotes. -->
                        <TextBlock Classes="crit-label"
                                   Text="{Binding Criteria.AttemptsNote}"
                                   Foreground="{DynamicResource DangerText}"
                                   IsVisible="{Binding Criteria.AttemptsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="crit-label" Text="tolerated" Margin="0,6,10,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBox Classes="crit-field" Text="{Binding Criteria.MaxErrors}" MinWidth="42"
                                 LostFocus="NumberBox_LostFocus"
                                 ToolTip.Tip="Errors allowed to remain. Blockers never are." />
                        <TextBlock Classes="crit-label" Text="errors" />
                        <TextBox Classes="crit-field" Text="{Binding Criteria.MaxWarnings}" MinWidth="42"
                                 LostFocus="NumberBox_LostFocus"
                                 ToolTip.Tip="Warnings allowed to remain" />
                        <TextBlock Classes="crit-label" Text="warnings" Margin="0" />
                        <TextBlock Classes="crit-label"
                                   Text="{Binding Criteria.TolerancesNote}"
                                   Foreground="{DynamicResource DangerText}"
                                   Margin="0"
                                   IsVisible="{Binding Criteria.TolerancesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Which SOLID principles this goal's work is held to. On the criteria panel and
                         not in Settings because it belongs to the goal: the same person wants all five
                         in a library they will maintain for years and none of them in a one-page
                         script. And it is a completion criterion in the only sense that matters — a
                         violation comes back as a warning, against the tolerance two rows up. -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="crit-label" Text="principles" Margin="0,6,10,0" />
                    <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                  ItemsSource="{Binding Criteria.Solid}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GoalSolidToggle">
                                <!-- The name is on the chip as well as in the tooltip. The content is
                                     one character and a tooltip is a pointer gesture, so to anything
                                     reading this aloud the row was five buttons called S, O, L, I and
                                     D — the letters only spell something to somebody who already knows
                                     what they stand for, which is the one reader that does not need
                                     them read out. -->
                                <ToggleButton Classes="crit-solid"
                                              Content="{Binding Letter}"
                                              IsChecked="{Binding IsOn}"
                                              AutomationProperties.Name="{Binding Name}"
                                              ToolTip.Tip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.RequireGoalMet}"
                          Content="the review says the goal is met"
                          ToolTip.Tip="Separate from the counts: clean code that does the wrong thing has no findings" />
                <!-- The two health checks. They are sentences added to the prompts, not commands this
                     tile runs, so what they buy is the tool checking its own work with this project's
                     own build and test commands — which it can work out and the panel could not.

                     What they replace was a verify command: a shell line proposed by the clarification
                     round, approved by the user and run by the tile, with its exit code gating
                     completion. That only ever worked in a repository which was already green, and a
                     project whose suite has failures nobody has got to yet is the ordinary case — so
                     the gate spent every attempt of every goal on failures the work had not caused and
                     then reported the goal as not reached.

                     Tests are their own switch rather than part of "builds" for exactly that reason:
                     a red suite is a thing a user may reasonably want left alone while still asking
                     for code that compiles. -->
                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.RequireBuild}"
                          Content="the project still builds"
                          ToolTip.Tip="The tool is told to check this itself with this project's own build command, and to fix what it broke." />
                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.RequireTestsPass}"
                          Content="the tests still pass"
                          ToolTip.Tip="The tool is told to run this project's own tests. Failures that were already there are reported, not fixed — turn this off in a repository whose suite is red on purpose." />
                <!-- The only switch on this panel that starts off, and the only one that writes to the
                     user's history. Off does not mean the feature is unavailable — the same conditions
                     put a Commit button in the summary — so this says who starts it, never whether it
                     is confirmed. It always is. -->
                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.CommitWhenDone}"
                          Content="commit the work when done"
                          ToolTip.Tip="When a run ends with no blockers and no errors, work out the commits and ask. Only files this run changed are committed — anything you had already changed before the goal started is left alone. Off: the same offer appears as a button instead." />
                <!-- The two mechanical stops used to be checkboxes here and are neither settings nor
                     switches any more: both are always on. A switch is worth a line of this panel where
                     two users would reasonably choose differently, and nobody reasonably chooses to
                     spend attempts on a tool that just wrote nothing, or on a review that has said the
                     same thing twice. What replaced them is the summary naming which of the two ended
                     the run — see GoalCompletionPolicy.Summarise. -->
            </StackPanel>
        </Border>


        <!-- ======== The conversation, and everything the tile asks of you inside it ========
             One scroller, one column, and nothing pinned to the bottom edge.

             What used to be here was four bars docked under the transcript — the composer, the plan
             box, the two detect buttons and the finished-run actions — with the questions in a fifth
             behind a draggable splitter. Every one of them was a fixed slab across the foot of the
             tile, and between them they took most of a small one: a tile that had been asked three
             questions was a band of buttons over two lines of the conversation they were about.

             It was also two shapes for one thing. A round of questions was asked in a panel and
             recorded, afterwards, as a numbered paragraph several screens up — so the control you
             answered in and the record you read back were laid out differently, and neither was where
             the other was. Now the ask *is* the row: it arrives at the end of the conversation, where
             the next thing always arrives, and when it is answered it stays exactly there as the record
             of what was asked and what you said.

             The consequences are worth stating, because they are the price. Everything here scrolls,
             the composer included, so a user reading back through a plan has to return to the bottom to
             type — which the follow-to-the-bottom rule does for them on every new message, and which is
             the same gesture a terminal asks for. And the tile's height is no longer divided between a
             conversation and a panel, so nothing needs a splitter, a default height or a clamp: a round
             of questions is as tall as it is, above the answers box, in a list that scrolls. -->
        <!-- ======== What you act with ========
             Docked to the bottom of the tile rather than trailing the conversation. It was the last
             block in the scroller, on the argument that the composer is the next thing in a
             conversation and belongs where the next thing goes - right about a reading order and wrong
             about a control: scroll back to read a review from two attempts ago and the box you want to
             answer in, and the Resume you want to press, have both gone off the bottom.

             The composer and the finished-run buttons move together, because they were already one
             group for a reason the old comment gives: everything this tile offers is in one place,
             under the box. -->
        <StackPanel DockPanel.Dock="Bottom">
            <!-- ======== Composer ========
                 The last thing in the conversation, and only when there is something it can send: not
                 while the tool is working, and not while one of the blocks above is asking for the same
                 thing in a better shape.

                 No second "the tool is busy" line here. The status strip already carries it, with the
                 phase and the iteration number in it, so a line saying only that something is happening
                 was the same news told worse. -->
            <Border x:Name="Composer" Classes="composer"
                    IsVisible="{Binding ShowComposer}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Classes="gutter gutter-user"
                               Margin="0,2,0,0" />
                    <!-- One control where four used to stand: the primary segment does what the
                         phase and the box say it will (Set goal for typed words, Detect goal for an
                         empty box, Send answer mid-conversation — see PrimaryActionLabel), and the
                         caret beside it holds the other four ways in. Every entry stays on its own gate — nothing is hidden or greyed out by
                         what is in the box: typed words beside a detection are a scope narrowing it
                         (see docs/GOAL.md), which is a route the menu must not close. -->
                    <!-- What was sent from here, newest first; Up and Down in the box walk the same list
                         (ComposerHistoryInput, shared with the Agent tile). Docked after the run button
                         so it stands to its left. -->
                    <StackPanel DockPanel.Dock="Right"
                                Classes="run-split"
                                VerticalAlignment="Bottom">
                        <Button Classes="chat-action primary run-primary"
                                Command="{Binding PrimaryActionCommand}"
                                IsEnabled="{Binding !IsRunning}"
                                Content="{Binding PrimaryActionLabel}"
                                ToolTip.Tip="{Binding PrimaryActionHint}" />
                        <Button Classes="chat-action run-more"
                                IsEnabled="{Binding !IsRunning}"
                                ToolTip.Tip="Other ways to start">
                            <mi:MaterialIcon Kind="ChevronDown" Width="13" Height="13" />
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <!-- Down with the rest of the menu wherever the composer is
                                         answering rather than starting: mid-conversation the same
                                         send is an answer or an approval, and an entry named after
                                         the goal it does not set would be the label the primary
                                         segment was corrected away from. -->
                                    <!-- Three entries, and every one of them reads the box the same
                                         way: words are the goal, an empty box means read one from the
                                         changes, and an @ points at a file or a commit either way.
                                         There used to be five, of which two — Detect goal and Detect
                                         & run — were the only controls on this composer that ignored
                                         what had been typed: the sentence was demoted to a hint and
                                         then replaced by a goal read off the diff, and the run
                                         variant cleared the box on its way past. So the pairs are
                                         merged and the label says which half of the box the entry is
                                         about to read. -->
                                    <MenuItem Header="{Binding PrimaryActionLabel}"
                                              Command="{Binding PrimaryActionCommand}"
                                              IsEnabled="{Binding CanSetGoal}"
                                              ToolTip.Tip="Adopt the goal — what you typed, or one read from your changes when the box is empty — and go on to the questions about it" />
                                    <Separator />
                                    <MenuItem Header="Review"
                                              Command="{Binding ReviewCommand}"
                                              IsEnabled="{Binding CanDetectGoal}"
                                              ToolTip.Tip="Judge the working tree once, against what you typed or against a goal read from your changes. Nothing is changed." />
                                    <MenuItem Header="{Binding RunActionLabel}"
                                              Command="{Binding RunCommand}"
                                              IsEnabled="{Binding CanRun}"
                                              ToolTip.Tip="Adopt the goal and run the fix loop to the end without stopping" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <p:Picker x:Name="HistoryPicker"
                              DockPanel.Dock="Right" Margin="0,0,4,0"
                              VerticalAlignment="Bottom"
                              Classes="composer-picker"
                              ShowChevron="False"
                              IsSearchEnabled="True"
                              SearchPlaceholder="Search sent messages…"
                              EmptyText="Nothing sent yet."
                              DropDownWidth="420"
                              ToolTip.Tip="Messages sent in this goal (Up/Down in the box walks them)">
                        <p:Picker.Icon>
                            <mi:MaterialIcon Kind="History" Width="13" Height="13" />
                        </p:Picker.Icon>
                    </p:Picker>
                    <TextBox x:Name="InputBox"
                             Classes="composer-input"
                             Text="{Binding InputText}"
                             PlaceholderText="Describe the goal, or answer&#x2026;"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             v:FileMentionBehavior.Mentions="{Binding FileMentions}"
                             CaretIndex="{Binding InputCaretIndex, Mode=TwoWay}" />
                </DockPanel>
            </Border>

            <!-- ======== What to do with a finished run ========
                 One row, and no sentence in it. Each of these used to be its own strip with its own line
                 of prose — "The attempts ran out.", "This run's changes are not committed." — and a
                 third would have made three sentences stacked above the composer, each restating the
                 summary message printed directly above them. The summary already says why the run
                 stopped and what is outstanding; a bar that repeats it is the same fault the status
                 strip's four idle labels had. The tooltips carry what a button does, which is the part
                 that is not already on screen.

                 Under the composer, with the detect row, and that is a correction. They sat above
                 whatever was asking — the reasoning being that they are what to do with the run that
                 just ended, so they belong beside its summary. What that produced on screen was a
                 Resume floating between the transcript and a box it had nothing to do with, and two
                 rows of buttons in one column with the input wedged between them. Everything the tile
                 offers is now in one place, under the box: the buttons are read as a group, and the
                 composer keeps the position it has in every chat window. -->
            <StackPanel Classes="chat-actions" IsVisible="{Binding HasFinishedRunActions}">
                <!-- First, and the only one of these that shows while a run is merely stopped rather
                     than finished. The transcript's last line says to click Resume; until this button
                     existed the only Resume on screen was a play glyph in the header's strip, which is
                     not where anything else this tile asks for is answered. That glyph is gone — this
                     is the whole of Resume now. -->
                <Button Classes="chat-action primary"
                        Command="{Binding ResumeCommand}"
                        IsVisible="{Binding ShowResume}"
                        IsEnabled="{Binding CanResume}"
                        Content="Resume"
                        ToolTip.Tip="Pick the stopped run up where it left off" />
                <!-- Judge the tree again against the same goal. It does not re-derive the goal: the
                     reason to press this is that something has just been fixed by hand next door, and
                     working the goal out afresh from a changed tree answers a different question. -->
                <Button Classes="chat-action"
                        Command="{Binding ReReviewCommand}"
                        IsVisible="{Binding CanReReview}"
                        Content="Review · +1"
                        ToolTip.Tip="Judge the working tree against the same goal again, changing nothing" />
                <Button Classes="chat-action"
                        Command="{Binding CommitWorkCommand}"
                        IsVisible="{Binding CanCommit}"
                        Content="Commit"
                        ToolTip.Tip="Divide this run's own changes into commits and ask before making them" />
                <Button Classes="chat-action primary"
                        Command="{Binding ContinueRunCommand}"
                        IsVisible="{Binding CanContinue}"
                        Content="{Binding ContinueLabel}"
                        ToolTip.Tip="Carry on into the implement and review loop, keeping the conversation" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="ChatScroll"
                      MinHeight="48"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,4,0,10">
            <ItemsControl x:Name="Transcript" ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:GoalMessage">
                        <!-- Yours to the right, at most three quarters of the width; everything else from
                             the left across both columns. The Agent tile's arrangement, from the same
                             place — see Views/BubbleLayout.cs. -->
                        <Grid ColumnDefinitions="1*,3*">
                        <Border Classes="row"
                                Grid.Column="{Binding Role, Converter={x:Static v:BubbleLayout.ColumnForRole}, ConverterParameter={x:Static m:GoalMessageRole.User}}"
                                Grid.ColumnSpan="{Binding Role, Converter={x:Static v:BubbleLayout.SpanForRole}, ConverterParameter={x:Static m:GoalMessageRole.User}}"
                                Classes.row-user="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.User}}"
                                Classes.row-system="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.System}}">
                            <DockPanel>
                                <!-- No glyph on your own messages: the side of the column already says
                                     who wrote them. -->
                                <TextBlock DockPanel.Dock="Left"
                                           Classes="gutter"
                                           IsVisible="{Binding Role, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:GoalMessageRole.User}}"
                                           Classes.gutter-assistant="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.Assistant}}"
                                           Classes.gutter-system="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.System}}" />
                                <Button DockPanel.Dock="Right"
                                        Classes="msg-copy"
                                        v:CopyButton.Text="{Binding Converter={x:Static v:CopyableText.Instance}}"
                                        ToolTip.Tip="Copy this message">
                                    <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                                </Button>

<!-- ======== The message ========
                                     One fill child, and that is load-bearing: a DockPanel gives its
                                     *last* child the remaining space and docks every other to the left.
                                     With the two text controls as siblings the markdown view was never
                                     the last one, so it was laid out at the width of its own content
                                     instead of the width of the row — every rendered answer narrower
                                     than the message beside it, for no reason a reader could see.

                                     Which of the four is shown is the message's own answer. The tool's
                                     prose is markdown — agents write headings, bold and fenced code
                                     whether or not anything reads them, and raw those markers are noise
                                     in every answer. What this application composed is not: a review is
                                     a column of severities with the detail indented under each, and
                                     markdown collapses runs of spaces, reads a two-space indent as a
                                     continuation, and turns a `*` inside a finding into emphasis. Nor
                                     is your own text, where an asterisk is one you typed.

                                     No external ScrollViewer around the viewer *by height*: it scrolls
                                     itself when given a finite height and sizes to its content when it
                                     is not. Inside the transcript's scroller the height is
                                     unconstrained, so it lays out as a block and the transcript does the
                                     scrolling, which is what a message in a list has to do. -->
                                <ContentControl Content="{Binding}">
                                    <ContentControl.ContentTemplate>
                                        <v:GoalMessageTemplate>
                                            <v:GoalMessageTemplate.Markdown>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <v:GoalMarkdownView MarkdownText="{Binding Text}" />
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Markdown>
                                            <!-- ======== A review, drawn rather than printed ========
                                                 The head stays text - a verdict and its counts read as
                                                 a sentence. The findings are rows, because a severity
                                                 is a thing to see and not a word to read: the coloured
                                                 edge answers "how much does this matter" before the
                                                 title is reached. A message from a goal file written
                                                 before findings were kept has none and falls through
                                                 to Plain, where it is drawn exactly as it was. -->
                                            <v:GoalMessageTemplate.Findings>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <StackPanel>
                                                        <SelectableTextBlock Classes="msg" Text="{Binding Text}" />
                                                        <!-- ======== Taking the list away whole ========
                                                             Every row already copies itself, which is
                                                             the wrong unit for the thing people
                                                             actually do with a review: paste it into
                                                             an issue, or hand it to another tool. Two
                                                             buttons, because those are the two lists
                                                             worth having - everything, and everything
                                                             that is a defect rather than a nit.

                                                             Under the verdict rather than under the
                                                             list. The counts they follow are the
                                                             sentence directly above them, so the
                                                             labels need no explaining; and a review is
                                                             a screenful or six, so an action at the
                                                             foot of it is an action you have to go
                                                             looking for. Nothing else in the
                                                             conversation is docked to a bottom edge
                                                             either.

                                                             Not hidden until the pointer arrives, as
                                                             the per-row buttons are: those repeat on
                                                             every row and would be a column of icons
                                                             down the review, while this pair appears
                                                             once and carries a count, which is worth
                                                             reading whether or not anyone is about to
                                                             press it. -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,5,0,1"
                                                                    Spacing="4"
                                                                    IsVisible="{Binding CanCopyAllFindings}">
                                                            <Button Classes="list-copy"
                                                                    v:CopyButton.Text="{Binding Findings, Converter={x:Static v:CopyableText.Instance}}"
                                                                    ToolTip.Tip="Copy every finding here, without the verdict line">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <mi:MaterialIcon Kind="ContentCopy" Width="11" Height="11" />
                                                                    <TextBlock Text="{Binding Findings.Count, StringFormat='Copy all ({0})'}" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="list-copy"
                                                                    v:CopyButton.Text="{Binding Problems, Converter={x:Static v:CopyableText.Instance}}"
                                                                    IsVisible="{Binding CanCopyProblems}"
                                                                    ToolTip.Tip="Copy the blockers, errors and warnings, leaving the suggestions out">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <mi:MaterialIcon Kind="ContentCopy" Width="11" Height="11" />
                                                                    <TextBlock Text="{Binding ProblemCount, StringFormat='Copy problems ({0})'}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Findings}"
                                                                      ItemTemplate="{StaticResource FindingTemplate}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Findings>
                                            <!-- ======== A round of questions, after it was answered ========
                                                 The same argument the findings make, one panel over. A
                                                 round used to be recorded as the numbered paragraph it
                                                 flattens to, several screens above the controls it had
                                                 been answered in — two shapes for one thing, and the
                                                 record was the worse of them. The text is still the
                                                 whole round, so the copy button and a goal file written
                                                 before this hand over everything; what is drawn is the
                                                 questions.

                                                 Head-less on purpose: the row's own text would be the
                                                 same round a second time, in the shape this replaced. -->
                                            <v:GoalMessageTemplate.Questions>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <ItemsControl ItemsSource="{Binding Questions}"
                                                                  ItemTemplate="{StaticResource AskedQuestionTemplate}" />
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Questions>
                                            <v:GoalMessageTemplate.Plain>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <SelectableTextBlock Classes="msg"
                                                                         Classes.msg-system="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.System}}"
                                                                         Classes.msg-summary="{Binding IsRunSummary}"
                                                                         Text="{Binding Text}" />
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Plain>
                                        </v:GoalMessageTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </DockPanel>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ======== Waiting for the tool ========
                 A row in the conversation, in the same shape as the message it is standing in for: the
                 gutter marker where the marker goes, the dots where the text will be. What you are
                 waiting for *is* a message, so a placeholder message is what says so.

                 It used to be a pill floating over the transcript, pinned to the bottom-left of the
                 scroll area. Two things were wrong with that and only one of them was cosmetic: it
                 overlapped whatever was underneath — at the foot of a full transcript, the composer the
                 user was typing into — and it said a second time what the status strip at the top of
                 the tile already says, with the phase and the attempt number, in a bar that cannot be
                 scrolled away from. In the flow it can collide with nothing, it lands exactly where the
                 next message will, and the follow-to-the-bottom rule carries it for free. -->
            <v:WaitingRow IsVisible="{Binding IsRunning}"
                          Stage="{Binding RunStage}"
                          Elapsed="{Binding RunClock.Text}" />

            <!-- ======== The ask: questions ========
                 The last block in the conversation while a round is being answered, and the only one
                 there: the composer stands down, because two boxes asking for the same thing with
                 different filing rules is how an answer ends up against the wrong question.

                 No cap, no splitter and no minimum. It had all three when it was a pane of its own
                 fighting the transcript for the tile's height — three fifths at most, a default of 230,
                 a stored height read back on every pass, and a ratchet so a clamp could not be mistaken
                 for something the user had dragged. None of that has anything left to arbitrate: the
                 round is as tall as it is, inside the same scroller as everything else, and what was
                 above it is a scroll away rather than squeezed. -->
            <Border Classes="ask" IsVisible="{Binding ShowQuestions}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Classes="ask-rail" />
                    <StackPanel Margin="10,6,10,8">
                        <TextBlock Classes="ask-title"
                                   Margin="0,0,0,6"
                                   Text="{Binding QuestionsTitle}" />

                        <ItemsControl x:Name="QuestionList" ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GoalQuestionAnswer">
                                    <Grid Classes="asking" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Classes="ask-marker" Text="{Binding Marker}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="ask-question" Text="{Binding Question}" />
                                            <TextBlock Classes="ask-why"
                                                       IsVisible="{Binding HasWhy}"
                                                       Text="{Binding Why}" />

                                            <!-- One offered answer per row, each the full width of the
                                                 panel.

                                                 Two shapes were tried first and both cut the text off
                                                 mid-word: a WrapPanel measures its children with
                                                 unlimited width, so a chip carrying a sentence is never
                                                 asked to wrap, and a chip sized to its own content is
                                                 not asked either — it is simply clipped when it does not
                                                 fit. A row that fills the width has a width to wrap at,
                                                 which is the only version of this that cannot lose a
                                                 word. A short answer in a wide row is a little empty
                                                 space; a long one in a narrow chip was unreadable. -->
                                            <ItemsControl ItemsSource="{Binding Options}"
                                                          IsVisible="{Binding HasOptions}"
                                                          Margin="0,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:GoalOption">
                                                        <Button Classes="ask-option"
                                                                HorizontalAlignment="Stretch"
                                                                Margin="0,0,0,5"
                                                                Command="{Binding Use}"
                                                                ToolTip.Tip="Put this in the answer below">
                                                            <TextBlock Text="{Binding Text}"
                                                                       TextWrapping="Wrap" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Enter sends, as it does in the composer. The box refuses
                                                 line breaks, so without this Enter was the one key that
                                                 did nothing at all in a panel you answer by typing. -->
                                            <!-- The mentions belong to the tile, not to the question,
                                                 so they are reached the way the findings button
                                                 reaches its command: out of the template to the view
                                                 that owns it. -->
                                            <TextBox Classes="ask-field"
                                                     Text="{Binding Answer}"
                                                     PlaceholderText="Your answer&#x2026;"
                                                     AcceptsReturn="False"
                                                     TextWrapping="Wrap"
                                                     v:FileMentionBehavior.Mentions="{Binding $parent[UserControl].((vm:GoalTileViewModel)DataContext).FileMentions}"
                                                     KeyDown="AnswerBox_KeyDown" />
                                        </StackPanel>

                                        <!-- Copyable while it is still being answered, not only
                                             afterwards. A question is a thing you take next door to
                                             look something up with, and the moment you want to do that
                                             is the moment you cannot answer it. -->
                                        <Button Grid.Column="2"
                                                Classes="item-copy"
                                                v:CopyButton.Text="{Binding Converter={x:Static v:CopyableText.Instance}}"
                                                ToolTip.Tip="Copy this question">
                                            <mi:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- No top margin: the question above it brings its own. -->
                        <Button HorizontalAlignment="Right"
                                Classes="chat-action primary"
                                Command="{Binding SendAnswersCommand}"
                                Content="Send answers"
                                ToolTip.Tip="Send what you have written. A question left blank is skipped." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======== The ask: the plan ========
                 One box and one button, and the button follows the box: empty means approve, anything
                 typed means send that instead. Two buttons would have made "Approve" the thing that
                 happens to whatever the user had just written. -->
            <Border Classes="ask" IsVisible="{Binding ShowApproval}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Classes="ask-rail" />
                    <StackPanel Margin="10,6,10,8">
                        <!-- Enter sends, as it does in the composer and in an answer box. It takes line
                             breaks too, so Shift+Enter is the one that adds one. -->
                        <TextBox x:Name="PlanBox"
                                 Classes="ask-field"
                                 Margin="0"
                                 Text="{Binding InputText}"
                                 PlaceholderText="Approve the plan, or describe what to change&#x2026;"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="120"
                                 v:FileMentionBehavior.Mentions="{Binding FileMentions}" />

                        <Button HorizontalAlignment="Right"
                                Margin="0,6,0,0"
                                Classes="chat-action primary"
                                Command="{Binding ApproveOrChangeCommand}"
                                Content="{Binding ApprovalActionLabel}"
                                ToolTip.Tip="An empty box approves the plan as it stands" />
                    </StackPanel>
                </DockPanel>
            </Border>



            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <v:FileDropHint x:Name="DropHint" Text="Drop to attach"
                    FontSize="{DynamicResource TermFontMd}" />
    </Panel>
</UserControl>
