<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:m="using:mTiles.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:v="using:mTiles.Views"
             x:Class="mTiles.Views.GoalTileView"
             x:DataType="vm:GoalTileViewModel">

    <!--
        The Goal tile is a transcript, not a chat app, so it is drawn as one: the terminal's own
        monospace face at the terminal's own size, the app's colour tokens (which ThemeBridge derives
        from the active terminal theme), and a fixed gutter column whose glyph says who spoke — an
        angle bracket you, a dot the tool, a corner a note from the tile itself. No bubbles: they
        aligned every message differently and made a two-line answer look like a different kind of
        thing from a twenty-line one.

        The one saturated colour in here is the phase dot in the status strip. Everything else is
        text, muted chrome and one hairline per edge.
    -->
    <UserControl.Styles>
        <!-- ======== Transcript rows ========
             Read as turns, not as lines. Everything here is one decision: a message is a block with air
             around it, and what separates two of them is space rather than a rule. Rules would be
             cheaper and would turn a conversation into a table.

             The one line that is drawn is above a message of yours, because that is where a turn
             begins — the tool's answer belongs to the question above it, and the eye needs to know
             where to go back to. -->
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- What you typed keeps the raised band it has in a terminal: it is the thing you scroll back
             to look for, and it is still the only row with a background. Inset and rounded now, so it
             reads as a block somebody wrote rather than a stripe across the tile, and with the hairline
             above it that says a new turn starts here. -->
        <Style Selector="Border.row-user">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Margin" Value="4,10,4,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderTop}" />
        </Style>

        <!-- ======== Copy ========
             One per message, at the top right rather than under the text: it costs no vertical space in
             a transcript where every line is read, and the first line of a message is where the eye
             already is.

             Hidden until the pointer is over the message. A button under every turn, always lit, is
             three pieces of chrome per exchange in a panel whose whole argument is that the
             conversation stays readable — and this is a convenience, not a thing anybody comes here to
             do. It fades rather than appearing, so a pointer crossing the transcript on its way
             somewhere else does not make the tile flicker. -->
        <Style Selector="Button.msg-copy">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.row:pointerover Button.msg-copy">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.msg-copy:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
        </Style>

        <!-- A note from the tile itself: quieter, and closer to whatever it is a note about — it is a
             footnote to the message above, not a turn of its own. -->
        <Style Selector="Border.row-system">
            <Setter Property="Padding" Value="10,1,10,4" />
        </Style>

        <Style Selector="TextBlock.gutter">
            <Setter Property="Width" Value="16" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="TextBlock.gutter.gutter-user">
            <Setter Property="Text" Value="&#x276F;" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.gutter.gutter-assistant">
            <Setter Property="Text" Value="&#x25CF;" />
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
        </Style>
        <!-- The glyph takes the size of the text it sits beside, which for a system note is the
             smaller one. At the shared size it was visibly larger than the sentence it introduced. -->
        <Style Selector="TextBlock.gutter.gutter-system">
            <Setter Property="Text" Value="&#x2514;" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
        </Style>

        <!-- The line spacing is the whole of why this reads better. A wall of monospace set solid is
             the hardest thing on this screen to scan, and two pixels a line is the difference between a
             log and something written to be read. -->
        <Style Selector="SelectableTextBlock.msg">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineSpacing" Value="2" />
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentDefault}" />
        </Style>
        <Style Selector="SelectableTextBlock.msg.msg-system">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
        </Style>

        <!-- ======== Status strip ======== -->
        <Style Selector="TextBlock.strip">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The phase's colour comes from the ANSI palette (ThemeBridge), so it stays legible on
             whatever background the terminal theme paints. Set as a class rather than as a brush
             resolved in code-behind, so changing theme repaints it without rebuilding the view. -->
        <!-- Dimmer than the phase beside it, and it never grows the strip: a tool call is transient and
             must not be able to push what the tile is doing off the end of the line. -->
        <Style Selector="TextBlock.strip-activity">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="MaxWidth" Value="220" />
        </Style>

        <Style Selector="Ellipse.phase-goal">
            <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Ellipse.phase-clarify">
            <Setter Property="Fill" Value="{DynamicResource GoalPhaseClarify}" />
        </Style>
        <Style Selector="Ellipse.phase-plan">
            <Setter Property="Fill" Value="{DynamicResource GoalPhasePlan}" />
        </Style>
        <Style Selector="Ellipse.phase-implement">
            <Setter Property="Fill" Value="{DynamicResource GoalPhaseImplement}" />
        </Style>
        <Style Selector="Ellipse.phase-review">
            <Setter Property="Fill" Value="{DynamicResource GoalPhaseReview}" />
        </Style>
        <Style Selector="Ellipse.phase-summary">
            <Setter Property="Fill" Value="{DynamicResource GoalPhaseSummary}" />
        </Style>


        <!-- ======== Finding badges ========
             What the last review counted, in the one place in this tile that already carries colour.
             Three glyphs wide and no wider: the numbers belong beside the phase, and the findings
             themselves are in the transcript, where they can be read. -->
        <Style Selector="TextBlock.badge">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- Blockers and errors share the red: both mean "must fix", and the letter is what tells them
             apart. There is one danger token, and inventing a second red for a six-pixel label would
             leave two shades nobody could rank at a glance. The blocker is bold instead. -->
        <Style Selector="TextBlock.badge.badge-blocker">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.badge.badge-error">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="TextBlock.badge.badge-warning">
            <Setter Property="Foreground" Value="{DynamicResource GoalPhasePlan}" />
        </Style>
        <Style Selector="TextBlock.badge.badge-suggestion">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>

        <!-- ======== Completion criteria ========
             Drawn as a config file rather than as a settings form, because that is what it is and
             because this tile is a terminal: a key on the left, a value on the right, one per line, in
             the terminal face at the terminal size. A grid of paired labels and spinners would be the
             only part of this tile that looked like a dialog. -->
        <Style Selector="Border.criteria">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderBottom}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.crit-label">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector="TextBlock.crit-title">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox.crit-field">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox.crit-check">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- ======== SOLID, as five letters ========
             Five checkboxes with five long names would be a third of this panel for a setting most
             users will never touch. The acronym is already the interface: the letters in order spell
             what the row is, each one carries its full name in a tooltip, and lit means "held to it".

             Lit is the default and unlit is the deliberate act, which is why the off state is drawn as
             the quiet one — a letter switched off should read as absent from the word, not as a control
             waiting to be filled in. -->
        <Style Selector="ToggleButton.crit-solid">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <!-- The template targets are what actually paint: Fluent's ToggleButton keeps its own
             background and border in the ContentPresenter, so setting them on the control alone leaves
             the checked state looking exactly like the unchecked one.

             Four rules rather than three, and the reason is that hovering must not answer the question
             the chip exists to answer. Written as one `:pointerover`, the pointer lit the letter up —
             elevated fill, bright text — so an *off* chip under the cursor looked exactly like an on
             one, at the only moment anybody is looking closely at it: while deciding whether to click.
             Hover is therefore a border, and only a border; the fill and the letter stay with the
             state. Both hovered cases are spelled out because a rule that sets only the border leaves
             Fluent's own hover fill showing through underneath, which is the same lie by another
             route. -->
        <Style Selector="ToggleButton.crit-solid:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.crit-solid:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="ToggleButton.crit-solid:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextHover}" />
        </Style>

        <!-- ======== A button with a word on it ========
             The app-wide `outlined-sm`, restated here in the terminal face. Everything with text in
             this tile is monospaced, and a UI-font button in the middle of it is the one element that
             announces it came from somewhere else. -->
        <Style Selector="Button.goal-action">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.goal-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
        </Style>
        <Style Selector="Button.goal-action:pressed">
            <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
        </Style>
        <Style Selector="Button.goal-action.primary">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>


        <!-- ======== The ask ========
             When the tile needs something from you it says so in one place, and that place replaces
             the composer rather than sitting above it: two boxes asking for the same thing with
             different filing rules is how an answer ends up against the wrong question.

             It is marked by a two-pixel accent rail down its left edge — the same idiom the app uses
             for the active tile, and the only saturated colour in this tile besides the phase dot. No
             card, no shadow, no second background: the panel is part of the transcript's surface and
             the rail is what says it is waiting on you. -->
        <Style Selector="Border.ask">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderTop}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.ask-rail">
            <Setter Property="Width" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentDefault}" />
        </Style>
        <Style Selector="TextBlock.ask-title">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>

        <!-- The number lives in its own column, so a question that wraps keeps its indent instead of
             returning to column zero under its own marker. That is the whole reason these are controls
             and not a paragraph: it is unreadable at three questions and this is why. -->
        <Style Selector="TextBlock.ask-marker">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>
        <Style Selector="TextBlock.ask-question">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The reason under a question, at the question's own size: it is a sentence about the same
             thing, and setting it smaller made one thought look like two kinds of text. The colour is
             the whole of the difference, and it is enough. -->
        <Style Selector="TextBlock.ask-why">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- An offered answer.
             Quieter than the question and louder than a caption. It began at the caption end of that
             range — small type, muted — on the reasoning that a suggestion drawn like an action reads
             as the choice you are meant to make. That reasoning holds for a chip saying "yes" and fails
             for one saying a whole sentence, which is what a tool produces whenever the decision is
             about behaviour: three lines of small grey text carrying the actual content of the
             question, under a question set in full size. These are answers. They are set like answers,
             and the border and the transparent ground are what keep them from reading as the default. -->
        <Style Selector="Button.ask-option">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ask-option:pointerover">
            <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>

        <Style Selector="TextBox.ask-field">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <!-- ======== Composer ======== -->
        <!-- The prompt glyph belongs inside the field, as it does in a shell, so the border is drawn
             by the surrounding Border and the TextBox gives up its own. -->
        <Style Selector="TextBox.goal-input /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.goal-input">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MaxHeight" Value="140" />
        </Style>
        <Style Selector="Border.composer">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.composer:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style Selector="Border.composer.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
        </Style>

        <!-- ======== A review finding ========
             The transcript is a terminal and a review was a column of monospace: severity, place,
             title, detail, all in one grey. It scans up to a point, and the point is colour - the
             blocker and the suggestion looked identical three lines apart, so the line worth reading
             first was the one the eye had to search for. Each finding is now a card with a coloured
             edge, which says how much it matters before a word of it is read. The colours are the
             badges own: one danger token for blockers and errors, the plan colour for warnings, and
             faint for suggestions, so the strip at the top and the list below agree. -->
        <Style Selector="Border.finding">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,5,8,6" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="Border.finding.f-blocker">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="Border.finding.f-error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="Border.finding.f-warning">
            <Setter Property="BorderBrush" Value="{DynamicResource GoalPhasePlan}" />
        </Style>
        <Style Selector="Border.finding.f-suggestion">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
        </Style>

        <!-- The severity is the label, so it carries the colour and the weight; the place beside it is
             faint, because it says where to look rather than what is wrong. -->
        <Style Selector="TextBlock.f-sev">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="TextBlock.f-sev.f-blocker">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.f-sev.f-error">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>
        <Style Selector="TextBlock.f-sev.f-warning">
            <Setter Property="Foreground" Value="{DynamicResource GoalPhasePlan}" />
        </Style>
        <Style Selector="TextBlock.f-sev.f-suggestion">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="TextBlock.f-where">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- The title reads at the transcript own size and in its own colour: it is the sentence the
             finding is. The detail is the argument for it, one step quieter. -->
        <Style Selector="SelectableTextBlock.f-title">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentDefault}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style Selector="SelectableTextBlock.f-detail">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineSpacing" Value="2" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentDefault}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- ======== While the tool is working ========
             The strip already says which phase and which file, in words, at the top of the tile. What
             it cannot say is that anything is happening at all: a tool that spends four minutes
             reading before it writes leaves a transcript that has not changed and a phase label that
             has not moved. Three dots at the foot of the conversation, where the next message will
             appear, and nothing else - a progress bar would be a claim about how far along it is,
             which nothing here knows. -->
        <Style Selector="Ellipse.think">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource AccentDefault}" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <!-- The dots say something is happening; these two say what and for how long, which are the
             only honest things left to say about a tool nothing has been heard from - nothing here
             knows how far along it is.

             Beside the dots rather than on the status strip: the strip carries the phase as a sentence
             and the file the tool is in, which are facts about the run as a whole, while this belongs
             to the wait being drawn and is read without leaving the conversation.

             Muted, small, and in the transcript's own monospace so it reads as a note attached to the
             dots rather than as a message. Monospace also stops the row twitching: the clock's digits
             change every second, and in a proportional face "1:11" and "1:00" are different widths, so
             the dots would shuffle sideways once a second beside a label added to reassure. -->
        <Style Selector="TextBlock.waiting-note">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <!-- One animation per dot rather than one with three delays: two animations selecting the same
             element take turns setting the same property, and the dots stop agreeing about where they
             are in the cycle. The delay is what makes it read as a wave rather than a blink. -->
        <Style Selector="Ellipse.think.d1">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.think.d2">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.think.d3">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="30%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="ComboBox.goal-tool">
            <Setter Property="FontFamily" Value="{DynamicResource TerminalFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource BgBase}">

        <!-- ======== Status strip: which tool, which phase, and the three things you can do ======== -->
        <Border DockPanel.Dock="Top"
                Padding="6,3"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="{DynamicResource BorderBottom}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                    <Button Classes="tile-btn"
                            Command="{Binding ToggleCriteriaCommand}"
                            ToolTip.Tip="When is this goal done?">
                        <mi:MaterialIcon Kind="Tune" Width="13" Height="13" />
                    </Button>
                    <Button Classes="tile-btn"
                            Command="{Binding PauseCommand}"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="Pause">
                        <mi:MaterialIcon Kind="Pause" Width="13" Height="13" />
                    </Button>
                    <!-- Visible as soon as the run is paused, but not usable until it has actually
                         stopped: cancelling takes as long as the tool takes to die, and a click in
                         that window used to start a second loop alongside the one still unwinding. -->
                    <Button Classes="tile-btn"
                            Command="{Binding ResumeCommand}"
                            IsVisible="{Binding IsPaused}"
                            IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="Resume">
                        <mi:MaterialIcon Kind="Play" Width="13" Height="13"
                                         Foreground="{DynamicResource AccentHover}" />
                    </Button>
                    <Button Classes="tile-btn"
                            Command="{Binding NewGoalCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="New goal">
                        <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
                    </Button>
                </StackPanel>

                <!-- A DockPanel rather than a horizontal StackPanel: the label is the one part that
                     has to give way, and a StackPanel measures its children with infinite width, so
                     TextTrimming there is inert and a long phase is cut off mid-letter instead. -->
                <DockPanel>
                    <ComboBox DockPanel.Dock="Left"
                              Classes="goal-tool"
                              ItemsSource="{Binding AvailableTools}"
                              SelectedItem="{Binding SelectedToolName}"
                              ToolTip.Tip="AI tool" />
                    <!-- Beside the tool because it is a fact about the tool, and because this is where
                         somebody looks after a run that was refused. The default is auto: without a
                         mode the tool inherits the user's own Claude Code settings, and the factory
                         default there is to ask — which a headless run cannot do, so every edit was
                         refused and the tile reported that nothing had changed. -->
                    <ComboBox DockPanel.Dock="Left"
                              Classes="goal-tool"
                              ItemsSource="{Binding AvailablePermissionModes}"
                              SelectedItem="{Binding PermissionModeLabel}"
                              ToolTip.Tip="What the AI tool may do without asking. auto gets on with the work and still stops at what it considers dangerous; accept edits waves through file changes only; bypass asks about nothing at all; tool default passes no flag and leaves it to the tool's own settings." />
                    <TextBlock DockPanel.Dock="Left" Classes="strip" Text="&#xB7;" Margin="6,0" />
                    <Ellipse DockPanel.Dock="Left"
                             x:Name="PhaseDot" Width="6" Height="6"
                             VerticalAlignment="Center" />
                    <!-- One template, four styles. Every severity used to need a view-model
                         property, a TextBlock, a visibility converter and a style, and each of the four
                         could be forgotten on its own. -->
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GoalBadge">
                                <TextBlock Classes="badge"
                                           Classes.badge-blocker="{Binding IsBlocker}"
                                           Classes.badge-error="{Binding IsError}"
                                           Classes.badge-warning="{Binding IsWarning}"
                                           Classes.badge-suggestion="{Binding IsSuggestion}"
                                           Text="{Binding Text}"
                                           ToolTip.Tip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The phase is pinned to the right edge and the activity flows in front of it,
                         because a DockPanel trims its *last* child — the one that fills. With the two the
                         other way round the phase was what gave way, which is backwards: the phase says
                         what the tile is doing and the activity is about this second. Docking the phase
                         puts the reading that has to survive out of the way of the one that does not. -->
                    <TextBlock DockPanel.Dock="Right"
                               Classes="strip"
                               Text="{Binding PhaseLabel}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding PhaseLabel}"
                               Margin="6,0,8,0" />
                    <TextBlock Classes="strip strip-activity"
                               Text="{Binding Activity}"
                               IsVisible="{Binding Activity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Activity}"
                               Margin="6,0,0,0" />
                </DockPanel>
            </DockPanel>
        </Border>


        <!-- ======== When is this goal done? ========
             Everything here used to be a constant: five attempts, and the presence of the characters
             "VERDICT: PASS" anywhere in the review. -->
        <Border DockPanel.Dock="Top" Classes="criteria" IsVisible="{Binding ShowCriteria}">
            <StackPanel>
                <TextBlock Classes="crit-title" Text="done when" />

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="crit-label" Text="attempts" Margin="0,6,10,0" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <!-- LostFocus puts the fields back to what the tile actually holds. Avalonia
                             reports a failed string-to-int conversion as a binding error, not as data
                             validation, so the :error pseudo-class never fires and a style built on it
                             would be decoration that cannot light up. What can be done is make the junk
                             disappear when the field does, which is the behaviour anyone expects. -->
                        <TextBox Classes="crit-field"
                                 Text="{Binding Criteria.MaxIterations}"
                                 MinWidth="56"
                                 LostFocus="NumberBox_LostFocus"
                                 ToolTip.Tip="Implement/review laps before the run gives up (1-50)" />
                        <!-- Shown only when the run will not use what is in the box; see ShowClampNotes. -->
                        <TextBlock Classes="crit-label"
                                   Text="{Binding Criteria.AttemptsNote}"
                                   Foreground="{DynamicResource DangerText}"
                                   IsVisible="{Binding Criteria.AttemptsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="crit-label" Text="tolerated" Margin="0,6,10,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBox Classes="crit-field" Text="{Binding Criteria.MaxErrors}" MinWidth="42"
                                 LostFocus="NumberBox_LostFocus"
                                 ToolTip.Tip="Errors allowed to remain. Blockers never are." />
                        <TextBlock Classes="crit-label" Text="errors" />
                        <TextBox Classes="crit-field" Text="{Binding Criteria.MaxWarnings}" MinWidth="42"
                                 LostFocus="NumberBox_LostFocus"
                                 ToolTip.Tip="Warnings allowed to remain" />
                        <TextBlock Classes="crit-label" Text="warnings" Margin="0" />
                        <TextBlock Classes="crit-label"
                                   Text="{Binding Criteria.TolerancesNote}"
                                   Foreground="{DynamicResource DangerText}"
                                   Margin="0"
                                   IsVisible="{Binding Criteria.TolerancesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Which SOLID principles this goal's work is held to. On the criteria panel and
                         not in Settings because it belongs to the goal: the same person wants all five
                         in a library they will maintain for years and none of them in a one-page
                         script. And it is a completion criterion in the only sense that matters — a
                         violation comes back as a warning, against the tolerance two rows up. -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="crit-label" Text="principles" Margin="0,6,10,0" />
                    <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                  ItemsSource="{Binding Criteria.Solid}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:GoalSolidToggle">
                                <!-- The name is on the chip as well as in the tooltip. The content is
                                     one character and a tooltip is a pointer gesture, so to anything
                                     reading this aloud the row was five buttons called S, O, L, I and
                                     D — the letters only spell something to somebody who already knows
                                     what they stand for, which is the one reader that does not need
                                     them read out. -->
                                <ToggleButton Classes="crit-solid"
                                              Content="{Binding Letter}"
                                              IsChecked="{Binding IsOn}"
                                              AutomationProperties.Name="{Binding Name}"
                                              ToolTip.Tip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.RequireGoalMet}"
                          Content="the review says the goal is met"
                          ToolTip.Tip="Separate from the counts: clean code that does the wrong thing has no findings" />
                <!-- The two health checks. They are sentences added to the prompts, not commands this
                     tile runs, so what they buy is the tool checking its own work with this project's
                     own build and test commands — which it can work out and the panel could not.

                     What they replace was a verify command: a shell line proposed by the clarification
                     round, approved by the user and run by the tile, with its exit code gating
                     completion. That only ever worked in a repository which was already green, and a
                     project whose suite has failures nobody has got to yet is the ordinary case — so
                     the gate spent every attempt of every goal on failures the work had not caused and
                     then reported the goal as not reached.

                     Tests are their own switch rather than part of "builds" for exactly that reason:
                     a red suite is a thing a user may reasonably want left alone while still asking
                     for code that compiles. -->
                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.RequireBuild}"
                          Content="the project still builds"
                          ToolTip.Tip="The tool is told to check this itself with this project's own build command, and to fix what it broke." />
                <CheckBox Classes="crit-check" IsChecked="{Binding Criteria.RequireTestsPass}"
                          Content="the tests still pass"
                          ToolTip.Tip="The tool is told to run this project's own tests. Failures that were already there are reported, not fixed — turn this off in a repository whose suite is red on purpose." />
                <!-- The two mechanical stops used to be checkboxes here and are neither settings nor
                     switches any more: both are always on. A switch is worth a line of this panel where
                     two users would reasonably choose differently, and nobody reasonably chooses to
                     spend attempts on a tool that just wrote nothing, or on a review that has said the
                     same thing twice. What replaced them is the summary naming which of the two ended
                     the run — see GoalCompletionPolicy.Summarise. -->
            </StackPanel>
        </Border>


        <!-- ======== The ask: the plan ========
             One box and one button, and the button follows the box: empty means approve, anything
             typed means send that instead. Two buttons would have made "Approve" the thing that
             happens to whatever the user had just written. -->
        <Border DockPanel.Dock="Bottom" Classes="ask" IsVisible="{Binding ShowApproval}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Classes="ask-rail" />
                <StackPanel Margin="10,6,10,8">
                    <!-- Enter sends, as it does in the composer and in an answer box. It takes line
                         breaks too, so Shift+Enter is the one that adds one. -->
                    <TextBox x:Name="PlanBox"
                             Classes="ask-field"
                             Margin="0"
                             Text="{Binding InputText}"
                             PlaceholderText="Approve the plan, or describe what to change&#x2026;"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             KeyDown="PlanBox_KeyDown" />

                    <Button HorizontalAlignment="Right"
                            Margin="0,6,0,0"
                            Classes="goal-action primary"
                            Command="{Binding ApproveOrChangeCommand}"
                            Content="{Binding ApprovalActionLabel}"
                            ToolTip.Tip="An empty box approves the plan as it stands" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======== Composer ========
             Only when there is something it can send: not while the tool is working, and not while one
             of the panels above is asking for the same thing in a better shape. -->
        <Border DockPanel.Dock="Bottom"
                Padding="6,5"
                Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="{DynamicResource BorderTop}"
                IsVisible="{Binding ShowComposer}">
            <!-- No second "the tool is busy" line here. The status strip already carries it, with the
                 phase and the iteration number in it, so a line saying only that something is happening
                 was the same news told worse. -->
            <Border x:Name="Composer" Classes="composer"
                    PointerPressed="Composer_PointerPressed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Classes="gutter gutter-user"
                               Margin="0,2,0,0" />
                    <Button DockPanel.Dock="Right"
                            Classes="tile-btn"
                            VerticalAlignment="Bottom"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="Send (Enter)">
                        <mi:MaterialIcon Kind="Send" Width="13" Height="13" />
                    </Button>
                    <TextBox x:Name="InputBox"
                             Classes="goal-input"
                             Text="{Binding InputText}"
                             PlaceholderText="Describe the goal, or answer&#x2026;"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             GotFocus="InputBox_FocusChanged"
                             LostFocus="InputBox_FocusChanged"
                             KeyDown="InputBox_KeyDown" />
                </DockPanel>
            </Border>
        </Border>


        <!-- ======== The other way in ========
             Docked after the composer so it sits directly above it, where the composer's own placeholder
             is the alternative being offered: type a goal, or have one read out of what you have already
             changed. Only shown where a goal is what is wanted next and only when git says there is
             something uncommitted to read — see CanDetectGoal. -->
        <Border DockPanel.Dock="Bottom"
                Padding="6,4,6,0"
                Background="{DynamicResource BgSurface}"
                IsVisible="{Binding CanDetectGoal}">
            <!-- No sentence saying there are uncommitted changes: the bar is shown only when there are,
                 so it was a line spent restating why it was on screen. The tooltips say what the two
                 buttons read from. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Classes="goal-action"
                        Command="{Binding DetectGoalCommand}"
                        Content="Detect goal"
                        ToolTip.Tip="Read the uncommitted changes and put the goal in the box to edit" />
                <Button Classes="goal-action primary"
                        Command="{Binding DetectGoalAndRunCommand}"
                        Content="Detect &amp; run"
                        ToolTip.Tip="Read the goal and start reviewing and fixing straight away" />
            </StackPanel>
        </Border>

        <!-- ======== More attempts for a run that ran out ========
             Above the detect bar, and only after the attempts ran out — see CanContinue. It is the one
             stop a button can do anything about; the other three have already established that another
             attempt would change nothing. The label carries the number so the button says what it does. -->
        <Border DockPanel.Dock="Bottom"
                Padding="6,4,6,0"
                Background="{DynamicResource BgSurface}"
                IsVisible="{Binding CanContinue}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Classes="gutter gutter-system" Margin="0,3,0,0" />
                <Button DockPanel.Dock="Right"
                        Classes="goal-action primary"
                        Command="{Binding ContinueRunCommand}"
                        Content="{Binding ContinueLabel}"
                        ToolTip.Tip="Give this goal that many more attempts and carry on, keeping the conversation" />
                <!-- Literal, not a binding. The bar is shown only when CanContinue, and Continue is
                     offered for one stop — BudgetSpent — so this sentence cannot say anything else.
                     It was a property while a timed-out verify command was the second continuable
                     stop; bound to a constant it only suggested a variation that no longer exists,
                     and the notification that went with it could never fire. -->
                <TextBlock Classes="strip"
                           Text="The attempts ran out."
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ======== Transcript, and the questions under it ========
             One grid rather than another docked bar, because the divider between them is draggable: at
             three questions with reasons and offered answers the panel is most of a small tile, and how
             much of it to give up for the conversation is a judgement only the person reading can make.
             The splitter and the panel share one visibility, so nothing is left to grab at when there is
             nothing being asked — and the row is collapsed with them, or an empty band would sit under
             the transcript holding the height of the last question that was asked (GoalTileView.axaml.cs).
        -->
        <Grid x:Name="AskGrid" RowDefinitions="*,Auto,Auto" SizeChanged="AskGrid_SizeChanged">
        <ScrollViewer x:Name="ChatScroll"
                      Grid.Row="0"
                      MinHeight="48"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,4">
            <ItemsControl x:Name="Transcript" ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:GoalMessage">
                        <Border Classes="row"
                                Classes.row-user="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.User}}"
                                Classes.row-system="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.System}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Classes="gutter"
                                           Classes.gutter-user="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.User}}"
                                           Classes.gutter-assistant="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.Assistant}}"
                                           Classes.gutter-system="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.System}}" />
                                <Button DockPanel.Dock="Right"
                                        Classes="msg-copy"
                                        Click="CopyMessage_Click"
                                        ToolTip.Tip="Copy this message">
                                    <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                                </Button>

<!-- ======== The message ========
                                     One fill child, and that is load-bearing: a DockPanel gives its
                                     *last* child the remaining space and docks every other to the left.
                                     With the two text controls as siblings the markdown view was never
                                     the last one, so it was laid out at the width of its own content
                                     instead of the width of the row — every rendered answer narrower
                                     than the message beside it, for no reason a reader could see.

                                     Which of the two is shown is the message's own answer (IsMarkdown).
                                     The tool's prose is markdown — agents write headings, bold and fenced
                                     code whether or not anything reads them, and raw those markers are
                                     noise in every answer. What this application composed is not: a
                                     review is a column of severities with the detail indented under
                                     each, and markdown collapses runs of spaces, reads a two-space
                                     indent as a continuation, and turns a `*` inside a finding into
                                     emphasis. Nor is your own text, where an asterisk is one you typed.

                                     No external ScrollViewer around the viewer *by height*: it scrolls
                                     itself when given a finite height and sizes to its content when it
                                     is not. Inside the transcript's scroller the height is
                                     unconstrained, so it lays out as a block and the transcript does the
                                     scrolling, which is what a message in a list has to do. -->
                                <ContentControl Content="{Binding}">
                                    <ContentControl.ContentTemplate>
                                        <v:GoalMessageTemplate>
                                            <v:GoalMessageTemplate.Markdown>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <v:GoalMarkdownView MarkdownText="{Binding Text}" />
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Markdown>
                                            <!-- ======== A review, drawn rather than printed ========
                                                 The head stays text - a verdict and its counts read as
                                                 a sentence. The findings are rows, because a severity
                                                 is a thing to see and not a word to read: the coloured
                                                 edge answers "how much does this matter" before the
                                                 title is reached. A message from a goal file written
                                                 before findings were kept has none and falls through
                                                 to Plain, where it is drawn exactly as it was. -->
                                            <v:GoalMessageTemplate.Findings>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <StackPanel>
                                                        <SelectableTextBlock Classes="msg" Text="{Binding Text}" />
                                                        <ItemsControl ItemsSource="{Binding Findings}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="m:GoalFinding">
                                                                    <Border Classes="finding"
                                                                            Classes.f-blocker="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Blocker}}"
                                                                            Classes.f-error="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Error}}"
                                                                            Classes.f-warning="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Warning}}"
                                                                            Classes.f-suggestion="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Suggestion}}">
                                                                        <StackPanel>
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Left"
                                                                                           Classes="f-sev"
                                                                                           Classes.f-blocker="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Blocker}}"
                                                                                           Classes.f-error="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Error}}"
                                                                                           Classes.f-warning="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Warning}}"
                                                                                           Classes.f-suggestion="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalSeverity.Suggestion}}"
                                                                                           Text="{Binding Severity}" />
                                                                                <!-- One line, three optional parts. Every one of
                                                                                     them is a thing the tool may not have said,
                                                                                     and an empty bracket or a bare colon is worse
                                                                                     than nothing there. -->
                                                                                <TextBlock Classes="f-where"
                                                                                           Text="{Binding File}"
                                                                                           IsVisible="{Binding File, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                <TextBlock Classes="f-where"
                                                                                           Text="{Binding Line, StringFormat=':{0}'}"
                                                                                           IsVisible="{Binding Line, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                                <TextBlock Classes="f-where"
                                                                                           Margin="6,0,0,0"
                                                                                           Text="{Binding Category, StringFormat='[{0}]'}"
                                                                                           IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                <Panel />
                                                                            </DockPanel>
                                                                            <SelectableTextBlock Classes="f-title" Text="{Binding Title}" />
                                                                            <SelectableTextBlock Classes="f-detail"
                                                                                                 Text="{Binding Detail}"
                                                                                                 IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Findings>
                                            <v:GoalMessageTemplate.Plain>
                                                <DataTemplate DataType="m:GoalMessage">
                                                    <SelectableTextBlock Classes="msg"
                                                                         Classes.msg-system="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:GoalMessageRole.System}}"
                                                                         Text="{Binding Text}" />
                                                </DataTemplate>
                                            </v:GoalMessageTemplate.Plain>
                                        </v:GoalMessageTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ======== Waiting for the tool ========
                 A row in the conversation, in the same shape as the message it is standing in for: the
                 gutter marker where the marker goes, the dots where the text will be. What you are
                 waiting for *is* a message, so a placeholder message is what says so.

                 It used to be a pill floating over the transcript, pinned to the bottom-left of the
                 scroll area. Two things were wrong with that and only one of them was cosmetic: it
                 overlapped whatever was underneath — at the foot of a full transcript, the composer the
                 user was typing into — and it said a second time what the status strip at the top of
                 the tile already says, with the phase and the attempt number, in a bar that cannot be
                 scrolled away from. In the flow it can collide with nothing, it lands exactly where the
                 next message will, and the follow-to-the-bottom rule carries it for free. -->
            <Border Classes="row" IsVisible="{Binding IsRunning}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="gutter gutter-system" />
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Ellipse Classes="think d1" />
                        <Ellipse Classes="think d2" />
                        <Ellipse Classes="think d3" />
                        <TextBlock Classes="waiting-note" Text="{Binding RunStage}" Margin="7,0,0,0" />
                        <TextBlock Classes="waiting-note" Text="&#183;" />
                        <TextBlock Classes="waiting-note" Text="{Binding Elapsed}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>


        <GridSplitter x:Name="AskSplitter"
                      Grid.Row="1"
                      Height="5"
                      ResizeDirection="Rows"
                      Background="Transparent"
                      IsVisible="{Binding ShowQuestions}" />

        <!-- ======== The ask: questions ========
             Docked where the composer is, because it replaces it. Capped and scrollable: the request
             was that the conversation stay readable while questions are on screen, and a panel that
             grows with the number of questions is a panel that eats the tile at four of them.

             And no MinHeight. One used to be here at 110, which quietly outranked that cap: on a tile
             150 pixels tall three fifths is 90, the floor won, and the transcript was squeezed past its
             own minimum until the Send button left the bottom edge — the failure the cap exists to
             prevent, reintroduced by the guard sitting next to it. -->
        <Border Grid.Row="2"
                x:Name="AskPanel"
                Classes="ask"
                IsVisible="{Binding ShowQuestions}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Classes="ask-rail" />
                <Grid Margin="10,6,10,8" RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0"
                               Classes="ask-title"
                               Margin="0,0,0,4"
                               Text="{Binding QuestionsTitle}" />

                    <!-- No MaxHeight any more: the panel's height is the splitter's business, and a cap
                         in here would have left the list scrolling inside 260 pixels of a panel the
                         user had just dragged to twice that. -->
                    <!-- The padding is for the scroll bar, which is drawn over the content rather
                         than beside it: without it the right-hand border of every answer box sat
                         underneath the bar and looked cut off. It is on the scroller rather than on the
                         rows so that it is there only when there is something to scroll past. -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="0,0,10,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="QuestionList" ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GoalQuestionAnswer">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                                        <TextBlock Grid.Column="0" Classes="ask-marker" Text="{Binding Marker}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="ask-question" Text="{Binding Question}" />
                                            <TextBlock Classes="ask-why"
                                                       IsVisible="{Binding HasWhy}"
                                                       Text="{Binding Why}" />

                                            <!-- One offered answer per row, each the full width of the
                                                 panel.

                                                 Two shapes were tried first and both cut the text off
                                                 mid-word: a WrapPanel measures its children with
                                                 unlimited width, so a chip carrying a sentence is never
                                                 asked to wrap, and a chip sized to its own content is
                                                 not asked either — it is simply clipped when it does not
                                                 fit. A row that fills the width has a width to wrap at,
                                                 which is the only version of this that cannot lose a
                                                 word. A short answer in a wide row is a little empty
                                                 space; a long one in a narrow chip was unreadable. -->
                                            <ItemsControl ItemsSource="{Binding Options}"
                                                          IsVisible="{Binding HasOptions}"
                                                          Margin="0,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:GoalOption">
                                                        <Button Classes="ask-option"
                                                                HorizontalAlignment="Stretch"
                                                                Margin="0,0,0,5"
                                                                Command="{Binding Use}"
                                                                ToolTip.Tip="Put this in the answer below">
                                                            <TextBlock Text="{Binding Text}"
                                                                       TextWrapping="Wrap" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Enter sends, as it does in the composer. The box refuses
                                                 line breaks, so without this Enter was the one key that
                                                 did nothing at all in a panel you answer by typing. -->
                                            <TextBox Classes="ask-field"
                                                     Text="{Binding Answer}"
                                                     PlaceholderText="Your answer&#x2026;"
                                                     AcceptsReturn="False"
                                                     TextWrapping="Wrap"
                                                     KeyDown="AnswerBox_KeyDown" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0"
                            Classes="goal-action primary"
                            Command="{Binding SendAnswersCommand}"
                            Content="Send answers"
                            ToolTip.Tip="Send what you have written. A question left blank is skipped." />
                </Grid>
            </DockPanel>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
