<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:m="using:mTiles.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:views="using:mTiles.Views"
             x:Class="mTiles.Views.WorkspacesPanelView"
             x:DataType="vm:WorkspacesPanelViewModel"
             Margin="8,8,0,8">

    <UserControl.Styles>
        <Style Selector="ScrollViewer.scroll-left">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" ColumnSpacing="0" RowSpacing="0">
                        <ScrollBar Name="PART_VerticalScrollBar" Margin="3, 0, 0, 0" 
                                   Grid.Column="0" Grid.Row="0" Padding="0" 
                                   Orientation="Vertical" />
                        <ScrollContentPresenter Name="PART_ContentPresenter"
                                                Grid.Column="1" Grid.Row="0" 
                                                Background="{TemplateBinding Background}"
                                                Margin="0"
                                                Padding="{TemplateBinding Padding}" />
                        <ScrollBar Name="PART_HorizontalScrollBar" Margin="0"
                                   Grid.Column="1" Grid.Row="1"
                                   Orientation="Horizontal" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- A card, like the tiles: same ground, same radius, same hairline. The panel used to be the one
         flat slab in the application, running from the title bar to the taskbar beside a column of
         cards — which read as two applications sharing a window rather than as one. -->
    <Border Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="{DynamicResource BorderThin}"
            CornerRadius="{DynamicResource RadiusTile}">
    <Border CornerRadius="{DynamicResource RadiusTileInner}" ClipToBounds="True">
    <Panel>
        <!-- ═══ EXPANDED MODE ═══ -->
        <DockPanel x:Name="ExpandedPanel">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="2" Margin="8,6,8,6">
                <Button Classes="toolbar"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSettingsCommand}"
                        ToolTip.Placement="Right"
                        ToolTip.Tip="Settings">
                    <mi:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
                </Button>
                <Button Classes="toolbar"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowPhoneBridgeCommand}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasPhoneBridge}"
                        ToolTip.Placement="Right"
                        ToolTip.Tip="Dictate from a phone">
                    <mi:MaterialIcon Kind="Qrcode" Width="18" Height="18" />
                </Button>
                <Button Classes="toolbar"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyUpdateCommand}"
                        ToolTip.Placement="Right"
                        ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UpdateVersion, StringFormat='Update to {0}'}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsUpdateAvailable}"
                        Foreground="{DynamicResource AccentDefault}">
                    <mi:MaterialIcon Kind="ArrowUpBoldCircleOutline" Width="18" Height="18" />
                </Button>
            </StackPanel>

            <Border DockPanel.Dock="Bottom"
                    Height="1"
                    Margin="8,0"
                    Background="{DynamicResource BorderSubtle}" />

            <TextBox DockPanel.Dock="Top"
                     Text="{Binding FilterText, Mode=TwoWay}"
                     PlaceholderText="Filter..."
                     IsVisible="{Binding ShowFilter}"
                     Margin="10,10,10,0"
                     Padding="9,6"
                     FontSize="{DynamicResource FontSm}">
                <TextBox.InnerRightContent>
                    <Button Classes="ghost"
                            Command="{Binding ClearFilterCommand}"
                            IsVisible="{Binding FilterText.Length}"
                            Padding="2" Margin="0,0,2,0"
                            MinWidth="16" MinHeight="16">
                        <mi:MaterialIcon Kind="Close" Width="10" Height="10" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>

            <!-- The scrollbar is on the right, where it does not share an axis with the status markers
                 and does not push the list out of line with the filter box above it. The panel has one
                 left edge now; everything in it starts there. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,8,0,0">
                <StackPanel Margin="0">
                    <!-- The section's own heading, with the add button on it. "Workspace" used to be a
                         full-width row at the foot of the list, which put it below the last workspace
                         and made a long list end in something that was not one. A heading also gives
                         the list an edge to start at. -->
                    <DockPanel Margin="19,0,10,4">
                        <Button DockPanel.Dock="Right"
                                Classes="ghost"
                                Command="{Binding AddWorkspaceCommand}"
                                Padding="3" MinWidth="18" MinHeight="18"
                                Cursor="Hand"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="Add Workspace">
                            <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
                        </Button>
                        <TextBlock Text="Workspaces"
                                   Classes="section"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl x:Name="WorkspaceList"
                                  ItemsSource="{Binding FilteredWorkspaces}"
                                  Margin="8,0,8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                <!-- Two things, and they are the two a workspace is chosen by: its
                                     name and the branch it is on. Everything else that has stood here —
                                     the directory, an open/closed marker, a disclosure and a count of
                                     the tiles under it — was either already on screen somewhere better
                                     or competing with the name for a row 240px wide. The directory is
                                     in the tooltip, which is where a path that long belongs.

                                     **A line each, both on the same left margin.** Side by side, the
                                     name and the branch bid for the same 240px and the name kept losing
                                     — it was the one that had to give way, so a row came out as "B…"
                                     beside a fully spelled-out `feature/ui-redesign`. A second line
                                     ends the argument for a few pixels of height; putting it on the
                                     same margin is what leaves the panel one left edge to read down,
                                     which is the only thing that makes a list this long scannable. -->
                                <Border Classes="workspace-item"
                                        Classes.workspace-item-selected="{Binding IsSelected}"
                                        Classes.workspace-item-unloaded="{Binding !IsLoaded}"
                                        Padding="9,5"
                                        Margin="0,0,0,1"
                                        CornerRadius="{DynamicResource RadiusRow}"
                                        Cursor="Hand"
                                        ToolTip.Placement="Right"
                                        ToolTip.Tip="{Binding DirectoryPath}"
                                        PointerPressed="WorkspaceItem_PointerPressed">
                                    <StackPanel Spacing="1">
                                        <!-- The star and the working light are both fixed-width and
                                             docked, so the name still takes everything that is left —
                                             two glyphs is what a row can spare beside a name; a third
                                             would start the argument this layout exists to end. -->
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Classes="workspace-star"
                                                    Classes.is-favorite="{Binding IsFavorite}"
                                                    Command="{Binding $parent[ItemsControl].((vm:WorkspacesPanelViewModel)DataContext).ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Placement="Right"
                                                    ToolTip.Tip="Favourite">
                                                <Panel>
                                                    <mi:MaterialIcon Kind="Star"
                                                                     IsVisible="{Binding IsFavorite}" />
                                                    <mi:MaterialIcon Kind="StarOutline"
                                                                     IsVisible="{Binding !IsFavorite}" />
                                                </Panel>
                                            </Button>
                                            <!-- A light, not a label: it comes and goes many times in a
                                                 session and a word appearing beside a name would move
                                                 the name every time something printed. It turns, because
                                                 what it reports is work in progress and a still mark
                                                 cannot tell that apart from a state left switched on. -->
                                            <mi:MaterialIcon DockPanel.Dock="Right"
                                                             Kind="Loading"
                                                             Classes="workspace-busy"
                                                             Classes.spinning="{Binding IsBusy}"
                                                             Margin="4,0"
                                                             IsVisible="{Binding IsBusy}"
                                                             ToolTip.Placement="Right"
                                                             ToolTip.Tip="Working" />
                                            <!-- The colour is a class and not a local value, because a
                                                 workspace nobody has opened is drawn a shade back and
                                                 one writer per property is the rule: a Foreground set
                                                 here would beat the style and the row would never dim. -->
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                       Classes="workspace-name"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <!-- The meta line is always here and always the same height,
                                             whatever it has to say. Showing it only for repositories
                                             gave the list two row heights interleaved at random, which
                                             is the one thing a column of twenty names cannot afford:
                                             nothing lines up and the eye has no rhythm to scan by.
                                             Reserving the line also covers the moment before the check
                                             has answered, when there is nothing truthful to put in it. -->
                                        <!-- The memory reading shares the branch's line and is docked to
                                             the right of it, which is the one place on the row where a
                                             number does not compete with a name: it is three characters
                                             wide, it is only there for a workspace that is loaded, and
                                             the branch — the fill child — is measured against what is
                                             left, so it trims instead of running underneath. -->
                                        <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Classes="workspace-memory"
                                                   Text="{Binding MemoryText}"
                                                   ToolTip.Placement="Right"
                                                   ToolTip.Tip="Memory held by this workspace's tiles" />
                                        <Panel Height="15">
                                            <DockPanel Classes="workspace-meta"
                                                       IsVisible="{Binding BranchName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <mi:MaterialIcon DockPanel.Dock="Left" Kind="SourceBranch" />
                                                <TextBlock Text="{Binding BranchName}" />
                                            </DockPanel>
                                            <!-- An offer, not a label. A workspace without a repository
                                                 is the one row here that can be acted on from the panel,
                                                 and saying only "no repository" would leave the user to
                                                 go and find a terminal to type the answer into. -->
                                            <Button Classes="workspace-meta-action"
                                                    IsVisible="{Binding HasNoRepository}"
                                                    Command="{Binding $parent[ItemsControl].((vm:WorkspacesPanelViewModel)DataContext).CreateRepositoryCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Placement="Right"
                                                    ToolTip.Tip="Run git init here">
                                                <DockPanel Classes="workspace-meta">
                                                    <mi:MaterialIcon DockPanel.Dock="Left" Kind="SourceBranchPlus" />
                                                    <TextBlock Text="Create repository" />
                                                </DockPanel>
                                            </Button>
                                            <!-- The rows with neither a branch nor an offer: the home
                                                 directory, the root of a drive, the system folders.
                                                 They were the one place this line came out blank, and
                                                 a reserved line saying nothing is height spent on
                                                 silence. The path rather than a word for what kind of
                                                 place it is, because a word is what the name already
                                                 is on exactly these rows — "Home directory" is an
                                                 alias, and it is the path that says which profile. It
                                                 gets the line the name could not give it, and trims.

                                                 The house used to sit in front of the name, where it
                                                 said what the name already said. It lives here, and it
                                                 is three glyphs rather than one: this is the line where
                                                 what kind of place it is, is the thing being said, and
                                                 a disk and a cog are the other two answers. -->
                                            <DockPanel Classes="workspace-meta"
                                                       IsVisible="{Binding ShowsDirectoryPath}">
                                                <mi:MaterialIcon DockPanel.Dock="Left"
                                                                 Kind="{Binding SpecialKind, Converter={x:Static views:SpecialDirectoryIcon.Kind}}" />
                                                <!-- No tooltip of its own: the row already carries the
                                                     full path, and a nested one with the same text is
                                                     the same fact twice with a chance to disagree. -->
                                                <TextBlock Text="{Binding DirectoryPath}" />
                                            </DockPanel>
                                        </Panel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══ COLLAPSED MODE (icon strip) ═══ -->
        <DockPanel x:Name="CollapsedPanel" IsVisible="False">
            <StackPanel DockPanel.Dock="Bottom" Spacing="2" HorizontalAlignment="Center" Margin="0,4,0,6">
                <Button Classes="toolbar"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyUpdateCommand}"
                        ToolTip.Placement="Right"
                        ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UpdateVersion, StringFormat='Update to {0}'}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsUpdateAvailable}"
                        Foreground="{DynamicResource AccentDefault}"
                        HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="ArrowUpBoldCircleOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="toolbar"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSettingsCommand}"
                        HorizontalAlignment="Center"
                        ToolTip.Placement="Right"
                        ToolTip.Tip="Settings">
                    <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="toolbar"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowPhoneBridgeCommand}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasPhoneBridge}"
                        HorizontalAlignment="Center"
                        ToolTip.Placement="Right"
                        ToolTip.Tip="Dictate from a phone">
                    <mi:MaterialIcon Kind="Qrcode" Width="16" Height="16" />
                </Button>
            </StackPanel>

            <Button DockPanel.Dock="Bottom"
                    Classes="toolbar"
                    Command="{Binding AddWorkspaceCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,0"
                    ToolTip.Placement="Right"
                    ToolTip.Tip="Add Workspace">
                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
            </Button>

            <ScrollViewer Classes="scroll-left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Workspaces}" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceItemViewModel">
                            <Border Width="32" Height="32"
                                    Margin="0,2"
                                    CornerRadius="{DynamicResource RadiusRow}"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    ToolTip.Tip="{Binding Name}"
                                    PointerPressed="CollapsedItem_PointerPressed"
                                    Classes.workspace-icon-selected="{Binding IsSelected}">
                                <TextBlock Text="{Binding Initials}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Panel>
    </Border>
    </Border>
</UserControl>
