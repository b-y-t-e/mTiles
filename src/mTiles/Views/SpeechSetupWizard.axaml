<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mTiles.ViewModels"
        x:Class="mTiles.Views.SpeechSetupWizard"
        x:DataType="vm:SpeechSetupViewModel"
        Title="Set up dictation"
        Width="520"
        Height="440"
        MinWidth="420" MinHeight="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgElevated}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Border Padding="18,16"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="{DynamicResource BorderThin}"
            CornerRadius="{DynamicResource RadiusLg}">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="2">
                <TextBlock Text="{Binding StepCaption}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="{DynamicResource FontXs}"
                           Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="Set up dictation"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="{DynamicResource FontLg}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Content="Cancel"
                        MinWidth="70" Padding="12,5" MinHeight="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextMuted}"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource RadiusMd}"
                        FontFamily="{DynamicResource UiFontFamily}"
                        FontSize="{DynamicResource UiFontSizeSm}"
                        Cursor="Hand"
                        Command="{Binding CloseCommand}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <!-- The shared style plus `on-elevated`, which is this window's ground: its own
                         background is BgElevated, so the plain class would leave the button invisible
                         against it. A class rather than an inline Background, because a local value beats
                         a style setter and silences the hover rule. -->
                    <Button Classes="outlined-sm on-elevated"
                            Content="Back"
                            MinWidth="70" Padding="12,5"
                            IsVisible="{Binding CanGoBack}"
                            Command="{Binding BackCommand}" />
                    <!-- Named for the regression test: clicking Next is how anybody reaches the last
                         step, so this button holds the focus there — and a focused button raises Click
                         from the key-up of Space, which is half of the default shortcut. -->
                    <Button x:Name="NextButton"
                            Classes="accent"
                            Content="{Binding NextCaption}"
                            MinWidth="90" Padding="12,5" MinHeight="0"
                            FontSize="{DynamicResource UiFontSizeSm}"
                            Cursor="Hand"
                            IsEnabled="{Binding CanGoNext}"
                            Command="{Binding NextCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- A message that applies to whichever step is showing -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding Message}"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource DangerText}" />

            <Panel Margin="0,14,0,0">
                <!-- ═══ Step 1: the model ═══ -->
                <DockPanel IsVisible="{Binding IsModelStep}">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Recognition runs on this machine, so it needs a model downloaded once. Nothing else to install."
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="{DynamicResource UiFontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}" />

                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                        <Button Classes="outlined-sm on-elevated"
                                Content="Download"
                                HorizontalAlignment="Left"
                                MinWidth="110" Padding="12,6"
                                Foreground="{DynamicResource TextPrimary}"
                                IsVisible="{Binding !IsModelReady}"
                                Command="{Binding DownloadCommand}" />

                        <StackPanel Spacing="4" IsVisible="{Binding Selected.IsDownloading}">
                            <ProgressBar Minimum="0" Maximum="1" Height="4"
                                         Value="{Binding Selected.Progress}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Cancel download"
                                        Padding="8,3" MinHeight="0"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextMuted}"
                                        BorderThickness="0"
                                        FontFamily="{DynamicResource UiFontFamily}"
                                        FontSize="{DynamicResource FontXs}"
                                        Cursor="Hand"
                                        Command="{Binding Selected.CancelDownloadCommand}" />
                                <TextBlock Text="{Binding Selected.ProgressText}"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Text="This model is on your machine."
                                   IsVisible="{Binding IsModelReady}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="{DynamicResource FontXs}"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Models}"
                             SelectedItem="{Binding Selected}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeechModelViewModel">
                                <StackPanel Spacing="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="ON DISK"
                                                   IsVisible="{Binding IsDownloaded}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   FontSize="{DynamicResource FontXs}"
                                                   Foreground="{DynamicResource StatusSuccessText}" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   FontSize="{DynamicResource UiFontSizeSm}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Note}"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding SizeText}"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ═══ Step 2: the microphone ═══ -->
                <StackPanel IsVisible="{Binding IsMicrophoneStep}" Spacing="10">
                    <TextBlock Text="Which microphone should dictation listen to? The system default follows whatever you switch to — a headset, a webcam — without coming back here."
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="{DynamicResource UiFontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}" />

                    <ComboBox Classes="setting"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding Device}" />
                </StackPanel>

                <!-- ═══ Step 3: hold the shortcut and say something ═══
                     The step teaches the shortcut by having it used, which is why there is no separate
                     page for configuring one. Everything above the transcript is a single instruction in
                     one of three states: press these keys, choose different keys, or nothing is getting
                     through. -->
                <DockPanel IsVisible="{Binding IsTestStep}">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="8">

                        <!-- ── the feature itself is off ──
                             The step is otherwise an instruction that cannot succeed, and the service's
                             own refusal points at Settings → Speech, which this modal is covering. The
                             switch is offered here rather than flipped silently: somebody turned it off,
                             and opening a wizard is not evidence enough that they changed their mind. -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsDictationOff}">
                            <TextBlock Text="Dictation is switched off, so nothing here will record."
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource UiFontSizeSm}"
                                       Foreground="{DynamicResource DangerText}" />
                            <Button Classes="outlined-sm on-elevated"
                                    Content="Turn dictation on"
                                    HorizontalAlignment="Left"
                                    Command="{Binding TurnDictationOnCommand}" />
                        </StackPanel>

                        <!-- ── the instruction, when there is a shortcut to give ──
                             Hidden while dictation is switched off. Otherwise the page says "Hold Alt
                             Space and say something" directly under a notice explaining that nothing
                             will record — telling the user to do a thing and that the thing cannot work,
                             one line apart. The switch above is the only instruction that applies then. -->
                        <StackPanel Spacing="8"
                                    IsVisible="{Binding !IsCapturingHotkey}">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ShowsShortcutInstruction}">
                                <!-- "Hold" or "Press": in toggle mode the release does nothing, so an
                                     instruction to hold the keys leaves the recording running to its
                                     five-minute cap with nothing on screen to say so. -->
                                <TextBlock Text="{Binding HotkeyVerb}"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="{DynamicResource FontLg}"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <ItemsControl ItemsSource="{Binding HotkeyKeys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="keycap">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="and say something."
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="{DynamicResource FontLg}"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>

                            <TextBlock Text="{Binding HotkeyFollowUp}"
                                       IsVisible="{Binding ShowsToggleFollowUp}"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource UiFontSizeSm}"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <!-- Only when the setting really is empty. A shortcut that cannot be listened
                                 for gets the warning below instead, because telling somebody they chose
                                 "no shortcut" when they did not is the one answer that is simply false. -->
                            <TextBlock Text="No shortcut — dictation runs from the microphone button in the tile's header."
                                       IsVisible="{Binding ShowsNoShortcutNote}"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource UiFontSizeSm}"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <TextBlock Text="{Binding HotkeyWarning}"
                                       IsVisible="{Binding HotkeyWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>

                        <!-- ── choosing a different one: one keystroke, then straight back ── -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsCapturingHotkey}">
                            <TextBlock Text="Press the keys you want."
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource FontLg}"
                                       Foreground="{DynamicResource AccentDefault}" />
                            <TextBlock Text="Backspace for no shortcut at all. Escape to leave it as it was."
                                       TextWrapping="Wrap"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>

                        <!-- ── the state of the recording ── -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Listening…"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsRecording}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource UiFontSizeSm}"
                                       Foreground="{DynamicResource DangerText}" />
                            <TextBlock Text="Working it out…"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsTranscribing}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="{DynamicResource UiFontSizeSm}"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>

                        <!-- ── the one failure with nothing on screen to read ── -->
                        <TextBlock IsVisible="{Binding ShowHotkeyHint}"
                                   Text="Nothing happening? Some shortcuts are taken by the desktop before any application sees them. Try different keys, or use the button below."
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="{DynamicResource FontXs}"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>

                    <!-- ── the ways out: a different shortcut, none at all, or no shortcut needed ──
                         Hidden entirely while a shortcut is being chosen: that mode lasts one keystroke,
                         and a Record button showing through it invited starting a recording the page was
                         not asking for. Escape is the way out and the page says so. -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                                IsVisible="{Binding !IsCapturingHotkey}">
                        <Button Classes="outlined-sm on-elevated"
                                Content="Use different keys"
                                Command="{Binding BeginCaptureHotkeyCommand}" />
                        <!-- Whatever is stored, usable or not — this is the button that removes it. -->
                        <Button Classes="outlined-sm on-elevated"
                                Content="No shortcut"
                                IsVisible="{Binding !IsShortcutBlank}"
                                Command="{Binding ClearHotkeyCommand}"
                                ToolTip.Tip="Leave the keys to the shell; the tile's microphone button still works" />
                        <Button Classes="outlined-sm on-elevated"
                                Command="{Binding ToggleTestCommand}"
                                ToolTip.Tip="The same recording, without the shortcut">
                            <Panel>
                                <TextBlock Text="Record" IsVisible="{Binding !IsRecording}" />
                                <TextBlock Text="Stop" IsVisible="{Binding IsRecording}"
                                           Foreground="{DynamicResource DangerText}" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <Border Background="{DynamicResource BgSurface}"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="10,8">
                        <TextBlock Text="{Binding Transcript}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="{DynamicResource UiFontSizeSm}"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Border>
                </DockPanel>
            </Panel>
        </DockPanel>
    </Border>
</Window>
