<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             x:Class="mTiles.Views.SettingsTabsHeader"
             x:DataType="vm:SettingsViewModel">

    <!-- The settings dialog's tabs, drawn by OverlayHost beside its close button.

         A control of its own rather than part of SettingsView's tree, and that is not tidiness: a
         control has one parent, so handing the host something already inside the page would be asking
         Avalonia to put the same StackPanel in two places. It throws, the host's caller catches, and
         the dialog closes the instant it opens - which is what it did. -->

    <StackPanel Orientation="Horizontal" Spacing="0">
        <Button Classes="settings-tab"
                Classes.settings-tab-active="{Binding IsGeneralTab}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTabs.General}"
                Content="General" />
        <Button Classes="settings-tab"
                Classes.settings-tab-active="{Binding IsAiTab}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTabs.Ai}"
                Content="AI" />
        <Button Classes="settings-tab"
                Classes.settings-tab-active="{Binding IsDatabaseTab}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTabs.Database}"
                Content="Database" />
        <Button Classes="settings-tab"
                Classes.settings-tab-active="{Binding IsSpeechTab}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:SettingsTabs.Speech}"
                Content="Speech" />
    </StackPanel>
</UserControl>
