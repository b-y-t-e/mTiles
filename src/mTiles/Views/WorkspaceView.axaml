<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:views="using:mTiles.Views"
             x:Class="mTiles.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             Background="{DynamicResource BgCanvas}">

    <!-- No padding of its own: the gutter round the outside of the workspace is the window's, since the
         workspace is a tile of the window's layout and the gutter between that tile and its neighbours
         is the one every tile has. The surface is still the workspace's one drop target, and the tiles
         inside it have none of their own (see TileDropSurface). -->
    <views:TileDropSurface x:Name="DropSurface"
                           Background="{DynamicResource BgCanvas}">
        <views:TileNodeView x:Name="RootTileView"
                            DataContext="{Binding RootTile}" />
    </views:TileDropSurface>
</UserControl>
