<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:m="using:mTiles.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="mTiles.Views.LeafTileView"
             x:DataType="vm:LeafTileNodeViewModel"
             DragDrop.AllowDrop="True">

    <!-- The tile is a card: rounded, on its own background, with the canvas showing in the gaps that
         the splitters leave. ClipToBounds on the card is what rounds everything inside it — the
         terminal's own background included — so nothing below has to know the radius.

         **The card's own edge is the active marker.** It used to be a two-pixel strip along the top of
         the toolbar, which was the right marker for a square tile in a grid of splitters and the wrong
         one the moment the tile became a rounded card: the radius eats the strip's ends, and what is
         left is a short line floating inside a corner rather than an edge. An outline is the shape the
         tile already has. It stands down to BorderSubtle while this tile is being dictated into, so the
         dictation border frames the same rectangle without two markers arguing over it. -->
    <Border x:Name="TileCard"
            Background="{DynamicResource BgBase}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="{DynamicResource BorderThin}"
            CornerRadius="{DynamicResource RadiusTile}">
    <!-- The clip is on an element of its own, and that is not a nicety. ClipToBounds on the border
         that also *draws* the outline clips to the rounded-down bounds rectangle, so at a fractional
         desktop scale (125%, 150%) the right and bottom edges fall outside their own clip and the
         outline comes out as an L along the top and left. Clipping the content instead leaves the
         outline free to render on all four sides. -->
    <Border CornerRadius="{DynamicResource RadiusTileInner}" ClipToBounds="True">
    <Grid>
        <Border ClipToBounds="True">
            <DockPanel>
                <!-- Tile toolbar -->
                <!-- The hairline is what makes the header the card's header rather than a lighter
                     slab stacked on a darker one. It carries no state: the header's own tone and the
                     strip above it already say which tile is active, and a third thing changing at the
                     same moment says it no louder. -->
                <Border x:Name="TileToolbar"
                        DockPanel.Dock="Top"
                        Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="{DynamicResource BorderBottom}"
                        Padding="6,0"
                        Height="27">
                    <DockPanel x:Name="TileHeaderContent">
                        <!-- Everything here is also in the overflow, and the overflow is the only one
                             of them that never stands down. That is the whole arrangement: the buttons
                             are the fast path when the header has room, the menu is the guarantee that
                             it is reachable when it has not.

                             What is a button and what is only a menu item follows how often it is
                             pressed, which is a fact about use and not about the code — an earlier
                             version of this put Restart shell and New session behind the menu on the
                             reasoning that they are used "once a session", and they are among the most
                             used things in the application. The splits went the other way for a reason
                             that survives being wrong about frequency: dragging a tile onto another
                             does the same job, so a split is the one action here with a second route.

                             The microphone is neither: it is a toggle whose state the header has to
                             show, and a light behind a menu is not a light. Close is neither: it is the
                             one action that must never be hunted for. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1">
                            <Button Classes="tile-btn"
                                    Classes.tile-btn-recording="{Binding IsDictating}"
                                    Command="{Binding ToggleDictationCommand}"
                                    ToolTip.Tip="Dictate into this tile"
                                    IsVisible="{Binding CanDictate}">
                                <mi:MaterialIcon Kind="Microphone" Width="14" Height="14" />
                            </Button>
                            <!-- No IsVisible binding on these two: ApplyHeaderWidth is the only writer,
                                 and it reads the same view-model properties a binding would. Both write
                                 at the same priority, so with a binding here the last one to fire won —
                                 the width rule while the tile was resized, the binding the next time the
                                 tile's content changed, and neither reliably. -->
                            <Button x:Name="RestartButton"
                                    Classes="tile-btn"
                                    Command="{Binding RestartTerminalCommand}"
                                    ToolTip.Tip="Restart shell (Ctrl+Shift+R)">
                                <mi:MaterialIcon Kind="Restart" Width="14" Height="14" />
                            </Button>
                            <Button x:Name="NewSessionButton"
                                    Classes="tile-btn"
                                    Command="{Binding ResetTileIdCommand}"
                                    ToolTip.Tip="New session">
                                <mi:MaterialIcon Kind="PlaylistPlus" Width="14" Height="14" />
                            </Button>
                            <Button x:Name="TileOverflow"
                                    Classes="tile-btn"
                                    ToolTip.Tip="More">
                                <mi:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Restart shell"
                                                  InputGesture="Ctrl+Shift+R"
                                                  Command="{Binding RestartTerminalCommand}"
                                                  IsVisible="{Binding ContentType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:TileContentType.Terminal}}">
                                            <MenuItem.Icon>
                                                <mi:MaterialIcon Kind="Restart" Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New session"
                                                  Command="{Binding ResetTileIdCommand}"
                                                  IsVisible="{Binding HasProfile}">
                                            <MenuItem.Icon>
                                                <mi:MaterialIcon Kind="PlaylistPlus" Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Split right"
                                                  Command="{Binding SplitVerticalCommand}">
                                            <MenuItem.Icon>
                                                <mi:MaterialIcon Kind="DockRight" Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Split down"
                                                  Command="{Binding SplitHorizontalCommand}">
                                            <MenuItem.Icon>
                                                <mi:MaterialIcon Kind="DockBottom" Width="14" Height="14" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="SplitRightButton"
                                    Classes="tile-btn"
                                    Command="{Binding SplitVerticalCommand}"
                                    ToolTip.Tip="Split Right">
                                <mi:MaterialIcon Kind="DockRight" Width="14" Height="14" />
                            </Button>
                            <Button x:Name="SplitDownButton"
                                    Classes="tile-btn"
                                    Command="{Binding SplitHorizontalCommand}"
                                    ToolTip.Tip="Split Down">
                                <mi:MaterialIcon Kind="DockBottom" Width="14" Height="14" />
                            </Button>
                            <Button Classes="tile-btn-close"
                                    Command="{Binding CloseCommand}"
                                    ToolTip.Tip="Close tile">
                                <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </StackPanel>

                        <!-- The tile wears the icon it was created with. Kind and colour are set from
                             the code-behind rather than bound, because both follow ContentType, which is
                             already the one thing this view redraws itself on. -->
                        <mi:MaterialIcon x:Name="TileTypeGlyph"
                                         DockPanel.Dock="Left"
                                         Width="13" Height="13"
                                         VerticalAlignment="Center"
                                         Margin="2,0,6,0" />

                        <TextBlock x:Name="TileNameLabel"
                                   Text="{Binding TileName}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="{DynamicResource UiFontSize}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0"
                                   MinWidth="28"
                                   TextTrimming="CharacterEllipsis"
                                   Cursor="Hand"
                                   DoubleTapped="TileNameLabel_DoubleTapped" />
                        <TextBox x:Name="TileNameEditor"
                                 Text="{Binding TileName}"
                                 IsVisible="False"
                                 Classes="inline-editor"
                                 LostFocus="TileNameEditor_Confirm"
                                 KeyDown="TileNameEditor_KeyDown" />
                    </DockPanel>
                </Border>

                <!-- Content area + chooser overlay. The inset is applied per content type in the
                     code-behind (see ContentInset), not here: a terminal wants one and a tile whose
                     content is its own chrome does not. -->
                <Panel>
                    <WrapPanel x:Name="ContentChooser"
                               IsVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Orientation="Horizontal">
                        <Button Classes="chooser-card"
                                Command="{Binding SelectContentTypeCommand}"
                                CommandParameter="{x:Static m:TileContentType.Terminal}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Console" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TileAccentTerminal}" />
                                <TextBlock Text="Terminal" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chooser-card"
                                Command="{Binding SelectContentTypeCommand}"
                                CommandParameter="{x:Static m:TileContentType.Note}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="NoteEditOutline" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TileAccentNote}" />
                                <TextBlock Text="Note" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chooser-card"
                                Command="{Binding SelectContentTypeCommand}"
                                CommandParameter="{x:Static m:TileContentType.Todo}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="CheckboxMarkedOutline" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TileAccentTodo}" />
                                <TextBlock Text="Todo" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chooser-card"
                                Command="{Binding SelectContentTypeCommand}"
                                CommandParameter="{x:Static m:TileContentType.Git}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="SourceBranch" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TileAccentGit}" />
                                <TextBlock Text="Git" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chooser-card"
                                Command="{Binding SelectContentTypeCommand}"
                                CommandParameter="{x:Static m:TileContentType.Database}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="DatabaseOutline" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TileAccentDatabase}" />
                                <TextBlock Text="Database" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chooser-card"
                                Command="{Binding SelectContentTypeCommand}"
                                CommandParameter="{x:Static m:TileContentType.Goal}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="BullseyeArrow" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TileAccentGoal}" />
                                <TextBlock Text="Goal" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Profile chooser -->
                    <WrapPanel x:Name="ProfileChooser"
                               IsVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Orientation="Horizontal">
                        <Button Classes="chooser-back"
                                Command="{Binding CancelProfileSelectionCommand}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="ArrowLeft" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="Back" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProfileButtonsMarker"
                                Classes="chooser-card"
                                Command="{Binding SelectDefaultTerminalCommand}">
                            <StackPanel Spacing="7" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Console" Width="22" Height="22"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="Default shell" FontSize="{DynamicResource FontSm}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Panel x:Name="ContentHost" />
                </Panel>
            </DockPanel>
        </Border>

        <!-- Dictation: a breathing border while the microphone is open, a quicker pulse while the
             words are being worked out. An overlay rather than a border on the tile itself, so it
             costs no layout and cannot move the content under the user's cursor. It frames the whole
             card, header included, and is safe to do so because the active outline stands down while
             it is showing — two markers on one edge is what that avoids.

             Its radius, and the drop overlay's, is RadiusTileInner rather than RadiusTile: both are
             drawn *inside* the clipping border, whose corners are one border-width tighter than the
             card's. At the card's own radius the corners are shaved off by the clip they sit in. -->
        <Border x:Name="DictationBorder"
                Classes="dictation"
                IsVisible="False"
                IsHitTestVisible="False"
                ZIndex="90" />

        <!-- Drop zone overlay -->
        <Border x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
                CornerRadius="{DynamicResource RadiusTileInner}" ZIndex="100" />
    </Grid>
    </Border>
    </Border>
</UserControl>
