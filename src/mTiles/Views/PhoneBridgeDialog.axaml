<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mTiles.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mTiles.Views.PhoneBridgeDialog"
        x:DataType="vm:PhoneBridgeViewModel"
        Title="Dictate from a phone"
        Width="900"
        SizeToContent="Height"
        MaxHeight="880"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgElevated}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Window.Styles>
        <!-- The two scan targets. Everything they do not share lives inside them; everything they do
             share was moved out, because two cards carrying the same three sentences read as one thing —
             and picking the wrong one is the failure this panel exists to prevent. -->
        <Style Selector="Border.code-card">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource FontLg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Border Padding="20,16"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLg}">
        <DockPanel>

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="3">
                <TextBlock Text="Dictate from a phone"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="{DynamicResource FontLg}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Status}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="{DynamicResource FontSm}"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Scan a code with your phone, then hold the button on the page that opens and speak. What you say is typed into whichever tile is active, exactly as the Alt+Space shortcut does. Recognition still runs on this computer."
                           Classes="note"
                           MaxWidth="640"
                           HorizontalAlignment="Left"
                           Margin="0,5,0,0" />
            </StackPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left"
                        Classes="outlined-sm on-elevated"
                        Content="Look again"
                        ToolTip.Tip="Re-check this machine's network addresses"
                        Command="{Binding RefreshCommand}" />
                <Button DockPanel.Dock="Left"
                        Classes="outlined-sm on-elevated"
                        Margin="6,0,0,0"
                        Content="Different network?"
                        Command="{Binding ToggleAlternativesCommand}"
                        IsVisible="{Binding Alternatives.Count}" />
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Content="Done"
                        MinWidth="80" Padding="12,5" MinHeight="0"
                        Background="{DynamicResource AccentDefault}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource RadiusMd}"
                        FontFamily="{DynamicResource UiFontFamily}"
                        FontSize="{DynamicResource UiFontSizeSm}"
                        Cursor="Hand"
                        Click="Close_Click" />
            </DockPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                <StackPanel Spacing="14">

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 IsVisible="{Binding IsBusy}" />

                    <Border IsVisible="{Binding HasError}"
                            Background="{DynamicResource DangerSubtle}"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="12,10">
                        <TextBlock Text="{Binding Error}"
                                   Foreground="{DynamicResource DangerText}"
                                   FontSize="{DynamicResource FontSm}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Paired devices: the confirmation that a phone got through. -->
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PhoneDeviceViewModel">
                                <Border Background="{DynamicResource StatusSuccessSubtle}"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Classes="tile-btn-close"
                                                ToolTip.Tip="Disconnect this device"
                                                Command="{Binding RevokeCommand}">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                        <mi:MaterialIcon Kind="Cellphone" Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         Foreground="{DynamicResource StatusSuccessText}"
                                                         VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="{DynamicResource FontSm}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Since}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="{DynamicResource FontXs}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The codes: two to a row, and mirrored outward. -->
                    <ItemsControl ItemsSource="{Binding Codes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PhoneCodeViewModel">
                                <Border Classes="code-card" Margin="0,0,10,10">
                                    <StackPanel>
                                        <!-- The icon leads. A Wi-Fi mark against a globe is settled in a
                                             glance, where two headings sharing their first two words have
                                             to be read — and reading is what you cannot do with a phone
                                             held up to the screen. -->
                                        <Border Background="{DynamicResource BgElevated}" Padding="14,10">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <mi:MaterialIcon Kind="Wifi" Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding !IsRemote}"
                                                                 Foreground="{DynamicResource AccentHover}" />
                                                <mi:MaterialIcon Kind="Earth" Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding IsRemote}"
                                                                 Foreground="{DynamicResource AccentHover}" />
                                                <TextBlock Text="{Binding Title}" Classes="card-title" />
                                            </StackPanel>
                                        </Border>

                                        <!-- A DockPanel, not a Grid: the code has a natural size and the
                                             text takes whatever is left, whichever side each is on.
                                             Swapping grid columns while their widths stayed put left the
                                             starred column collapsed and the code hanging off the card. -->
                                        <DockPanel Margin="14,12" LastChildFill="True">
                                            <!-- Interpolation off: a QR code is a grid of hard pixels,
                                                 and smoothing it is what makes a small one fail to scan. -->
                                            <Border DockPanel.Dock="{Binding CodeDock}"
                                                    Margin="{Binding CodeMargin}"
                                                    Background="White"
                                                    Padding="7"
                                                    CornerRadius="{DynamicResource RadiusSm}"
                                                    VerticalAlignment="Top">
                                                <Image Source="{Binding Image}"
                                                       Width="184" Height="184"
                                                       RenderOptions.BitmapInterpolationMode="None" />
                                            </Border>

                                            <StackPanel Spacing="8" VerticalAlignment="Top">
                                                <SelectableTextBlock Text="{Binding Host}"
                                                           FontFamily="{DynamicResource TerminalFontFamily}"
                                                           FontSize="{DynamicResource FontSm}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Reason}" Classes="note" />

                                                <StackPanel Orientation="Horizontal" Spacing="5"
                                                            IsVisible="{Binding WarnsAboutCertificate}">
                                                    <mi:MaterialIcon Kind="ShieldAlertOutline"
                                                                     Width="13" Height="13"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,1,0,0"
                                                                     Foreground="{DynamicResource DangerText}" />
                                                    <TextBlock Text="Asks you to accept a warning"
                                                               FontSize="{DynamicResource FontXs}"
                                                               Foreground="{DynamicResource DangerText}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="5"
                                                            IsVisible="{Binding IsTrusted}">
                                                    <mi:MaterialIcon Kind="ShieldCheckOutline"
                                                                     Width="13" Height="13"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,1,0,0"
                                                                     Foreground="{DynamicResource StatusSuccessText}" />
                                                    <TextBlock Text="Opens with no warning"
                                                               FontSize="{DynamicResource FontXs}"
                                                               Foreground="{DynamicResource StatusSuccessText}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <Button Classes="outlined-sm"
                                                        HorizontalAlignment="Left"
                                                        Content="Copy link"
                                                        Margin="0,2,0,0"
                                                        Command="{Binding CopyLinkCommand}"
                                                        ToolTip.Tip="{Binding Url}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Said once, for both cards. -->
                    <TextBlock IsVisible="{Binding ShowCertificateNote}"
                               Classes="note"
                               Text="A code marked with a shield asks your phone to accept a security warning. That is expected — mTiles signed that certificate itself, because no public authority will certify a private address. Accept it once and the microphone works from then on." />

                    <TextBlock IsVisible="{Binding HasPortNotice}"
                               Classes="note"
                               Text="{Binding PortNotice}" />

                    <!-- Other addresses -->
                    <ItemsControl ItemsSource="{Binding Alternatives}"
                                  IsVisible="{Binding ShowAlternatives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PhoneAlternativeViewModel">
                                <Button Classes="add-row"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,4"
                                        Command="{Binding ShowCommand}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Host}"
                                                   FontFamily="{DynamicResource TerminalFontFamily}"
                                                   FontSize="{DynamicResource FontSm}"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding Reason}" Classes="note" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Firewall help, offered only once nothing has connected -->
                    <Border IsVisible="{Binding ShowTrouble}"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLg}"
                            Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Nothing has connected yet"
                                       FontSize="{DynamicResource FontSm}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding FirewallExplanation}" Classes="note" />
                            <Button Classes="outlined-sm on-elevated"
                                    HorizontalAlignment="Left"
                                    Content="Allow through the firewall…"
                                    IsVisible="{Binding CanRepairFirewall}"
                                    Command="{Binding RepairFirewallCommand}"
                                    ToolTip.Tip="Asks for administrator rights, removes every existing inbound rule for mTiles, and adds one allowing it on private networks" />
                            <SelectableTextBlock Text="{Binding ManualFirewallCommand}"
                                       IsVisible="{Binding ManualFirewallCommand, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontFamily="{DynamicResource TerminalFontFamily}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FirewallResult}"
                                       IsVisible="{Binding FirewallResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="note"
                                       Text="If your phone is not on this machine's own network, use the Tailscale code instead — a phone on mobile data cannot reach a private address however the firewall is set." />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
