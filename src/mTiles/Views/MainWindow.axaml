<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mTiles.ViewModels"
        xmlns:views="using:mTiles.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mTiles.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="mTiles"
        Icon="/Assets/mtiles-icon.png"
        Background="{DynamicResource BgCanvas}">

    <Panel>
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <!-- MinWidth leaves the collapsed strip a card 40px wide, which is what its 32px icon buttons
                     need once the panel's own 8px gutter and the card's hairline are taken off. At the
                     old 40 the buttons were being clipped by the card they had just been put inside. -->
                <ColumnDefinition Width="240" MinWidth="56" MaxWidth="500" />
                <!-- The same gutter the tiles have between them, for the same reason: the window is one
                     canvas with cards on it, and the panel is one of the cards. -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Workspaces panel -->
            <views:WorkspacesPanelView Grid.Column="0"
                                       DataContext="{Binding WorkspacesPanel}" />

            <!-- Resizer -->
            <GridSplitter x:Name="PanelSplitter" Grid.Column="1"
                          Classes="tile-gutter"
                          ResizeDirection="Columns" />

            <!-- Workspace content -->
            <Panel Grid.Column="2">
                <Panel x:Name="WorkspaceHost" />
                <TextBlock Text="Select or add a workspace to get started"
                           IsVisible="{Binding CurrentWorkspace, Converter={x:Static ObjectConverters.IsNull}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontLg}"
                           Foreground="{DynamicResource TextFaint}" />
            </Panel>
        </Grid>

        <!-- ======== The ground under a dialog window ========
             The QR panel is a Window rather than an overlay in this one, because it has to be readable
             from arm's length while somebody holds a phone up to it. That costs it the one thing the
             overlay dialogs get for free: the application behind them going quiet. Two modals in one
             application, one over a dimmed window and one over a live one, read as two applications.

             Scrim only, no card - the dialog draws itself, in its own window, on top of this. -->
        <Border x:Name="DialogScrim"
                IsVisible="False"
                Background="{DynamicResource OverlayModal}" />

        <!-- Settings overlay -->
        <Panel IsVisible="{Binding IsSettingsOpen}">
            <Border Background="{DynamicResource OverlayModal}"
                    PointerPressed="SettingsOverlay_PointerPressed" />
            <Border x:Name="SettingsDialog"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="420"
                    MinHeight="400"
                    CornerRadius="{DynamicResource RadiusXl}"
                    Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="{DynamicResource BorderThin}"
                    BoxShadow="0 8 32 0 #60000000"
                    Padding="0"
                    PointerPressed="SettingsDialog_PointerPressed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,10,16,0"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="{DynamicResource BorderBottom}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="toolbar"
                                    Command="{Binding ToggleSettingsCommand}"
                                    VerticalAlignment="Top" Margin="0,2,0,0">
                                <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button Classes="settings-tab"
                                        Classes.settings-tab-active="{Binding Settings.IsGeneralTab}"
                                        Command="{Binding Settings.SelectTabCommand}"
                                        CommandParameter="{x:Static vm:SettingsTabs.General}"
                                        Content="General" />
                                <Button Classes="settings-tab"
                                        Classes.settings-tab-active="{Binding Settings.IsAiTab}"
                                        Command="{Binding Settings.SelectTabCommand}"
                                        CommandParameter="{x:Static vm:SettingsTabs.Ai}"
                                        Content="AI" />
                                <Button Classes="settings-tab"
                                        Classes.settings-tab-active="{Binding Settings.IsDatabaseTab}"
                                        Command="{Binding Settings.SelectTabCommand}"
                                        CommandParameter="{x:Static vm:SettingsTabs.Database}"
                                        Content="Database" />
                                <Button Classes="settings-tab"
                                        Classes.settings-tab-active="{Binding Settings.IsSpeechTab}"
                                        Command="{Binding Settings.SelectTabCommand}"
                                        CommandParameter="{x:Static vm:SettingsTabs.Speech}"
                                        Content="Speech" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- The scroller moved inside SettingsView: it has a bar to pin below it, and a
                         DockPanel.Dock="Bottom" inside a scroller pins to the content, not the view. -->
                    <ContentControl Content="{Binding Settings}" />
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
