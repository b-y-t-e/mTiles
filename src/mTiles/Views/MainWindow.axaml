<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:mTiles.ViewModels"
        xmlns:views="using:mTiles.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="mTiles.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/mtiles-icon.png"
        Background="{DynamicResource BgCanvas}">

    <!-- Everything in the window is drawn through one scale, including the dialogs: OverlayHost is
         inside it, so a scaled interface does not get an unscaled Settings drawn over it.

         A layout transform and not a render one - layout happens at the untransformed size and is then
         drawn scaled, so text is rasterised at the size it ends up and stays sharp, the terminal's cell
         grid is measured in the coordinates it is drawn in, and the pointer lands where it looks like
         it landed. See InterfaceScale for why this exists at all: on Wayland there is no environment
         variable that would do it. -->
    <LayoutTransformControl x:Name="ScaleHost">
    <Panel>
        <!-- The window's own tile layout: the list of workspaces, the place the open workspace is drawn,
             and whatever tiles have been put beside them. The same tree, surface and gutters a workspace
             has, one level up — the gutter round the outside is this surface's padding, which is why
             neither the list nor the workspace carries a margin of its own any more.

             The list's view and the panel of workspace views are built by the window and handed to the
             frames that stand for their tiles (see MainWindow.CreateWindowTileView), so moving the list
             re-parents both rather than building either again. -->
        <views:TileDropSurface x:Name="WindowSurface"
                               Background="{DynamicResource BgCanvas}"
                               Padding="8">
            <views:TileNodeView x:Name="WindowTree"
                                DataContext="{Binding WindowLayout.RootTile}" />
        </views:TileDropSurface>


        <!-- ======== Every other dialog ========
             Last in the panel, so it draws over Settings: Settings is itself a dialog drawn this way
             and asks questions of its own — deleting a speech model, discarding unsaved database
             changes — and an answer drawn underneath the thing that asked is not an answer.
             See OverlayHost for why none of these is a window any more. -->
        <views:OverlayHost x:Name="Overlays" IsVisible="False" />
    </Panel>
    </LayoutTransformControl>
</Window>
