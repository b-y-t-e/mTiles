<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:mTiles.Views"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:v="using:mTiles.Views"
             x:Class="mTiles.Views.TerminalTileView"
             x:DataType="vm:TerminalTileViewModel">
    <!-- The two banners take a strip off the top rather than floating over the terminal: drawn on top they
         hid the first lines of whatever the tile is running, and with both up the notice covered the problem.
         Docked children come first, so the host stays the fill child. -->
  <Panel>
    <DockPanel LastChildFill="True">
        <!-- Why nothing was launched. A refused launch leaves an empty tile, and an empty tile with no
             words in it is the silent failure this exists to end. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasLaunchProblem}"
                Background="{DynamicResource BgElevated}"
                BorderBrush="{DynamicResource DangerText}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusRow}"
                Margin="0,6,0,6"
                Padding="10,8">
            <DockPanel LastChildFill="True">
                <mi:MaterialIcon DockPanel.Dock="Left"
                                 Kind="AlertCircleOutline"
                                 Width="15" Height="15"
                                 Margin="0,1,8,0"
                                 VerticalAlignment="Top"
                                 Foreground="{DynamicResource DangerText}" />
                <TextBlock Text="{Binding LaunchProblem}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontMd}"
                           LineHeight="17"
                           Foreground="{DynamicResource DangerText}" />
            </DockPanel>
        </Border>

        <!-- What the tile had to be launched as. It *is* running below, so this can be put away —
             and it is drawn on the accent rather than the danger colour, because nothing failed. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasLaunchNotice}"
                Background="{DynamicResource BgElevated}"
                BorderBrush="{DynamicResource AccentOutline}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusRow}"
                Margin="0,6,0,6"
                Padding="10,8">
            <DockPanel LastChildFill="True">
                <mi:MaterialIcon DockPanel.Dock="Left"
                                 Kind="InformationOutline"
                                 Width="15" Height="15"
                                 Margin="0,1,8,0"
                                 VerticalAlignment="Top"
                                 Foreground="{DynamicResource AccentHover}" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding DismissLaunchNoticeCommand}"
                        Classes="outlined-sm"
                        Margin="10,0,0,0"
                        VerticalAlignment="Top"
                        Content="Dismiss" />
                <TextBlock Text="{Binding LaunchNotice}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontMd}"
                           LineHeight="17"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" />
            </DockPanel>
        </Border>

        <!-- ======== How full the model's context is ========
             The Agent tile's bar, the Agent tile's wording and the Agent tile's style
             (Border.context-bar in Controls.axaml) — because it is the same figure about the same
             conversation, and only where it is read from differs. Here it comes out of the CLI's own
             session store, since a TUI paints these numbers into a footer no host can read off a
             pseudo-terminal.

             Docked below the terminal rather than drawn over it: the terminal is the tile's content and
             something floating in its bottom corner sits on top of whatever the agent is printing.

             It takes its strip from the first frame, saying that nothing is known yet, wherever a
             reading can ever arrive (ContextGaugeViewModel.KeepsItsPlace). Appearing with the first
             figure instead would push the terminal up one line mid-turn, which here is not a nudge:
             the cell grid is remeasured and the shell reflows. A plain shell answers null, and so does
             an agent whose CLI keeps no readable store (agy, Grok) — neither loses a line to a sentence
             that would never stop being true.

             The bar itself is hidden separately from the figures: four of the five CLIs that count
             tokens never name the window, so until a provider supplies one there is a count to show and
             nothing to draw it against.

             The negative margin undoes TerminalTileViewModel.ContentInset for this one strip, and it is
             the rule LeafTileView.UpdateContentBackground already states rather than an exception to it:
             a terminal is text against an edge and wants the gap, while chrome runs to the card's edge
             and takes its corners from the clip. Inside the inset this bar was the same bar as the Agent
             tile's drawn 6px short on three sides, with its hairline stopping before the card did. -->
        <Border DockPanel.Dock="Bottom" Classes="context-bar"
                Margin="-6,0,-6,-6"
                DataContext="{Binding ContextGauge}"
                IsVisible="{Binding IsDrawn, FallbackValue=False}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource TermFontSm}"
                           FontFamily="{DynamicResource TerminalFontFamily}"
                           Foreground="{DynamicResource TextMuted}"
                           Text="{Binding BarText}" />
                <v:UsageBar Height="6" VerticalAlignment="Center"
                            UsedPercent="{Binding UsedPercent}"
                            IsVisible="{Binding UsedPercent, Converter={x:Static ObjectConverters.IsNotNull}}"
                            TrackBrush="{DynamicResource BgElevated}"
                            FillBrush="{DynamicResource StatusSuccess}"
                            OverBrush="{DynamicResource DangerText}"
                            RampFromPercent="40"
                            ToolTip.Tip="How much of the model's context window this conversation has used" />
            </DockPanel>
        </Border>

        <!-- TerminalControl created in code-behind for caching -->
        <ContentControl x:Name="TerminalHost" />
    </DockPanel>
    <local:FileDropHint x:Name="DropHint" Text="Drop to insert the path"
                        FontSize="{DynamicResource FontMd}" />
  </Panel>
</UserControl>