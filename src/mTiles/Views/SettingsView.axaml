<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:m="using:mTiles.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="mTiles.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="ComboOptionTemplate" DataType="m:ComboOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Panel IsVisible="{Binding Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusSuccessText}"
                             IsVisible="{Binding IsAvailable}" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerText}"
                             IsVisible="{Binding !IsAvailable}" />
                </Panel>
                <TextBlock Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
        <!-- Shared by the toggle's two states. Says where it applies, because it does not apply
             everywhere: the entry is written by the Git tile, so a workspace without one is untouched. -->
        <StackPanel x:Key="WorkspaceIgnoreCaption" x:Shared="False">
            <TextBlock Text="Add .mtiles to .gitignore" Classes="label" />
            <TextBlock Text="Written to each workspace that has a Git tile open, keeping this app's state out of your repository"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </UserControl.Resources>

    <!--
        DockPanel, and the ScrollViewer lives here rather than around this whole view: docking to the
        bottom inside a scroller pins the bar to the bottom of the *content*, which is the same as not
        pinning it at all. The bar is declared first because DockPanel gives the last child the rest of
        the space — order is the layout here, not decoration.
    -->
    <Panel>
    <DockPanel>

        <!--
            Pinned save bar. Only the database form needs one: everything else in Settings persists as
            you type, while this restarts the database service and so has to be deliberate — which is
            what makes an unapplied edit easy to walk away from. Shown on every tab, not just the
            database one, precisely because leaving the tab is when it would be forgotten.
        -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasUnsavedDatabaseChanges}"
                Background="{DynamicResource BgElevated}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="{DynamicResource BorderTop}"
                Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Classes="accent"
                        Command="{Binding SaveDatabaseSettingsCommand}"
                        Content="Save &amp; Apply"
                        Padding="16,5" />
                <TextBlock Text="Unsaved database changes — saving restarts the database service"
                           FontSize="{DynamicResource FontXs}"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Panel>

            <!-- ═══════════════ TAB: General ═══════════════ -->
            <StackPanel Spacing="12" Margin="20,16,20,24"
                        IsVisible="{Binding IsGeneralTab}">

                <!-- Default Shell -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DEFAULT SHELL" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <ComboBox Classes="setting"
                                      SelectedItem="{Binding SelectedShell}"
                                      ItemsSource="{Binding ShellOptions}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel Spacing="6">
                    <TextBlock Text="APPEARANCE" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <DockPanel>
                                <TextBlock Text="Color Theme" Classes="label"
                                           VerticalAlignment="Center" Width="90" />
                                <ComboBox Classes="setting"
                                          SelectedItem="{Binding ColorThemeName}"
                                          ItemsSource="{x:Static vm:SettingsViewModel.ColorThemeNames}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Font Family" Classes="label"
                                           VerticalAlignment="Center" Width="90" />
                                <TextBox Classes="setting"
                                         Text="{Binding FontFamily}"
                                         PlaceholderText="Font family" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Font Size" Classes="label"
                                           VerticalAlignment="Center" Width="90" />
                                <NumericUpDown Classes="setting"
                                               Value="{Binding FontSize}" Minimum="8" Maximum="48" Increment="1" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Terminal -->
                <StackPanel Spacing="6">
                    <TextBlock Text="TERMINAL" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <DockPanel>
                                <TextBlock Text="Font Family" Classes="label"
                                           VerticalAlignment="Center" Width="90" />
                                <TextBox Classes="setting"
                                         Text="{Binding TerminalFontFamily}"
                                         PlaceholderText="Font family" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Font Size" Classes="label"
                                           VerticalAlignment="Center" Width="90" />
                                <NumericUpDown Classes="setting"
                                               Value="{Binding TerminalFontSize}" Minimum="8" Maximum="48" Increment="1" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Git -->
                <StackPanel Spacing="6">
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="GIT" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                            <Button Classes="header-action"
                                    Command="{Binding DetectGitCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" />
                                    <TextBlock Text="Detect" />
                                </StackPanel>
                            </Button>
                            <Button Classes="header-action"
                                    Command="{Binding OpenGitDownloadCommand}"
                                    ToolTip.Tip="https://git-scm.com"
                                    IsVisible="{Binding !GitFound}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="Download" Width="14" Height="14" />
                                    <TextBlock Text="Get Git" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Git tool card -->
                    <Border CornerRadius="{DynamicResource RadiusLg}"
                            ClipToBounds="True">
                        <Border Background="{DynamicResource BgSurface}" Padding="0">
                            <DockPanel>
                                <Panel DockPanel.Dock="Left" Width="3">
                                    <Border Background="{DynamicResource StatusSuccess}"
                                            IsVisible="{Binding GitFound}" />
                                    <Border Background="{DynamicResource BorderSubtle}"
                                            IsVisible="{Binding !GitFound}" />
                                </Panel>
                                <Border Padding="12,9,10,9">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    Spacing="2" VerticalAlignment="Center">
                                            <Border CornerRadius="{DynamicResource RadiusSm}"
                                                    Padding="6,2"
                                                    Background="{DynamicResource StatusSuccessSubtle}"
                                                    IsVisible="{Binding GitPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="CUSTOM" FontSize="9"
                                                           FontWeight="SemiBold"
                                                           LetterSpacing="0.8"
                                                           Foreground="{DynamicResource StatusSuccessText}" />
                                            </Border>
                                            <Border CornerRadius="{DynamicResource RadiusSm}"
                                                    Padding="6,2"
                                                    Background="{DynamicResource StatusMutedSubtle}"
                                                    IsVisible="{Binding !GitFound}">
                                                <TextBlock Text="NOT FOUND" FontSize="9"
                                                           FontWeight="SemiBold"
                                                           LetterSpacing="0.8"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </Border>
                                            <Button Classes="tile-btn"
                                                    Command="{Binding BrowseGitPathCommand}"
                                                    ToolTip.Tip="Set custom path">
                                                <mi:MaterialIcon Kind="DotsHorizontal" Width="13" Height="13" />
                                            </Button>
                                            <Button Classes="tile-btn"
                                                    Command="{Binding ResetGitPathCommand}"
                                                    ToolTip.Tip="Reset to auto-detect"
                                                    IsVisible="{Binding GitPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <mi:MaterialIcon Kind="Refresh" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource StatusSuccess}"
                                                         IsVisible="{Binding GitFound}" />
                                                <Ellipse Width="8" Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource DangerText}"
                                                         IsVisible="{Binding !GitFound}" />
                                                <TextBlock Text="Git"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding GitVersion}"
                                                           FontSize="{DynamicResource FontSm}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Opacity="0.8"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding GitFound}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="git"
                                                           FontSize="{DynamicResource FontXs}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontFamily="{DynamicResource UiFontFamily}" />
                                                <TextBlock Text="·"
                                                           FontSize="{DynamicResource FontXs}"
                                                           Foreground="{DynamicResource TextFaint}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding GitDetectedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <TextBlock Text="{Binding GitDetectedPath}"
                                                           FontSize="{DynamicResource FontXs}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding GitDetectedPath}"
                                                           IsVisible="{Binding GitDetectedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Border>

                    <!-- Git settings -->
                    <Border Classes="settings-group">
                        <DockPanel>
                            <!-- The caption is the switch's own content, so clicking the words
                                 toggles it: text sitting next to a control is text people try
                                 to click. One template for both states rather than two copies
                                 of the same label — the wording is true either way. -->
                            <ToggleSwitch IsChecked="{Binding GitIgnoreWorkspaceDir}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          OnContent="{StaticResource WorkspaceIgnoreCaption}"
                                          OffContent="{StaticResource WorkspaceIgnoreCaption}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- About. The notices are not decoration: parts of this application are ports of
                     MIT-licensed code, and the speech model it downloads is CC-BY-4.0. Both require the
                     attribution to reach whoever received the software. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="ABOUT" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Classes="outlined-sm"
                                    Content="Open"
                                    MinWidth="70"
                                    Command="{Binding OpenThirdPartyNoticesCommand}" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Third-party notices"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="{DynamicResource UiFontSizeSm}"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Licences and attribution for the code, libraries and speech models this application uses."
                                           TextWrapping="Wrap"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Settings as a file. On General because what it carries is the whole dialog, not
                     one page of it. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="SETTINGS FILE" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="outlined-sm"
                                        Command="{Binding ExportSettingsCommand}"
                                        Content="Export…" />
                                <Button Classes="outlined-sm"
                                        Command="{Binding ImportSettingsCommand}"
                                        Content="Import…" />
                            </StackPanel>
                            <TextBlock Text="{Binding ExportSecretsNote}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- ═══════════════ TAB: AI ═══════════════ -->
            <StackPanel Spacing="12" Margin="20,16,20,24"
                        IsVisible="{Binding IsAiTab}">

                <StackPanel Spacing="6">
                    <DockPanel>
                        <TextBlock Text="AGENTS" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Classes="header-action"
                                Command="{Binding AddAgentInstanceCommand}"
                                ToolTip.Tip="Another way of running an agent">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding AgentInstances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiAgentInstanceViewModel">
                                <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
                                        Margin="0,0,0,3">
                                    <Border Background="{DynamicResource BgSurface}" Padding="12,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="outlined-sm"
                                                        IsVisible="{Binding CanBeInstalled}"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).InstallAgentCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Install…"
                                                        ToolTip.Tip="Shows the command, then runs it in a terminal tile" />
                                                <Button Classes="tile-btn"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditAgentInstanceCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Edit">
                                                    <mi:MaterialIcon Kind="Pencil" Width="13" Height="13" />
                                                </Button>
                                                <Button Classes="tile-btn-close"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteAgentInstanceCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete">
                                                    <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding AgentName}"
                                                               FontSize="{DynamicResource FontXs}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                    <!-- A chip because it is the rare exception: most
                                                         rows are installed and say nothing at all. -->
                                                    <Border CornerRadius="{DynamicResource RadiusSm}"
                                                            Padding="4,0"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsInstalled}"
                                                            Background="{DynamicResource StatusMutedSubtle}">
                                                        <TextBlock Text="NOT INSTALLED" FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DangerText}" />
                                                    </Border>
                                                    <!-- The other reason a row is not offered on a
                                                         tile, and the one nothing else can say. -->
                                                    <Border CornerRadius="{DynamicResource RadiusSm}"
                                                            Padding="4,0"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsUnavailable}"
                                                            ToolTip.Tip="{Binding UnavailableNote}"
                                                            Background="{DynamicResource StatusMutedSubtle}">
                                                        <TextBlock Text="UNAVAILABLE" FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DangerText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="{DynamicResource FontXs}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding ShowsSignIns}">
                    <DockPanel>
                        <TextBlock Text="SIGN-INS" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Classes="header-action"
                                Command="{Binding AddSignInCommand}"
                                IsVisible="{Binding CanAddSignIn}"
                                ToolTip.Tip="A second subscription, kept in its own directory">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <TextBlock IsVisible="{Binding HasNoSignIns}"
                               Text="One account per tool is what you already have. Add one to run a second subscription - it gets its own directory, and you sign into it once in a tile."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontXs}"
                               Foreground="{DynamicResource TextMuted}" />

                    <ItemsControl ItemsSource="{Binding SignIns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiSignInViewModel">
                                <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
                                        Margin="0,0,0,3">
                                    <Border Background="{DynamicResource BgSurface}" Padding="12,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        Spacing="6" VerticalAlignment="Center">
                                                <!-- The row that can be acted on carries the action:
                                                     "not signed in" is a state with a way out, and
                                                     naming the lack without offering the fix would
                                                     send the user looking for a terminal. -->
                                                <Button Classes="outlined-sm"
                                                        Content="Sign in"
                                                        IsVisible="{Binding CanSignIn}"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SignInCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Opens a tile to log in with" />
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="tile-btn"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditSignInCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Rename">
                                                        <mi:MaterialIcon Kind="Pencil" Width="13" Height="13" />
                                                    </Button>
                                                    <Button Classes="tile-btn-close"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteSignInCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Removes the row - the login stays on disk">
                                                        <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="{DynamicResource FontXs}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="A sign-in is a directory the tool logs into by itself. It carries its own conversation history, and none of your global CLAUDE.md, commands or MCP servers."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontXs}"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <DockPanel>
                        <TextBlock Text="PROVIDERS" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Classes="header-action"
                                Command="{Binding AddProviderInstanceCommand}"
                                ToolTip.Tip="A key and an address an agent can be pointed at">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <TextBlock IsVisible="{Binding HasNoProviderInstances}"
                               Text="Nothing configured — every agent runs on whatever account it is logged in as. Add one to run an agent through OpenRouter, z.ai, or a server on this machine."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontXs}"
                               Foreground="{DynamicResource TextMuted}" />

                    <ItemsControl ItemsSource="{Binding ProviderInstances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiProviderInstanceViewModel">
                                <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
                                        Margin="0,0,0,3">
                                    <Border Background="{DynamicResource BgSurface}" Padding="12,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        Spacing="2" VerticalAlignment="Center">
                                                <Button Classes="tile-btn"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditProviderInstanceCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Edit">
                                                    <mi:MaterialIcon Kind="Pencil" Width="13" Height="13" />
                                                </Button>
                                                <Button Classes="tile-btn-close"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteProviderInstanceCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Delete">
                                                    <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="{DynamicResource FontXs}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="A key reaches the agent through its process environment, and an agent has a shell tool — it is not a secret from whoever is using this machine."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontXs}"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

            </StackPanel>

            <!-- ═══════════════ TAB: Database ═══════════════ -->
            <StackPanel Spacing="12" Margin="20,16,20,24"
                        IsVisible="{Binding IsDatabaseTab}">

                <!-- Sub-tab strip -->
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,2">
                    <Button Classes="settings-tab"
                            Classes.settings-tab-active="{Binding IsDbConfigSubTab}"
                            Command="{Binding SelectDbSubTabCommand}"
                            CommandParameter="{StaticResource Zero}"
                            Content="Config" />
                    <Button Classes="settings-tab"
                            Classes.settings-tab-active="{Binding IsDbDatabasesSubTab}"
                            Command="{Binding SelectDbSubTabCommand}"
                            CommandParameter="{StaticResource One}"
                            Content="Databases" />
                </StackPanel>

                <!-- ── Sub-tab 0: Config ── -->
                <StackPanel Spacing="12" IsVisible="{Binding IsDbConfigSubTab}">

                <!-- Enable toggle -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DATABASE SERVICE" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <DockPanel>
                                <TextBlock Text="Enable" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <ToggleSwitch IsChecked="{Binding DbEnabled}"
                                              OnContent="On" OffContent="Off" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="HTTP Port" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <NumericUpDown Classes="setting"
                                                   Value="{Binding DbHttpPort}"
                                                   Minimum="1024" Maximum="65535" Increment="1" />
                                    <TextBlock Text="{Binding DbPortError}"
                                               IsVisible="{Binding DbPortError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource DangerText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Scan Interval" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <NumericUpDown Classes="setting"
                                                   Value="{Binding DbDiscoveryInterval}"
                                                   Minimum="1" Maximum="1440" Increment="5" />
                                    <TextBlock Text="min"
                                               FontSize="{DynamicResource FontSm}"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SQL Server -->
                <StackPanel Spacing="6">
                    <TextBlock Text="SQL SERVER" Classes="section" Margin="0" />
                    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True">
                        <Border Background="{DynamicResource BgSurface}" Padding="0">
                            <DockPanel>
                                <Panel DockPanel.Dock="Left" Width="3">
                                    <Border Background="{DynamicResource StatusSuccess}"
                                            IsVisible="{Binding DbSqlServerEnabled}" />
                                    <Border Background="{DynamicResource BorderSubtle}"
                                            IsVisible="{Binding !DbSqlServerEnabled}" />
                                </Panel>
                                <Border Padding="12,10">
                                    <StackPanel Spacing="10">
                                        <DockPanel>
                                            <TextBlock Text="Discovery" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <ToggleSwitch IsChecked="{Binding DbSqlServerEnabled}"
                                                          OnContent="On" OffContent="Off" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Auth" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <ToggleSwitch IsChecked="{Binding DbSqlServerIntegrated}"
                                                          OnContent="Windows Auth" OffContent="SQL Auth" />
                                        </DockPanel>
                                        <DockPanel IsVisible="{Binding !DbSqlServerIntegrated}">
                                            <TextBlock Text="Username" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <TextBox Classes="setting"
                                                     Text="{Binding DbSqlServerUsername}"
                                                     PlaceholderText="sa" />
                                        </DockPanel>
                                        <DockPanel IsVisible="{Binding !DbSqlServerIntegrated}">
                                            <TextBlock Text="Password" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <TextBox Classes="setting"
                                                     Text="{Binding DbSqlServerPassword}"
                                                     PasswordChar="●"
                                                     PlaceholderText="Password" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- PostgreSQL -->
                <StackPanel Spacing="6">
                    <TextBlock Text="POSTGRESQL" Classes="section" Margin="0" />
                    <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True">
                        <Border Background="{DynamicResource BgSurface}" Padding="0">
                            <DockPanel>
                                <Panel DockPanel.Dock="Left" Width="3">
                                    <Border Background="{DynamicResource StatusSuccess}"
                                            IsVisible="{Binding DbPostgreSqlEnabled}" />
                                    <Border Background="{DynamicResource BorderSubtle}"
                                            IsVisible="{Binding !DbPostgreSqlEnabled}" />
                                </Panel>
                                <Border Padding="12,10">
                                    <StackPanel Spacing="10">
                                        <DockPanel>
                                            <TextBlock Text="Discovery" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <ToggleSwitch IsChecked="{Binding DbPostgreSqlEnabled}"
                                                          OnContent="On" OffContent="Off" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Username" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <TextBox Classes="setting"
                                                     Text="{Binding DbPostgreSqlUsername}"
                                                     PlaceholderText="postgres (empty = no auth)" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Password" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <TextBox Classes="setting"
                                                     Text="{Binding DbPostgreSqlPassword}"
                                                     PasswordChar="●"
                                                     PlaceholderText="Password" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Ports" Classes="label"
                                                       VerticalAlignment="Center" Width="120" />
                                            <TextBox Classes="setting"
                                                     Text="{Binding DbPostgreSqlPorts}"
                                                     PlaceholderText="5432, 5433, 5434" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Border>
                </StackPanel>

                </StackPanel> <!-- /Sub-tab 0: Config -->

                <!-- ── Sub-tab 1: Databases ── -->
                <StackPanel Spacing="12" IsVisible="{Binding IsDbDatabasesSubTab}">

                <!-- Manual Connections -->
                <StackPanel Spacing="6">
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="MANUAL CONNECTIONS" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Classes="header-action"
                                Command="{Binding AddManualConnectionCommand}"
                                ToolTip.Tip="Add a database this scan cannot find">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding ManualConnections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManualConnectionViewModel">
                                <Border CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
                                        Margin="0,0,0,3">
                                    <Border Background="{DynamicResource BgSurface}" Padding="0">
                                        <DockPanel>
                                            <Border Padding="12,8">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                Spacing="2" VerticalAlignment="Center">
                                                        <Button Classes="tile-btn"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).TestManualConnectionCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Test connection">
                                                            <mi:MaterialIcon Kind="PlayCircleOutline" Width="13" Height="13" />
                                                        </Button>
                                                        <Button Classes="tile-btn"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditManualConnectionCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Edit">
                                                            <mi:MaterialIcon Kind="Pencil" Width="13" Height="13" />
                                                        </Button>
                                                        <Button Classes="tile-btn-close"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteManualConnectionCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Delete">
                                                            <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimary}" />
                                                            <Border CornerRadius="{DynamicResource RadiusSm}"
                                                                    Padding="4,0"
                                                                    Background="{DynamicResource StatusMutedSubtle}">
                                                                <TextBlock Text="{Binding ProviderShort}" FontSize="8"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextMuted}" />
                                                            </Border>
                                                            <TextBlock Text="testing..."
                                                                       FontSize="{DynamicResource FontSm}"
                                                                       Foreground="{DynamicResource AccentDefault}"
                                                                       FontStyle="Italic"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsTesting}" />
                                                            <TextBlock Text="{Binding TestResult}"
                                                                       FontSize="{DynamicResource FontSm}"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding TestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="{DynamicResource FontXs}"
                                                                   Foreground="{DynamicResource TextFaint}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                                    <Binding Path="DisplayServer" />
                                                                    <Binding Path="Database" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add button -->

                    <!-- Edit form -->
                </StackPanel>

                <!-- Detected Databases -->
                <StackPanel Spacing="6">
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="DATABASES" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                            <Button Classes="header-action"
                                    Command="{Binding RunDiscoveryNowCommand}"
                                    IsEnabled="{Binding !IsDiscoveryRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" />
                                    <TextBlock Text="Rescan" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Filter -->
                    <TextBox Text="{Binding DbFilterText, Mode=TwoWay}"
                             PlaceholderText="Filter databases..."
                             IsVisible="{Binding !!DiscoveredDatabases.Count}"
                             Padding="6,3"
                             FontSize="{DynamicResource FontSm}">
                        <TextBox.InnerRightContent>
                            <Button Classes="ghost"
                                    Command="{Binding ClearDbFilterCommand}"
                                    IsVisible="{Binding DbFilterText.Length}"
                                    Padding="2" Margin="0,0,2,0"
                                    MinWidth="16" MinHeight="16">
                                <mi:MaterialIcon Kind="Close" Width="10" Height="10" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Scanning indicator -->
                    <TextBlock Text="Scanning..."
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="{DynamicResource FontSm}"
                               FontStyle="Italic"
                               IsVisible="{Binding IsDiscoveryRunning}" />

                    <!-- Empty state -->
                    <TextBlock Text="No databases detected. Enable discovery above, or add manual connections."
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="{DynamicResource FontSm}"
                               TextWrapping="Wrap"
                               Margin="0,2"
                               IsVisible="{Binding !DiscoveredDatabases.Count}" />

                    <ItemsControl ItemsSource="{Binding FilteredDiscoveredDatabases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DatabaseItemViewModel">
                                <Border CornerRadius="{DynamicResource RadiusLg}"
                                        ClipToBounds="True"
                                        Margin="0,0,0,3">
                                    <Border Background="{DynamicResource BgSurface}" Padding="0">
                                        <DockPanel>
                                            <!-- Left status strip — green for manual, accent for discovered -->
                                            <Panel DockPanel.Dock="Left" Width="3">
                                                <Border Background="{DynamicResource TileAccentDatabase}" />
                                                <Border Background="{DynamicResource StatusSuccess}"
                                                        IsVisible="{Binding SourceType, Converter={x:Static vm:SettingsViewModel.IsManualSourceConverter}}" />
                                            </Panel>

                                            <Border Padding="12,9,10,9">
                                                <DockPanel>
                                                    <!-- Right: badges -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                Spacing="4" VerticalAlignment="Center">
                                                        <!-- Provider badge -->
                                                        <Border CornerRadius="{DynamicResource RadiusSm}"
                                                                Padding="6,2"
                                                                Background="{DynamicResource StatusMutedSubtle}">
                                                            <TextBlock Text="{Binding Provider}" FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       LetterSpacing="0.8"
                                                                       Foreground="{DynamicResource TextMuted}" />
                                                        </Border>
                                                        <!-- Source badge -->
                                                        <Border CornerRadius="{DynamicResource RadiusSm}"
                                                                Padding="6,2"
                                                                Background="{DynamicResource StatusSuccessSubtle}"
                                                                IsVisible="{Binding SourceType, Converter={x:Static vm:SettingsViewModel.IsManualSourceConverter}}">
                                                            <TextBlock Text="MANUAL" FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       LetterSpacing="0.8"
                                                                       Foreground="{DynamicResource StatusSuccessText}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Left: info -->
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Server}"
                                                                   FontSize="{DynamicResource FontXs}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding HasAlias}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                </StackPanel> <!-- /Sub-tab 1: Databases -->

            </StackPanel>

            <!-- ═══════════════ TAB: Speech ═══════════════ -->
            <StackPanel Spacing="12" Margin="20,16,20,24"
                        IsVisible="{Binding IsSpeechTab}">

                <!-- Dictation -->
                <StackPanel Spacing="6">
                    <DockPanel>
                        <!-- The same walk-through the first run offers: a model, a microphone, and a
                             sentence to prove them. Here it is the way to start over. -->
                        <Button DockPanel.Dock="Right"
                                Classes="outlined-sm"
                                Content="Set up dictation…"
                                Command="{Binding SetUpSpeechCommand}" />
                        <TextBlock Text="DICTATION" Classes="section" Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Speech recognition runs on this machine. Nothing is sent anywhere; the model is a file you download once."
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="No audio input backend is available on this machine."
                                       IsVisible="{Binding !IsSpeechAvailable}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource DangerText}"
                                       TextWrapping="Wrap" />
                            <DockPanel>
                                <TextBlock Text="Enable" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <ToggleSwitch IsChecked="{Binding SpeechEnabled}"
                                              OnContent="On" OffContent="Off" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Shortcut" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Classes="outlined-sm"
                                                Content="Clear"
                                                MinWidth="60"
                                                Margin="6,0,0,0"
                                                IsVisible="{Binding SpeechHotkey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Command="{Binding ClearSpeechHotkeyCommand}"
                                                ToolTip.Tip="Turn the shortcut off" />
                                        <TextBox x:Name="SpeechHotkeyBox"
                                                 Classes="setting"
                                                 Text="{Binding SpeechHotkey}"
                                                 PlaceholderText="No shortcut — click and press a combination"
                                                 IsReadOnly="True"
                                                 KeyDown="SpeechHotkey_KeyDown"
                                                 GotFocus="SpeechHotkey_GotFocus"
                                                 LostFocus="SpeechHotkey_LostFocus"
                                                 ToolTip.Tip="Click here and press the key combination" />
                                    </DockPanel>
                                    <TextBlock Text="Click the box and press the combination. Hold it to record; release to transcribe. Clear it — or press Backspace here — to leave the key to the shell."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SpeechHotkeyWarning}"
                                               IsVisible="{Binding SpeechHotkeyWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource DangerText}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Unload model" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <NumericUpDown Classes="setting"
                                                       Value="{Binding SpeechUnloadMinutes}"
                                                       Minimum="0"
                                                       Maximum="{x:Static m:SpeechSettings.MaxUnloadMinutesForUi}"
                                                       Increment="1" />
                                        <TextBlock Text="min"
                                                   FontSize="{DynamicResource FontSm}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Idle time before the model leaves memory — it is hundreds of megabytes. Zero keeps it loaded, which saves a second or two on the next dictation."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Hold to talk" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding SpeechPushToTalk}"
                                                  OnContent="Hold" OffContent="Toggle" />
                                    <TextBlock Text="Hold: record while the keys are down. Toggle: one press starts, the next stops."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Phone -->
                <StackPanel Spacing="6">
                    <TextBlock Text="PHONE" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Dictate into a tile from a phone on your network, or from a browser on the machine in front of you. Open the panel from the QR button beside this Settings button. Recognition still runs on this machine; the audio travels encrypted between your own two devices."
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" />
                            <DockPanel>
                                <TextBlock Text="Keep running" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding PhoneEnabled}"
                                                  OnContent="On" OffContent="Off" />
                                    <TextBlock Text="Off: the bridge listens only while the QR panel is open or a phone is paired. On: it starts with mTiles, so a paired phone reconnects on its own."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Port" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <NumericUpDown Classes="setting"
                                                   Value="{Binding PhonePort}"
                                                   Minimum="0" Maximum="65535"
                                                   Increment="1"
                                                   FormatString="0" />
                                    <TextBlock Text="0 picks a free port automatically. Any other number is a preference: if Windows has reserved it — Hyper-V and WSL claim blocks of ports at boot — the bridge quietly takes a free one instead and the panel says which. Applied a moment after you stop typing; the bridge restarts and any QR code on screen must be scanned again."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Press Enter" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding PhoneAutoSubmit}"
                                                  OnContent="Yes" OffContent="No" />
                                    <TextBlock Text="Runs what you dictated from the phone straight away. Separate from the keyboard setting: holding a phone, you are usually not looking at the screen."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Input -->
                <StackPanel Spacing="6">
                    <TextBlock Text="INPUT" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <DockPanel>
                                <TextBlock Text="Microphone" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <Button DockPanel.Dock="Right" Classes="tile-btn"
                                        Command="{Binding RefreshSpeechDevicesCommand}"
                                        ToolTip.Tip="Rescan devices"
                                        Margin="6,0,0,0">
                                    <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                </Button>
                                <ComboBox Classes="setting"
                                          SelectedItem="{Binding SpeechDevice}"
                                          ItemsSource="{Binding SpeechDevices}" />
                            </DockPanel>
                            <TextBlock Text="Parakeet works the language out by itself across the 25 it knows, and cannot translate — the settings below apply to Whisper models."
                                       IsVisible="{Binding !HasWhisperOnlyOptions}"
                                       FontSize="{DynamicResource FontXs}"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap" />
                            <DockPanel IsVisible="{Binding HasWhisperOnlyOptions}">
                                <TextBlock Text="Language" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <ComboBox Classes="setting"
                                          SelectedItem="{Binding SelectedSpeechLanguage}"
                                          ItemsSource="{Binding SpeechLanguages}"
                                          ItemTemplate="{StaticResource ComboOptionTemplate}" />
                            </DockPanel>
                            <DockPanel IsVisible="{Binding HasWhisperOnlyOptions}">
                                <TextBlock Text="Translate" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding SpeechTranslateToEnglish}"
                                                  OnContent="To English" OffContent="Off" />
                                    <TextBlock Text="Transcribe into English whatever language was spoken."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Text -->
                <StackPanel Spacing="6">
                    <TextBlock Text="TEXT" Classes="section" Margin="0" />
                    <Border Classes="settings-group">
                        <StackPanel Spacing="10">
                            <DockPanel>
                                <TextBlock Text="Press Enter" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <StackPanel>
                                    <ToggleSwitch IsChecked="{Binding SpeechAutoSubmit}"
                                                  OnContent="On" OffContent="Off" />
                                    <TextBlock Text="Submits the dictated line straight away. A misheard word then runs as a command."
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Trailing space" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <ToggleSwitch IsChecked="{Binding SpeechAppendTrailingSpace}"
                                              OnContent="On" OffContent="Off" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Remove fillers" Classes="label"
                                           VerticalAlignment="Center" Width="120" />
                                <ToggleSwitch IsChecked="{Binding SpeechRemoveFillerWords}"
                                              OnContent="On" OffContent="Off" />
                            </DockPanel>
                            <!-- Whisper only: the hint is its initial prompt, and Parakeet
                                 takes no prompt at all. Hidden rather than ignored. -->
                            <StackPanel Spacing="4" IsVisible="{Binding HasWhisperOnlyOptions}">
                                <TextBlock Text="Vocabulary" Classes="label" />
                                <TextBox Classes="setting"
                                         Text="{Binding SpeechCustomWords}"
                                         PlaceholderText="Names and jargon, comma separated" />
                                <TextBlock Text="Given to the model as a hint before it listens, which biases it towards these words."
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Models -->
                <StackPanel Spacing="6">
                    <DockPanel>
                        <TextBlock Text="MODEL" Classes="section" Margin="0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Classes="tile-btn"
                                Command="{Binding OpenSpeechModelsFolderCommand}"
                                ToolTip.Tip="Show the models folder"
                                HorizontalAlignment="Right">
                            <mi:MaterialIcon Kind="FolderOpen" Width="14" Height="14" />
                        </Button>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SpeechModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SpeechModelViewModel">
                                <Border Background="{DynamicResource BgSurface}"
                                        CornerRadius="{DynamicResource RadiusLg}"
                                        Margin="0,0,0,6"
                                        ClipToBounds="True">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="3"
                                                Background="{DynamicResource AccentDefault}"
                                                IsVisible="{Binding IsInUse}" />
                                        <Border Padding="12,10">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            Spacing="4" VerticalAlignment="Center">
                                                    <Button Classes="tile-btn"
                                                            Command="{Binding DownloadCommand}"
                                                            ToolTip.Tip="Download"
                                                            IsVisible="{Binding !IsDownloaded}"
                                                            IsEnabled="{Binding !IsDownloading}">
                                                        <mi:MaterialIcon Kind="Download" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Classes="tile-btn"
                                                            Command="{Binding CancelDownloadCommand}"
                                                            ToolTip.Tip="Cancel download"
                                                            IsVisible="{Binding IsDownloading}">
                                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Classes="tile-btn"
                                                            Command="{Binding SelectCommand}"
                                                            ToolTip.Tip="Use this model"
                                                            IsVisible="{Binding IsDownloaded}">
                                                        <mi:MaterialIcon Kind="Check" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Classes="tile-btn-close"
                                                            Command="{Binding DeleteCommand}"
                                                            ToolTip.Tip="Delete the downloaded file"
                                                            IsVisible="{Binding IsDownloaded}">
                                                        <mi:MaterialIcon Kind="Delete" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   FontSize="{DynamicResource FontXs}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="IN USE"
                                                                   IsVisible="{Binding IsInUse}"
                                                                   FontSize="{DynamicResource FontXs}"
                                                                   LetterSpacing="0.8"
                                                                   Foreground="{DynamicResource StatusSuccessText}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Note}"
                                                               FontSize="{DynamicResource FontXs}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                IsVisible="{Binding IsDownloading}">
                                                        <ProgressBar Minimum="0" Maximum="1" Width="180"
                                                                     Value="{Binding Progress}" />
                                                        <TextBlock Text="{Binding ProgressText}"
                                                                   FontSize="{DynamicResource FontXs}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Error}"
                                                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                               FontSize="{DynamicResource FontXs}"
                                                               Foreground="{DynamicResource DangerText}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>

            </Panel>
        </ScrollViewer>

    </DockPanel>

        <!-- ======== Editing overlay ========
             The three forms that make a new entry — a shell profile, a custom AI tool, a manual
             database connection — open here rather than in the list they belong to.

             As rows of that list they were unusable in a way that only shows at the keyboard: the form
             is taller than the viewport, so opening one pushed the list it came from off screen, and
             the buttons that save it landed below the fold of a page the user had to scroll to reach.
             A form long enough to need scrolling is a task, and a task gets a surface of its own.

             One overlay for all three, and the form inside is the same markup that used to sit in the
             list: they are bound to the view model's own Edit* properties and commands, so this is
             where the form is shown and nothing about what it does. -->
        <Panel x:Name="EditOverlay" IsVisible="{Binding IsEditingAnything}" ZIndex="200">
            <Border Background="{DynamicResource OverlayModal}"
                    PointerPressed="EditOverlay_PointerPressed" />
            <Border Classes="modal-card"
                    MaxWidth="560"
                    MaxHeight="{Binding $parent[Panel].Bounds.Height}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Panel Margin="18,16">
                        <!-- No chrome of its own: the overlay it sits in is the card. A bordered box
                             inside a bordered box is the nesting the design rules exist to stop. -->
                        <!-- A sign-in asks for one thing: what you call it. The directory is derived
                             and the login itself happens in a tile, so a form with a path field on it
                             would be three questions where the user has one answer. -->
                        <Border IsVisible="{Binding IsEditingSignIn}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="SIGN-IN" Classes="section" Margin="0,0,0,2" />
                                <DockPanel>
                                    <TextBlock Text="Name" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditSignInName}"
                                             PlaceholderText="required - work, personal, the bigger plan" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Tool" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <!-- Fixed once the sign-in exists: its directory is named after
                                         the sign-in, not the tool, so switching leaves one CLI's
                                         credentials in a directory belonging to another. -->
                                    <ComboBox ItemsSource="{Binding SignInAgentChoices}"
                                              SelectedItem="{Binding EditSignInAgentName}"
                                              IsEnabled="{Binding CanChooseSignInAgent}"
                                              MinWidth="200" />
                                </DockPanel>
                                <TextBlock Text="Saving makes the directory. You then sign in once, in a tile, with the tool's own login command."
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Classes="accent"
                                            Command="{Binding SaveSignInCommand}"
                                            IsEnabled="{Binding CanSaveSignIn}"
                                            Content="Save"
                                            Padding="16,5" />
                                    <Button Classes="toolbar"
                                            Command="{Binding CancelEditSignInCommand}"
                                            Content="Cancel"
                                            Padding="16,5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsEditingAgentInstance}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="AGENT INSTANCE" Classes="section" Margin="0,0,0,2" />
                                <DockPanel>
                                    <TextBlock Text="Name" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditAgentName}"
                                             PlaceholderText="required - what you call this one" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Agent" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ComboBox ItemsSource="{Binding AgentNames}"
                                              SelectedItem="{Binding EditAgentAgentName}"
                                              MinWidth="200" />
                                </DockPanel>
                                <!-- One chooser, because it is one question: as whom does this run.
                                     A subscription and an API key are two answers to it, and two
                                     fields side by side would let an instance carry both - pointed at
                                     one account directory while authenticating as another. -->
                                <DockPanel>
                                    <TextBlock Text="Account" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ComboBox ItemsSource="{Binding AccountChoices}"
                                              SelectedItem="{Binding EditAgentAccount}"
                                              MinWidth="200" />
                                </DockPanel>
                                <TextBlock IsVisible="{Binding HasNoAccountToChoose}"
                                           Text="{Binding NoAccountNote}"
                                           Margin="98,-4,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <DockPanel>
                                    <TextBlock Text="Model" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <!-- No List button. Fetching is triggered by the one event that
                                         changes the answer - which account this runs as - so a button
                                         to ask again was a step the user had to know about, in front
                                         of a control that gives no sign a list exists at all.

                                         Matching is every typed word anywhere in the id, in any order
                                         (ModelSearch), because ids are punctuated by whoever published
                                         them and the separator is the one part nobody remembers. The
                                         predicate is attached in the code-behind: it is a function,
                                         and XAML has nowhere to put one. -->
                                    <AutoCompleteBox x:Name="AgentModelBox"
                                                     Text="{Binding EditAgentModel}"
                                                     ItemsSource="{Binding ModelSuggestions}"
                                                     FilterMode="Custom"
                                                     MinimumPrefixLength="0"
                                                     PlaceholderText="{Binding ModelHint}" />
                                </DockPanel>
                                <TextBlock IsVisible="{Binding HasModelContext}"
                                           Text="{Binding ModelContextDisplay}"
                                           Margin="98,-6,0,0"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <DockPanel IsVisible="{Binding ShowsFastModel}">
                                    <TextBlock Text="Fast model" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <!-- The same completion as Model above, over the same list: it takes
                                         a model id from the same provider, so a field that could not
                                         complete one was the pair disagreeing about what it holds. -->
                                    <AutoCompleteBox x:Name="AgentFastModelBox"
                                                     Text="{Binding EditAgentFastModel}"
                                                     ItemsSource="{Binding ModelSuggestions}"
                                                     FilterMode="Custom"
                                                     MinimumPrefixLength="0"
                                                     PlaceholderText="{Binding FastModelHint}" />
                                </DockPanel>
                                <TextBlock IsVisible="{Binding HasFastModelContext}"
                                           Text="{Binding FastModelContextDisplay}"
                                           Margin="98,-6,0,0"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <DockPanel IsVisible="{Binding ShowsAutoCompact}">
                                    <TextBlock Text="Auto-compact" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditAgentAutoCompact}"
                                             PlaceholderText="tokens — empty: read from the model" />
                                </DockPanel>
                                <TextBlock IsVisible="{Binding ShowsAutoCompact}"
                                           Text="Claude Code only. When empty, the launch sets CLAUDE_CODE_AUTO_COMPACT_WINDOW to 80% of the model's context window, read from the provider; a value typed here is used as-is."
                                           Margin="98,-4,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <DockPanel IsVisible="{Binding ShowsMaxContext}">
                                    <TextBlock Text="Max context" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditAgentMaxContext}"
                                             PlaceholderText="tokens - empty: read from the provider" />
                                </DockPanel>
                                <TextBlock IsVisible="{Binding ShowsMaxContext}"
                                           Text="Claude Code only. When empty, the launch sets CLAUDE_CODE_MAX_CONTEXT_TOKENS to the model's full context window, read from the provider - without it the CLI assumes 200k and stops there, whatever the model really serves. Corrects the provider's own word too: a value typed here is used as-is."
                                           Margin="98,-4,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <DockPanel>
                                    <TextBlock Text="Behaviour" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ComboBox ItemsSource="{Binding BehaviourLabels}"
                                              SelectedItem="{Binding EditAgentBehaviour}"
                                              MinWidth="200" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Effort" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ComboBox ItemsSource="{Binding EffortLabels}"
                                              SelectedItem="{Binding EditAgentEffort}"
                                              MinWidth="200" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Extra args" Classes="label"
                                               VerticalAlignment="Top" Width="90" Margin="0,6,0,0" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditAgentExtraArgs}"
                                             AcceptsReturn="True"
                                             MinHeight="54"
                                             PlaceholderText="one per line" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Classes="accent"
                                            Command="{Binding SaveAgentInstanceCommand}"
                                            IsEnabled="{Binding CanSaveAgentInstance}"
                                            Content="Save"
                                            Padding="16,5" />
                                    <Button Classes="toolbar"
                                            Command="{Binding CancelEditAgentInstanceCommand}"
                                            Content="Cancel"
                                            Padding="12,5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsEditingProviderInstance}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="PROVIDER" Classes="section" Margin="0,0,0,2" />
                                <DockPanel>
                                    <TextBlock Text="Name" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditProviderName}"
                                             PlaceholderText="required — what you call this one" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Service" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ComboBox ItemsSource="{Binding ProviderKinds}"
                                              SelectedItem="{Binding EditProviderKind}"
                                              MinWidth="200" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Address" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditProviderBaseUrl}"
                                             PlaceholderText="{Binding ProviderAddressHint}" />
                                </DockPanel>
                                <DockPanel IsVisible="{Binding EditProviderNeedsKey}">
                                    <TextBlock Text="API key" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditProviderApiKey}"
                                             PasswordChar="●"
                                             PlaceholderText="{Binding SecretFieldHint}" />
                                </DockPanel>
                                <TextBlock IsVisible="{Binding ShowsProviderKeyWarning}"
                                           Text="{Binding SecretStorageWarning}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource DangerText}" />
                                <TextBlock IsVisible="{Binding !EditProviderNeedsKey}"
                                           Text="This server has no authentication — anyone who can reach it can use it."
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontXs}"
                                           Foreground="{DynamicResource TextMuted}" />
                                <DockPanel>
                                    <TextBlock Text="Timeout" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <NumericUpDown Classes="setting"
                                                   Value="{Binding EditProviderTimeout}"
                                                   Minimum="1" Maximum="600" Increment="5" />
                                </DockPanel>
                                <CheckBox IsVisible="{Binding EditProviderIsLocal}"
                                          IsChecked="{Binding SearchLocalNetwork}"
                                          Content="Also look on this network when discovering" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Classes="accent"
                                            Command="{Binding SaveProviderInstanceCommand}"
                                            IsEnabled="{Binding CanSaveProviderInstance}"
                                            Content="Save"
                                            Padding="16,5" />
                                    <Button Classes="outlined"
                                            Command="{Binding TestProviderCommand}"
                                            IsEnabled="{Binding !IsTestingProvider}"
                                            Content="Test"
                                            Padding="12,5" />
                                    <Button Classes="outlined"
                                            Command="{Binding LoadProviderModelsCommand}"
                                            IsEnabled="{Binding !IsTestingProvider}"
                                            Content="Models"
                                            Padding="12,5" />
                                    <Button Classes="outlined"
                                            IsVisible="{Binding EditProviderIsLocal}"
                                            Command="{Binding DiscoverProviderCommand}"
                                            IsEnabled="{Binding !IsTestingProvider}"
                                            Content="Discover"
                                            Padding="12,5" />
                                    <Button Classes="toolbar"
                                            Command="{Binding CancelEditProviderInstanceCommand}"
                                            Content="Cancel"
                                            Padding="12,5" />
                                </StackPanel>
                                <TextBlock Text="{Binding EditProviderTestResult}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSm}"
                                           Foreground="{DynamicResource TextMuted}"
                                           IsVisible="{Binding EditProviderTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <!-- What the provider answered, so Models proves the address and the
                                     key rather than only counting. Scrolled, because a hosted list runs
                                     to hundreds and would otherwise push Save off the form. -->
                                <ScrollViewer MaxHeight="140"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ModelSuggestions}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsEditingManualConnection}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="CONNECTION" Classes="section" Margin="0,0,0,2" />
                                <DockPanel>
                                    <TextBlock Text="Provider" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ComboBox ItemsSource="{Binding DbProviders}"
                                              SelectedItem="{Binding EditConnProvider}"
                                              MinWidth="160" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Alias" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditConnAlias}"
                                             PlaceholderText="short name for URL (optional)" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Server" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditConnServer}"
                                             PlaceholderText="hostname or IP" />
                                </DockPanel>
                                <DockPanel IsVisible="{Binding IsInstanceVisible}">
                                    <TextBlock Text="Instance" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditConnInstance}"
                                             PlaceholderText="SQL Server instance (optional)" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Database" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditConnDatabase}"
                                             PlaceholderText="Database name" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Port" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <NumericUpDown Classes="setting"
                                                   Value="{Binding EditConnPort}"
                                                   Minimum="0" Maximum="65535" Increment="1"
                                                   PlaceholderText="0 = default" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Auth" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <ToggleSwitch IsChecked="{Binding EditConnIntegrated}"
                                                  OnContent="Windows Auth" OffContent="SQL Auth" />
                                </DockPanel>
                                <DockPanel IsVisible="{Binding !EditConnIntegrated}">
                                    <TextBlock Text="Username" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditConnUsername}"
                                             PlaceholderText="Username" />
                                </DockPanel>
                                <DockPanel IsVisible="{Binding !EditConnIntegrated}">
                                    <TextBlock Text="Password" Classes="label"
                                               VerticalAlignment="Center" Width="90" />
                                    <TextBox Classes="setting"
                                             Text="{Binding EditConnPassword}"
                                             PasswordChar="●"
                                             PlaceholderText="Password" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Classes="accent"
                                            Command="{Binding SaveManualConnectionCommand}"
                                            Content="Save"
                                            Padding="16,5" />
                                    <Button Classes="outlined"
                                            Command="{Binding TestEditConnectionCommand}"
                                            IsEnabled="{Binding !IsTestingEditConn}"
                                            Padding="12,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <mi:MaterialIcon Kind="PlayCircleOutline" Width="14" Height="14" />
                                            <TextBlock Text="Test" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="toolbar"
                                            Command="{Binding CancelEditManualConnectionCommand}"
                                            Content="Cancel"
                                            Padding="12,5" />
                                    <TextBlock Text="{Binding EditConnTestResult}"
                                               FontSize="{DynamicResource FontSm}"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding EditConnTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Panel>
                </ScrollViewer>
            </Border>
        </Panel>
    </Panel>
</UserControl>
