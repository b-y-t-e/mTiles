<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../version.txt').Trim())</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>mterminal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Startup-script assembly (ShellStarter) is internal — hosts of a tile, not an API. The tests
         still need it directly: `${tileId}` substitution is a contract with the user's own profiles. -->
    <InternalsVisibleTo Include="mTiles.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships with the application, not only with the repository. Handy and transcribe-rs are MIT and
         parts of the dictation feature are ports of their code; the Parakeet model is CC-BY-4.0. Both
         licences require the notice to reach whoever receives the software, which a file sitting in a
         git repository does not do. Settings → General opens it. -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\mterminal-icon.png" />
    <AvaloniaResource Include="Assets\mTerminal-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.*" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.*" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Terminal.Avalonia" Version="0.2.1" />
    <PackageReference Include="TodoList.Avalonia" Version="0.2.10" />
    <PackageReference Include="Notepad.Avalonia" Version="0.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.*" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="Velopack" Version="0.0.*" />
    <!-- Dictation. PortAudioSharp2 is the wrapper that ships prebuilt portaudio for win-x64 and
         linux-x64, so recording works on both RIDs without this repository carrying binaries.
         Whisper.net is whisper.cpp, the engine Handy transcribes with, and takes the same ggml models. -->
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Parakeet, the model Handy recommends, is three ONNX graphs and a greedy loop over them. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
  </ItemGroup>

</Project>
