<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DESIGN TOKENS — single source of truth for the app palette.
         Terminal ANSI colors live in TerminalTheme (separate system).
         ============================================================ -->

    <!-- Backgrounds (4 tiers).
         BgCanvas is what the tiles are laid on and nothing else uses: it is the only colour here that
         is *not* meant to be looked at, which is why it is darker than BgBase rather than a shade of
         it. A tile is a card of BgBase floating on it, so the gaps between tiles read as a gap and not
         as a seam — the same reason the splitters are wide enough to see. -->
    <SolidColorBrush x:Key="BgCanvas"    Color="#121220" />
    <SolidColorBrush x:Key="BgBase"      Color="#1a1a2e" />
    <SolidColorBrush x:Key="BgSurface"   Color="#16162a" />
    <SolidColorBrush x:Key="BgElevated"  Color="#1e1e3a" />

    <!-- Borders (2 tiers) -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#2a2a4a" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3a3a5a" />

    <!-- Text (4 tiers + 1 hover) -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#c0c8e0" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8090b0" />
    <SolidColorBrush x:Key="TextMuted"     Color="#6070a0" />
    <SolidColorBrush x:Key="TextFaint"     Color="#3a3a5a" />
    <SolidColorBrush x:Key="TextHover"     Color="#e0e4f0" />

    <!-- Interactive states -->
    <SolidColorBrush x:Key="InteractiveHover"   Color="#2a2a4a" />
    <SolidColorBrush x:Key="InteractivePressed"  Color="#3a3a5a" />
    <SolidColorBrush x:Key="AccentDefault"       Color="#2d5a8a" />
    <SolidColorBrush x:Key="AccentHover"         Color="#3a6fa0" />
    <!-- The accent for a line that goes all the way round something.
         The longer the line, the quieter it has to be to carry the same weight: the active tile's
         marker used to be a 2px strip across the top of its header and is now the card's whole
         perimeter, which is an order of magnitude more of it. In AccentHover that stopped reading as
         "this tile" and started reading as a blue frame drawn round it — loud, and competing with the
         borders the tile's own content already has. Muted far enough to sit in the same family as
         BorderSubtle while still being unmistakably not it. -->
    <SolidColorBrush x:Key="AccentOutline"       Color="#3f5f7d" />
    <!-- What a label is written in when it sits *on* the accent. Not TextPrimary: that is the theme's
         foreground, chosen to be read on the terminal's background, and on a mid-blue button it comes
         out as grey on blue — which is what made the one filled button in the application the hardest
         thing on it to read. Derived from the accent's own luminance in ThemeBridge, because a theme
         with a pale accent needs the opposite answer. -->
    <SolidColorBrush x:Key="AccentForeground"    Color="#f2f6fb" />

    <!-- Tile type accents.
         Raised out of the 40%-lightness band they used to sit in. They were picked when the only thing
         drawn in them was a three-pixel bar on a chooser card and a 22px icon, both against BgSurface;
         a tile header now wears the same colour as a 13px glyph against BgElevated, where the old
         values came out as dark smudges. Bright enough to read at that size, and desaturated enough
         that six of them along a column of headers do not turn it into a paint chart. -->
    <SolidColorBrush x:Key="TileAccentTerminal" Color="#5b9bd5" />
    <SolidColorBrush x:Key="TileAccentNote"     Color="#d4a24c" />
    <SolidColorBrush x:Key="TileAccentTodo"     Color="#57b880" />
    <SolidColorBrush x:Key="TileAccentGit"      Color="#b07ac4" />
    <SolidColorBrush x:Key="TileAccentDatabase" Color="#4fb0c4" />
    <SolidColorBrush x:Key="TileAccentGoal"     Color="#d98a4f" />

    <!-- Goal phase colors -->
    <SolidColorBrush x:Key="GoalPhaseClarify"   Color="#5a7a8a" />
    <SolidColorBrush x:Key="GoalPhasePlan"      Color="#8a7a5a" />
    <SolidColorBrush x:Key="GoalPhaseImplement" Color="#5a8a6a" />
    <SolidColorBrush x:Key="GoalPhaseReview"    Color="#7a5a8a" />
    <SolidColorBrush x:Key="GoalPhaseSummary"   Color="#6a8a5a" />

    <!-- Danger (close/remove hover) -->
    <SolidColorBrush x:Key="DangerSubtle"  Color="#2e1a24" />
    <SolidColorBrush x:Key="DangerText"    Color="#c06878" />

    <!-- Git tags -->
    <SolidColorBrush x:Key="TagColor"      Color="#6DBF8B" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusSuccess"       Color="#4a9a6a" />
    <SolidColorBrush x:Key="StatusSuccessSubtle"  Color="#1a2e24" />
    <SolidColorBrush x:Key="StatusSuccessText"    Color="#6abf8a" />
    <SolidColorBrush x:Key="StatusMutedSubtle"    Color="#252528" />

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayModal"   Color="#80000000" />

    <!-- Typography sizes -->
    <x:Double x:Key="FontLg">16</x:Double>
    <x:Double x:Key="FontMd">12</x:Double>
    <x:Double x:Key="FontSm">11</x:Double>
    <x:Double x:Key="FontXs">10</x:Double>

    <!-- Spacing -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusTile">8</CornerRadius>
    <!-- One radius for every row in a list, at either level of the workspaces panel. It used to be
         RadiusLg for a workspace and RadiusMd for a tile under it, which put three different radii in a
         column 240px wide and made the nesting look like a rendering accident rather than a hierarchy.
         Nesting is said by the indent and the guide beside it; the corners say nothing and should
         therefore say the same thing. -->
    <CornerRadius x:Key="RadiusRow">5</CornerRadius>
    <!-- The radius one border-width inside RadiusTile, for the element that clips a card's content.
         Two concentric rounded rectangles only look concentric when the inner one's radius is the
         outer's less the gap between them; at the same radius the corners visibly diverge. -->
    <CornerRadius x:Key="RadiusTileInner">7</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusLg">6</CornerRadius>
    <CornerRadius x:Key="RadiusXl">10</CornerRadius>

    <!-- Override Fluent theme collapsed scrollbar scale (default: scaleX(0.125) → invisible) -->
    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">none</TransformOperations>
    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">none</TransformOperations>

    <!-- Boxed integers for command parameters, for the two-way sub-tabs that have no names of their own
         (the database tile's Config/Logs, the database tab's Config/Databases). The Settings dialog's own
         tabs no longer come from here: they are `vm:SettingsTabs`, so a page is named where it is chosen
         and a tab inserted in the middle cannot quietly send a button somewhere else. -->
    <x:Int32 x:Key="Zero">0</x:Int32>
    <x:Int32 x:Key="One">1</x:Int32>

    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderBottom">0,0,0,1</Thickness>
    <Thickness x:Key="BorderTop">0,1,0,0</Thickness>


</ResourceDictionary>
