<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:ae="using:AvaloniaEdit">

    <!-- ======== BUTTON: toolbar ======== -->
    <Style Selector="Button.toolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.toolbar:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
    </Style>
    <Style Selector="Button.toolbar:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>

    <!-- ======== BUTTON: accent (the one action a screen is for) ======== -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentDefault}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>
    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- ======== BUTTON: outlined (Add Workspace style) ======== -->
    <Style Selector="Button.outlined">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.outlined:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
    </Style>
    <Style Selector="Button.outlined:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>

    <!-- ======== BUTTON: outlined-sm (a bordered button on a settings row) ========
         The same button as above, sized to sit beside a label rather than under a form: no minimum
         height, the smaller type, and the UI font stated because these appear on rows whose surrounding
         text is monospaced. It was written out inline three times in SettingsView — ten properties each —
         and had already drifted in three of them, which is how a dialog ends up with three buttons that
         are nearly the same button.
         The type size settled on `UiFontSizeSm`, which follows the font size the user chose, rather than
         the fixed `FontXs` one of the three had: a button that stays at ten pixels while everything
         around it grows is the reason that setting exists. -->
    <Style Selector="Button.outlined-sm">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- The same button, sitting on BgElevated instead of on the page's usual ground — the setup wizard,
         whose window background *is* BgElevated, so the plain class leaves the button invisible against
         it. A modifier class rather than `Background="..."` on each button, because a local value beats a
         style setter in Avalonia: setting it inline silenced the :pointerover rule below and the buttons
         lost their hover feedback entirely. Declared before the pseudo-class rules so those still win
         while the pointer is over it. -->
    <Style Selector="Button.outlined-sm.on-elevated">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    </Style>

    <Style Selector="Button.outlined-sm:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
    </Style>
    <Style Selector="Button.outlined-sm:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>
    <!-- Disabled is a state, and it has to look like one. While every button was drawn in TextSecondary
         there was nothing below it to fall to; now there is. -->
    <Style Selector="Button.outlined:disabled, Button.outlined-sm:disabled, Button.accent:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- ======== KEYCAP (one key of a shortcut) ========
         A shortcut written as `Alt+Space` in a field reads as a value to edit; the same shortcut drawn
         as two keys reads as an instruction to press them. The setup wizard needs the second, because
         its last step is asking somebody to hold the keys rather than describing what they are.
         What makes a row of them read as keys rather than words is that `Alt` and `W` come out the same
         width — and that is MinWidth plus the centring, not the font, which is the ordinary UI one the
         rest of the page uses and is not monospaced. -->
    <Style Selector="Border.keycap">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ======== BUTTON: tile-btn ======== -->
    <Style Selector="Button.tile-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.tile-btn:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>

    <!-- The microphone while this tile is the one being dictated into. Colour only: the icon must stay
         where it was, or the button moves out from under the finger that is about to stop the recording. -->
    <Style Selector="Button.tile-btn-recording">
        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>
    <Style Selector="Button.tile-btn-recording:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>

    <!-- ======== DICTATION: the tile border while it is being spoken into ========
         Two states, told apart by rhythm rather than only by colour: slow while the microphone is
         open, quick while the transcript is being worked out. Both animate opacity alone — a border
         whose thickness or colour changed would either move the content or need a brush interpolated
         out of the theme, and the theme here is derived from the terminal palette at run time.
         The brushes are DynamicResource for that reason: red for recording follows the same token as
         every other warning in the application, and the accent follows whatever the user's terminal
         theme made it. -->
    <!-- Rounded, and for the same reason it used to be square: the frame has to sit on the tile's edge.
         A tile is a card now, so a square frame is what would pull away and leave a notch at each
         corner. RadiusTileInner rather than RadiusTile because it is drawn inside the card's clipping
         border, whose corners are one border-width tighter - and a token rather than a number, so the
         three move together. -->
    <Style Selector="Border.dictation">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusTileInner}" />
    </Style>

    <Style Selector="Border.dictation.recording">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerText}" />
        <Style.Animations>
            <!-- Breathing, roughly at the pace of speech. Never all the way out: the border is what
                 says the microphone is live, and a frame of it at zero reads as "stopped". -->
            <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.35" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.dictation.processing">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
        <Style.Animations>
            <!-- Three times the pace, and shallower: work in progress rather than a device that is
                 listening. The user is waiting here, and a slow fade would read as nothing happening. -->
            <Animation Duration="0:0:0.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.95" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.45" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.95" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ======== BUTTON: chooser-card (tile type picker) ======== -->
    <Style Selector="Button.chooser-card">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="5" />
    </Style>
    <Style Selector="Button.chooser-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
    </Style>
    <Style Selector="Button.chooser-card:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>

    <!-- ======== BUTTON: chooser-back (ghost-like back button) ======== -->
    <Style Selector="Button.chooser-back">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.chooser-back:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.chooser-back:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ======== BUTTON: ghost (remove/close, minimal) ======== -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.ghost:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>

    <!-- ======== BUTTON: tile-btn-close (tile close with danger hover) ======== -->
    <Style Selector="Button.tile-btn-close">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile-btn-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>
    <Style Selector="Button.tile-btn-close:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerSubtle}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>

    <!-- ======== SETTINGS GROUP (one block of related settings) ========
         A card, like everything else on screen. It replaced three nested Borders and a three-pixel
         accent rail down the left of every group — eight of them stacked in a 500px dialog, which is
         the "longer line, quieter accent" rule broken eight times over: an accent that marks one thing
         marks nothing when it marks all of them. The hairline says where the group starts, which is all
         a group needs said. -->
    <Style Selector="Border.settings-group">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusRow}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ======== MODAL CARD (a form that opens over what it belongs to) ========
         The same card the tiles and the workspaces panel are, one step brighter because it is on top of
         them: BgElevated rather than BgSurface, and a shadow to say so. RadiusTile, because a card is a
         card at every size. -->
    <Style Selector="Border.modal-card">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusTile}" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #60000000" />
    </Style>

    <!-- ======== WORKSPACE ITEM (sidebar) ========
         Selected and hovered were the same brush, so pointing at a neighbour made it impossible to say
         which workspace was open — the one thing this list exists to tell you. The selected row has a
         ground of its own and an accent down its leading edge, which is the marker the tiles already use
         for the same idea; hover stays the lighter wash it was. -->
    <Style Selector="Border.workspace-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.workspace-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>
    <Style Selector="Border.workspace-item.workspace-item-selected">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- ======== WORKSPACE META (the branch, under the name) ========
         Plain text, not a chip. A chip is the language this application uses for the rare exception —
         the AI tool that is NOT FOUND, the database tile's Error — and it works because you see one at
         a time. A value that is present on every row is not an exception, it is metadata: twenty boxed
         outlines down the column gave the list a zigzag right edge and no rhythm to read it by, and put
         a third frame inside a card inside a canvas. Small, muted, on the same left margin as the name
         it belongs to, which is the whole of it. -->
    <Style Selector="StackPanel.workspace-meta">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="StackPanel.workspace-meta > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="StackPanel.workspace-meta > mi|MaterialIcon">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <!-- The same line, when it is something you can press. It reads as the branch does until the pointer
         reaches it, because it occupies the branch's place and a row that shouts about a missing
         repository would be louder than the rows that have one. -->
    <Style Selector="Button.workspace-meta-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.workspace-meta-action:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
    </Style>
    <Style Selector="Button.workspace-meta-action:pointerover mi|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- ======== BUTTON: header-action (anything a heading row can do to the list under it) ========
         One class for all of them — Add, Re-detect, Test All, Detect. They sat side by side in two
         different styles at two different sizes and radii, which reads as three unrelated controls that
         happen to be adjacent rather than as the row's own set of actions.

         Sized to a heading row rather than to a form. The Add case also replaced a full-width dashed
         row at the foot of each list, which moved every time the list changed length and was off screen
         exactly when the list was long enough to want another entry. -->
    <Style Selector="Button.header-action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSm}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.header-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="Button.header-action:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>
    <Style Selector="Button.header-action:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- ======== BUTTON: choice-row (a full-width option in a list of options) ========
         Named add-row when the only thing wearing it was an "Add ..." at the foot of a list. Those moved
         to their heading rows (see header-action) and what is left is the phone panel's list of other
         addresses to try — which is not an add action and never was one. A class that describes where a
         button used to sit is a class the next reader will use in the wrong place. -->
    <Style Selector="Button.choice-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
    </Style>
    <Style Selector="Button.choice-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="Button.choice-row:pressed">
        <Setter Property="Background" Value="{DynamicResource InteractivePressed}" />
    </Style>

    <!-- ======== BUTTON: settings-tab ======== -->
    <Style Selector="Button.settings-tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.settings-tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.settings-tab:pressed">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.settings-tab.settings-tab-active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
    </Style>
    <Style Selector="Button.settings-tab.settings-tab-active:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.settings-tab.settings-tab-active:pressed">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ======== TEXT: section header ======== -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="LetterSpacing" Value="1.5" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- ======== TEXT: label ======== -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- ======== TEXT: caption (small meta text) ======== -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- ======== TEXTBOX: global base ======== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentDefault}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_FloatingWatermark">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ======== FORM: setting controls ======== -->
    <Style Selector="TextBox.setting">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    </Style>
    <Style Selector="ComboBox.setting">
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="NumericUpDown.setting">
        <Setter Property="FontSize" Value="{DynamicResource FontMd}" />
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    </Style>

    <!-- ======== TEXTBOX: inline editor (tile name) ======== -->
    <Style Selector="TextBox.inline-editor">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="60" />
    </Style>
    <Style Selector="TextBox.inline-editor /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
    </Style>

    <!-- ======== TEXTBOX: commit summary (single line) ======== -->
    <Style Selector="TextBox.commit-summary">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="AcceptsReturn" Value="False" />
    </Style>
    <Style Selector="TextBox.commit-summary /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
    </Style>
    <Style Selector="TextBox.commit-summary:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
    </Style>

    <!-- ======== TEXTBOX: commit description (multiline) ======== -->
    <Style Selector="TextBox.commit-desc">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MaxHeight" Value="60" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.commit-desc /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
    </Style>
    <Style Selector="TextBox.commit-desc:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDefault}" />
    </Style>


    <!-- ======== SCROLLBAR: force always-visible regardless of Windows overlay setting ======== -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
    </Style>
    <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Width" Value="6" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Height" Value="6" />
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ======== COLLAPSED WORKSPACE ICONS ======== -->
    <Style Selector="Border.workspace-icon-selected">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
    </Style>
    <Style Selector="Border.workspace-icon-selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentDefault}" />
    </Style>

    <!-- ======== GRID SPLITTER ========
         A visible two-pixel bar, which is what a splitter *inside* a tile needs: the git tile's file
         list against its diff, the diff view's two editors. Those sit in Auto columns, so this style is
         also what gives them a width at all.

         It was briefly transparent and width-less for the benefit of the one splitter that does not
         want either — the one between two tile cards, where the canvas showing through the gutter is
         already the divider. That was a global answer to a local question, and it collapsed every
         in-tile splitter to zero width: not merely invisible but impossible to grab. The tile splitter
         asks for it itself instead (TileNodeView.ShowSplit). -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="Width" Value="2" />
        <Setter Property="MinWidth" Value="2" />
    </Style>
    <Style Selector="GridSplitter[ResizeDirection=Rows]">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="2" />
        <Setter Property="MinHeight" Value="2" />
    </Style>
    <!-- The splitter in the gutter between two tile cards: no bar of its own, and filling the gutter so
         all eight pixels of it can be grabbed. Transparent rather than unset — an unset background is
         not hit-testable, and it would stop being draggable, which is the one thing it is there for. -->
    <Style Selector="GridSplitter.tile-gutter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

</Styles>
