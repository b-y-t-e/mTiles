<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:mTiles.Controls">

    <!--
        The picker's look.

        Every colour is a DynamicResource by role and none of them is defined here - see the project file.
        What this file decides is shape and rhythm: a trigger that is quiet until it is pointed at, a card
        with one radius, rows of one height whatever they carry, and a rail that is glyphs because it is
        one column of a popup wide.

        A Styles file rather than a bare ResourceDictionary because the rows are drawn by DataTemplates,
        and a template's classes have to be matched by styles somebody actually applies. The control theme
        and the two row templates ride along in Styles.Resources, so one StyleInclude is the whole of it.
    -->

    <Styles.Resources>

        <!-- A row of the list. One template for every picker, drawing only the parts it was given: the
             permission menu fills in Description, the model list Detail and Shortcut, the effort list Badge. -->
        <DataTemplate x:Key="PickerRowTemplate" DataType="c:PickerRow">
            <Border Classes="picker-row"
                    Classes.highlighted="{Binding IsHighlighted}"
                    Classes.selected="{Binding IsSelected}"
                    Classes.refused="{Binding !CanBePicked}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ContentPresenter Grid.Column="0"
                                      Classes="picker-row-icon"
                                      Content="{Binding Icon}"
                                      IsVisible="{Binding HasIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="picker-row-title"
                                       Classes.action="{Binding IsAction}"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Classes="picker-row-badge" IsVisible="{Binding HasBadge}">
                                <TextBlock Text="{Binding Badge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="picker-row-detail"
                                   Text="{Binding Detail}"
                                   IsVisible="{Binding HasDetail}" />
                        <TextBlock Classes="picker-row-description"
                                   Text="{Binding Description}"
                                   IsVisible="{Binding HasDescription}" />
                        <!-- Why a row cannot be picked, under the row itself. Not a tooltip: the row is
                             drawn dimmed rather than disabled precisely so this sentence is reachable, and
                             a sentence only a pointer can find is one a keyboard user never sees. -->
                        <TextBlock Classes="picker-row-reason"
                                   Text="{Binding Reason}"
                                   IsVisible="{Binding HasReason}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="picker-row-shortcut"
                            IsVisible="{Binding HasShortcut}">
                        <TextBlock Text="{Binding Shortcut}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A heading between two runs of rows. Small, muted, and not a row: nothing about it is
             clickable, which is why the list is an ItemsControl and the click is read off the pointer. -->
        <DataTemplate x:Key="PickerHeadingTemplate" DataType="c:PickerHeading">
            <TextBlock Classes="picker-heading" Text="{Binding Text}" />
        </DataTemplate>

        <ControlTheme x:Key="{x:Type c:Picker}" TargetType="c:Picker">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <!-- The trigger displays and nothing else. A ToggleButton because what it reports
                             is a state - the list is open or it is not - and a pressed-looking trigger
                             under an open list is the only thing tying the two together on screen. -->
                        <ToggleButton x:Name="PART_Trigger"
                                      Classes="picker-trigger"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentPresenter Grid.Column="0"
                                                  Classes="picker-trigger-icon"
                                                  Content="{TemplateBinding Icon}"
                                                  IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Grid.Column="1"
                                           Classes="picker-trigger-text"
                                           Text="{TemplateBinding TriggerText}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <!-- The chevron is the whole point of the trigger existing: the field it
                                     replaced drew no affordance at all, so a catalogue of four hundred
                                     models looked exactly like an empty text box. -->
                                <Path Grid.Column="2"
                                      Classes="picker-chevron"
                                      Data="M 0 0 L 4 4 L 8 0"
                                      IsVisible="{TemplateBinding ShowChevron}"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               IsLightDismissEnabled="True"
                               Placement="{TemplateBinding Placement}"
                               VerticalOffset="4">
                            <Border Classes="picker-card"
                                    Width="{TemplateBinding DropDownWidth}"
                                    MinWidth="{TemplateBinding DropDownMinWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <DockPanel>
                                    <!-- The rail. Only where the caller passed categories, and glyphs
                                         only: it is one column wide, and a name in it would take the
                                         width the rows need for a model id. -->
                                    <ItemsControl DockPanel.Dock="Left"
                                                  x:Name="PART_Rail"
                                                  Classes="picker-rail"
                                                  ItemsSource="{Binding Rail, RelativeSource={RelativeSource TemplatedParent}}"
                                                  IsVisible="{TemplateBinding Categories, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="c:PickerCategory">
                                                <Border Classes="picker-rail-item" ToolTip.Tip="{Binding Title}">
                                                    <ContentPresenter Content="{Binding Icon}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- The search field, above the rows and inside the card. This is the
                                         whole difference from an editable combo box: the trigger
                                         displays, and the typing happens here, where an empty field is
                                         the normal state and the full list is what it shows. -->
                                    <TextBox DockPanel.Dock="Top"
                                             x:Name="PART_Search"
                                             Classes="picker-search"
                                             Watermark="{TemplateBinding SearchPlaceholder}"
                                             IsVisible="{TemplateBinding IsSearchEnabled}" />

                                    <TextBlock DockPanel.Dock="Top"
                                               Classes="picker-empty"
                                               Text="{TemplateBinding EmptyText}"
                                               IsVisible="{TemplateBinding HasRows, Converter={x:Static BoolConverters.Not}}" />

                                    <ScrollViewer x:Name="PART_Scroll"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PART_Rows"
                                                      Classes="picker-rows"
                                                      ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ItemsControl.DataTemplates>
                                                <DataTemplate DataType="c:PickerRow">
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource PickerRowTemplate}" />
                                                </DataTemplate>
                                                <DataTemplate DataType="c:PickerHeading">
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource PickerHeadingTemplate}" />
                                                </DataTemplate>
                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

    </Styles.Resources>

    <!-- ======== The trigger ======== -->
    <Style Selector="ToggleButton.picker-trigger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.picker-trigger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    </Style>
    <Style Selector="ToggleButton.picker-trigger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>
    <!-- Checked is the list being open, so it wears the open card's own ground rather than an accent: an
         accent here would be a second thing claiming to be the selection while the card below shows the
         real one. -->
    <Style Selector="ToggleButton.picker-trigger:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>
    <Style Selector="ToggleButton.picker-trigger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextHover}" />
    </Style>

    <Style Selector="TextBlock.picker-trigger-text">
        <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
    </Style>
    <Style Selector="ContentPresenter.picker-trigger-icon">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.picker-chevron">
        <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Margin" Value="6,1,0,0" />
    </Style>
    <Style Selector="ToggleButton.picker-trigger:pointerover Path.picker-chevron">
        <Setter Property="Stroke" Value="{DynamicResource TextHover}" />
    </Style>

    <!-- Compact: the icon alone, for a row that has run out of width. The chevron goes through its own
         property rather than a setter on the Path, because the template binds the Path's visibility and a
         template binding outranks any style. -->
    <Style Selector="c|Picker.compact">
        <Setter Property="ShowChevron" Value="False" />
    </Style>
    <Style Selector="c|Picker.compact /template/ TextBlock.picker-trigger-text">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="c|Picker.compact /template/ ContentPresenter.picker-trigger-icon">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ======== The card ======== -->
    <Style Selector="Border.picker-card">
        <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
    </Style>

    <Style Selector="TextBox.picker-search">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="2,2,2,4" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
    </Style>
    <!-- The search field gives up its own box: it is the top of a card that already has an edge, and a
         second rectangle inside it reads as a field floating in a menu. The rule under it is what
         separates searching from choosing. -->
    <Style Selector="TextBox.picker-search /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBlock.picker-empty">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="Margin" Value="8,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ======== The rail ======== -->
    <Style Selector="ItemsControl.picker-rail">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="Border.picker-rail-item">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-rail-item > ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-rail-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>

    <!-- ======== Rows ======== -->
    <Style Selector="ItemsControl.picker-rows">
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="Border.picker-row">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.picker-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>
    <!-- Selected is the row this picker is on; highlighted is the row the keyboard is over. Two states,
         two treatments - the application's own rule for the workspace list, and for the same reason:
         one ground for both makes the current row unfindable while the pointer is in the list. -->
    <Style Selector="Border.picker-row.selected">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
    </Style>
    <Style Selector="Border.picker-row.highlighted">
        <Setter Property="Background" Value="{DynamicResource InteractiveHover}" />
    </Style>
    <Style Selector="Border.picker-row.refused">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.picker-row.refused:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ContentPresenter.picker-row-icon">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.picker-row-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.picker-row-title.action">
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
    </Style>
    <Style Selector="Border.picker-row.refused TextBlock.picker-row-title">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="TextBlock.picker-row-detail">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.picker-row-description">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.picker-row-reason">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- A word beside a title, for the rare exception - Default, Unavailable. It works because you see
         one at a time; a value present on every row would be metadata and would be plain text. -->
    <Style Selector="Border.picker-row-badge">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-row-badge > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource FontChip}" />
    </Style>

    <Style Selector="Border.picker-row-shortcut">
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.picker-row-shortcut > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="FontSize" Value="{DynamicResource FontChip}" />
    </Style>

    <Style Selector="TextBlock.picker-heading">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
        <Setter Property="Margin" Value="8,8,8,3" />
    </Style>

</Styles>
