# Generated from PKGBUILD.in by .github/workflows/arch-repo.yml — 0.4.67 and 88606b30747cdacd0dec861c4ac5d16b17d3e5e5ebf890544256f0e347dae616
# are substituted per release. The committed PKGBUILD beside this file is the rendered
# result of the newest release, so `makepkg -si` in this directory works without CI.

pkgname=mtiles-bin
pkgver=0.4.67
pkgrel=1
pkgdesc="Tiling terminal manager with AI agent tiles — .NET 10 + Avalonia"
arch=('x86_64')
url="https://github.com/b-y-t-e/mTiles"
license=('MIT')
provides=('mtiles')
conflicts=('mtiles')

# Everything managed is inside the self-contained publish, so what is listed here is what its
# native libraries reach for outside it. Each entry answers a specific .so in the tree:
#   openssl      libSystem.Security.Cryptography.Native.OpenSsl.so
#   krb5         libSystem.Net.Security.Native.so (libgssapi_krb5)
#   icu          libSystem.Globalization.Native.so
#   fontconfig   libSkiaSharp.so — text; pulls freetype2
#   libglvnd     libSkiaSharp.so — libGL.so.1
#   alsa-lib     libportaudio.so — the dictation microphone
#   libjack.so   libportaudio.so too, and this one is a *hard* DT_NEEDED rather than a dlopen:
#                without a provider the library does not load at all and dictation is dead, with
#                nothing on screen naming the cause. The soname rather than the virtual name "jack",
#                because that is what the ELF asks for and both jack2 and pipewire-jack provide it —
#                a machine that already has either (any modern desktop, Omarchy included) sees no
#                change at all, and one that has neither is asked to pick a provider
#   libx11/libice/libsm   Avalonia's X11 backend, which is the fallback on an X11 session
#   wayland               libwayland-client/-cursor/-egl, the backend used on a Wayland session
#   libxkbcommon          the keyboard map, which a Wayland client is handed rather than told
#   mesa / libdrm         libgbm.so.1 and libdrm.so.2, opened by the Wayland backend for rendering
#   hicolor-icon-theme    owns /usr/share/icons/hicolor, which this package writes into
#
# The Wayland four are the ones namcap will never see: the backend dlopens them, and when they are
# missing it falls back to X11 in silence — which on a HiDPI display is the tiny-interface bug this
# package exists to have fixed, arriving as "it still does not scale" rather than as an error.
#
# namcap reports most of these as "included, but may not be needed", and it is wrong about all
# of them for one reason: it reads ELF DT_NEEDED entries, and these libraries are opened with
# dlopen at runtime. .NET resolves libssl, libicu and libgssapi_krb5 that way, Avalonia does the
# same for libX11, and Skia for libGL — none of it is visible to a linker-level check. What
# namcap *is* right about is the one entry it reported as missing (hicolor-icon-theme) and the
# ones it confirmed through DT_NEEDED: fontconfig and alsa-lib.
#
# The last two are of a different kind from everything above, and the difference is worth saying out
# loud so that the next reader does not take them for a mistake: nothing in this package links them,
# opens them or calls them. They are how an AI CLI running *inside* a tile reaches the clipboard.
# Measured 2026-09-12 against Claude Code 2.1.269 and opencode 1.18.18: neither carries a clipboard
# of its own on Linux, both shell out to these two programs to find out whether there is an image on
# the clipboard and to take it (Claude Code tries xclip first and falls back to wl-paste; opencode
# the other way round), and *neither says anything when the program is missing* — the check exits
# non-zero, the paste returns nothing, and on screen that is indistinguishable from mTiles having
# swallowed the keystroke. Hard depends rather than optdepends: handing a screenshot to an agent is
# what this application is for, an optdepend is a line nobody reads during an upgrade, and the two
# together are well under a megabyte.
#   wl-clipboard   wl-paste, the route on a Wayland session
#   xclip          the same on X11, and what both CLIs reach for first or second regardless
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'krb5'
         'fontconfig' 'libglvnd' 'alsa-lib' 'libx11' 'libice' 'libsm'
         'wayland' 'libxkbcommon' 'mesa' 'libdrm'
         'libjack.so' 'hicolor-icon-theme'
         'wl-clipboard' 'xclip')

# A self-contained .NET publish carries prebuilt native libraries that are not ours to strip:
# stripping libcoreclr/libSkiaSharp/libonnxruntime is at best pointless and at worst breaks the
# load. There is no debug package for a binary release either.
options=('!strip' '!debug' '!lto')

_tarball="mTiles-${pkgver}-linux-x64"
source=("${_tarball}.tar.gz::${url}/releases/download/v${pkgver}/mTiles-linux-x64.tar.gz")
sha256sums=('88606b30747cdacd0dec861c4ac5d16b17d3e5e5ebf890544256f0e347dae616')

package() {
    # /opt rather than /usr/lib: 426 files of somebody else's runtime, versioned as one unit.
    install -dm755 "$pkgdir/opt/mtiles"
    cp -a "$srcdir/$_tarball/bin/." "$pkgdir/opt/mtiles/"
    chmod 755 "$pkgdir/opt/mtiles/mTiles"

    # The publish carries every runtime identifier its NuGet packages ship, so an x86_64 Linux
    # package would otherwise install Windows DLLs, macOS dylibs and ARM shared objects that
    # nothing here can load. Dead weight, and not only that: namcap reads them and reports an
    # uninstalled ld-linux-aarch64.so.1 and a RUNPATH from whisper.net's own build machine,
    # which buries the findings that are about this package. linux-x64 stays — whisper.net loads
    # its libraries from there rather than from the root of the publish.
    find "$pkgdir/opt/mtiles/runtimes" -mindepth 1 -maxdepth 1 -type d          -not -name 'linux-x64' -exec rm -rf {} +

    # The apphost resolves its runtime relative to its own path, so the wrapper execs the real
    # binary rather than symlinking to it — a symlink in /usr/bin would resolve $ORIGIN there.
    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /opt/mtiles/mTiles "$@"\n' > "$pkgdir/usr/bin/mtiles"
    chmod 755 "$pkgdir/usr/bin/mtiles"

    # Exec is rewritten to the wrapper: the shipped file names the binary the way the AppImage
    # launches it, and one .desktop in the repository is better than two that can disagree.
    install -Dm644 "$srcdir/$_tarball/mTiles.desktop" \
        "$pkgdir/usr/share/applications/mtiles.desktop"
    sed -i 's|^Exec=.*|Exec=mtiles|' "$pkgdir/usr/share/applications/mtiles.desktop"

    install -Dm644 "$srcdir/$_tarball/mtiles.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/mtiles.png"
    install -Dm644 "$srcdir/$_tarball/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
