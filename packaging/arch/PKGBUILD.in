# Maintainer: Andrzej Ból <andrzej.bol@gmail.com>
#
# Generated from PKGBUILD.in by .github/workflows/arch-repo.yml — @PKGVER@ and @SHA256@
# are substituted per release. The committed PKGBUILD beside this file is the rendered
# result of the newest release, so `makepkg -si` in this directory works without CI.

pkgname=mtiles-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Tiling terminal manager with AI agent tiles — .NET 10 + Avalonia"
arch=('x86_64')
url="https://github.com/b-y-t-e/mTiles"
license=('MIT')
provides=('mtiles')
conflicts=('mtiles')

# Everything managed is inside the self-contained publish, so what is listed here is what its
# native libraries reach for outside it. Each entry answers a specific .so in the tree:
#   openssl      libSystem.Security.Cryptography.Native.OpenSsl.so
#   krb5         libSystem.Net.Security.Native.so (libgssapi_krb5)
#   icu          libSystem.Globalization.Native.so
#   fontconfig   libSkiaSharp.so — text; pulls freetype2
#   libglvnd     libSkiaSharp.so — libGL.so.1
#   alsa-lib     libportaudio.so — the dictation microphone
#   libx11/libice/libsm   Avalonia's X11 backend (XWayland on a Wayland session)
# The list is verified on every release by namcap in the workflow rather than trusted here.
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'krb5'
         'fontconfig' 'libglvnd' 'alsa-lib' 'libx11' 'libice' 'libsm')

# A self-contained .NET publish carries prebuilt native libraries that are not ours to strip:
# stripping libcoreclr/libSkiaSharp/libonnxruntime is at best pointless and at worst breaks the
# load. There is no debug package for a binary release either.
options=('!strip' '!debug' '!lto')

_tarball="mTiles-${pkgver}-linux-x64"
source=("${_tarball}.tar.gz::${url}/releases/download/v${pkgver}/mTiles-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
    # /opt rather than /usr/lib: 426 files of somebody else's runtime, versioned as one unit.
    install -dm755 "$pkgdir/opt/mtiles"
    cp -a "$srcdir/$_tarball/bin/." "$pkgdir/opt/mtiles/"
    chmod 755 "$pkgdir/opt/mtiles/mTiles"

    # The apphost resolves its runtime relative to its own path, so the wrapper execs the real
    # binary rather than symlinking to it — a symlink in /usr/bin would resolve $ORIGIN there.
    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /opt/mtiles/mTiles "$@"\n' > "$pkgdir/usr/bin/mtiles"
    chmod 755 "$pkgdir/usr/bin/mtiles"

    # Exec is rewritten to the wrapper: the shipped file names the binary the way the AppImage
    # launches it, and one .desktop in the repository is better than two that can disagree.
    install -Dm644 "$srcdir/$_tarball/mTiles.desktop" \
        "$pkgdir/usr/share/applications/mtiles.desktop"
    sed -i 's|^Exec=.*|Exec=mtiles|' "$pkgdir/usr/share/applications/mtiles.desktop"

    install -Dm644 "$srcdir/$_tarball/mtiles.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/mtiles.png"
    install -Dm644 "$srcdir/$_tarball/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
